local function removeWater()

	waterActive = false

	if waterPart then
		waterPart:Destroy()
		waterPart = nil
	end
end

local function createWater()

	removeWater()

	local character = player.Character
	if not character then
		return
	end

	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end

	local p = root.Position

	-- MẶT NƯỚC CAO HƠN NGƯỜI CHƠI 50M
	local topY = p.Y + WATER_HEIGHT

	-- ĐỘ DÀY 100M
	local centerY = topY - (WATER_DEPTH / 2)

	waterPart = Instance.new("Part")

	waterPart.Name = "SKY_Water"

	waterPart.Size = Vector3.new(
		WATER_SIZE,
		WATER_DEPTH,
		WATER_SIZE
	)

	waterPart.Position = Vector3.new(
		p.X,
		centerY,
		p.Z
	)

	waterPart.Anchored = true
	waterPart.CanCollide = false
	waterPart.CanTouch = true
	waterPart.CanQuery = true

	waterPart.Material = Enum.Material.Glass

	waterPart.Color = Color3.fromRGB(
		15,
		125,
		180
	)

	waterPart.Transparency = 0.25

	waterPart.Reflectance = 0.25

	waterPart.Parent = worldFolder

	waterActive = true
end

button(
	"🌊 BẬT NƯỚC 4000×4000",
	createWater
)

button(
	"❌ TẮT NƯỚC",
	removeWater
)

