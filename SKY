local function removeFloatForces()

    for _,v in ipairs(workspace:GetDescendants()) do

        if v.Name == "SKY_FloatForce"
        or v.Name == "SKY_FloatAttachment" then

            v:Destroy()
        end
    end
end

local function water()

    destroyEffect("SKY_Water")
    stopConnection("Water")
    removeFloatForces()

    local root =
        player.Character
        and player.Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root then return end

    local folder = Instance.new("Folder")
    folder.Name = "SKY_Water"
    folder.Parent = workspace

    local water = Instance.new("Part")

    water.Name = "Ocean"

    water.Size =
        Vector3.new(
            1500,
            1,
            1500
        )

    water.Position =
        root.Position-
        Vector3.new(0,5,0)

    water.Anchored = true
    water.CanCollide = false
    water.CanTouch = false
    water.CanQuery = false

    water.Material = Enum.Material.Glass
    water.Color = Color3.fromRGB(25,145,210)
    water.Transparency = .3
    water.Reflectance = .25

    water.Parent = folder

    local WATER_DEPTH = 100
    local WATER_TOP = 10

    local scanTimer = 0

    connections.Water =
        RunService.Heartbeat:Connect(function(dt)

        if not folder.Parent then
            stopConnection("Water")
            return
        end

        scanTimer += dt

        if scanTimer < .15 then
            return
        end

        scanTimer = 0

        local surfaceY = water.Position.Y
        local bottomY = surfaceY - WATER_DEPTH

        local scanCenter =
            water.Position -
            Vector3.new(
                0,
                (WATER_DEPTH-WATER_TOP)/2,
                0
            )

        local parts =
            workspace:GetPartBoundsInBox(
                CFrame.new(scanCenter),
                Vector3.new(
                    350,
                    WATER_DEPTH+WATER_TOP,
                    350
                )
            )

        local active = {}

        for _,p in ipairs(parts) do

            if p:IsA("BasePart")
            and not p.Anchored
            and not p:IsDescendantOf(folder)
            and not (
                player.Character
                and p:IsDescendantOf(
                    player.Character
                )
            ) then

                local y = p.Position.Y

                if y >= bottomY
                and y <= surfaceY+WATER_TOP then

                    active[p] = true

                    local attachment =
                        p:FindFirstChild(
                            "SKY_FloatAttachment"
                        )

                    if not attachment then

                        attachment =
                            Instance.new("Attachment")

                        attachment.Name =
                            "SKY_FloatAttachment"

                        attachment.Parent = p
                    end

                    local force =
                        p:FindFirstChild(
                            "SKY_FloatForce"
                        )

                    if not force then

                        force =
                            Instance.new("VectorForce")

                        force.Name =
                            "SKY_FloatForce"

                        force.Attachment0 =
                            attachment

                        force.RelativeTo =
                            Enum.ActuatorRelativeTo.World

                        force.ApplyAtCenterOfMass =
                            true

                        force.Parent = p
                    end

                    local mass =
                        math.max(
                            p.AssemblyMass,
                            1
                        )

                    local velocity =
                        p.AssemblyLinearVelocity

                    local targetY =
                        surfaceY+
                        p.Size.Y/2

                    local heightError =
                        targetY-p.Position.Y

                    local buoyancy =
                        mass*
                        workspace.Gravity*
                        1.05

                    local holdForce =
                        heightError*
                        mass*
                        12

                    local damping =
                        -velocity.Y*
                        mass*
                        8

                    local t = os.clock()

                    local driftX =
                        math.sin(
                            t*.35+
                            p.Position.Z*.01
                        )*.45*mass

                    local driftZ =
                        math.cos(
                            t*.30+
                            p.Position.X*.01
                        )*.45*mass

                    force.Force =
                        Vector3.new(
                            driftX,
                            buoyancy+
                            holdForce+
                            damping,
                            driftZ
                        )
                end
            end
        end

        -- Xóa lực khỏi vật ra khỏi vùng nước
        for _,p in ipairs(workspace:GetDescendants()) do

            if p:IsA("BasePart")
            and p:FindFirstChild(
                "SKY_FloatForce"
            )
            and not active[p] then

                local force =
                    p:FindFirstChild(
                        "SKY_FloatForce"
                    )

                local attachment =
                    p:FindFirstChild(
                        "SKY_FloatAttachment"
                    )

                if force then
                    force:Destroy()
                end

                if attachment then
                    attachment:Destroy()
                end
            end
        end
    end)
end

