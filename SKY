local Rainbow

local function OffRainbow()

    if Rainbow then
        Rainbow:Destroy()
        Rainbow = nil
    end

end

local function RainbowOn()

    OffRainbow()

    local Character = Player.Character
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")

    if not Root then return end

    Rainbow = Instance.new("Folder")
    Rainbow.Name = "Rainbow"
    Rainbow.Parent = World

    local Center =
        Root.Position
        - Root.CFrame.RightVector * 180
        + Vector3.new(0,80,0)

    local Colors = {

        Color3.fromRGB(255,0,0),
        Color3.fromRGB(255,140,0),
        Color3.fromRGB(255,255,0),
        Color3.fromRGB(0,255,0),
        Color3.fromRGB(0,170,255),
        Color3.fromRGB(0,0,255),
        Color3.fromRGB(180,0,255)

    }

    for index,color in ipairs(Colors) do

        local radius = 75-(index-1)*3

        for i=0,40 do

            local angle = math.pi*i/40

            local Part = Instance.new("Part")

            Part.Size = Vector3.new(3,3,2)

            Part.Position =
                Center +
                Vector3.new(
                    math.cos(angle)*radius,
                    math.sin(angle)*radius,
                    0
                )

            Part.Anchored = true
            Part.CanCollide = false
            Part.CanTouch = false
            Part.CanQuery = false
            Part.Material = Enum.Material.Neon
            Part.Color = color
            Part.Parent = Rainbow

        end
    end

end

Button("🌈 Cầu vồng bên trái",RainbowOn)
Button("❌ Tắt cầu vồng",OffRainbow)

