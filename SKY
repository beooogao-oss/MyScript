local windConnection
local windForce
local windAttachment
local windEnabled = false

local function stopWind()

    windEnabled = false

    if windConnection then
        windConnection:Disconnect()
        windConnection = nil
    end

    if windForce then
        windForce:Destroy()
        windForce = nil
    end

    if windAttachment then
        windAttachment:Destroy()
        windAttachment = nil
    end
end

local function startWind()

    stopWind()

    windEnabled = true

    windConnection =
        RunService.Heartbeat:Connect(function()

            local char = player.Character

            local root =
                char
                and char:FindFirstChild(
                    "HumanoidRootPart"
                )

            if not root then return end

            if not windAttachment then

                windAttachment =
                    Instance.new("Attachment")

                windAttachment.Name =
                    "SKY_WindAttachment"

                windAttachment.Parent = root
            end

            if not windForce then

                windForce =
                    Instance.new("VectorForce")

                windForce.Name =
                    "SKY_LightWind"

                windForce.Attachment0 =
                    windAttachment

                windForce.RelativeTo =
                    Enum.ActuatorRelativeTo.World

                windForce.ApplyAtCenterOfMass =
                    true

                windForce.Parent = root
            end

            -- 🌬️ GIÓ RẤT NHẸ
            local direction =
                root.CFrame.LookVector

            local mass =
                root.AssemblyMass

            windForce.Force =
                direction
                *mass
                *workspace.Gravity
                *0.10
        end)
end

