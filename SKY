-- 🌾 LÚA CHỈ TRÊN CỎ
-- =========================================================

local function rice()

    if effectsOff then return end

    destroyEffect("SKY_Rice")

    local folder = Instance.new("Folder")
    folder.Name = "SKY_Rice"
    folder.Parent = workspace

    local stalks = {}
    local count = 0

    -- Chỉ quét 1 lần khi bật
    for _,part in ipairs(workspace:GetDescendants()) do

        if count >= 300 then
            break
        end

        if part:IsA("BasePart")
        and part.Material == Enum.Material.Grass
        and part.Size.X > 6
        and part.Size.Z > 6 then

            local amount =
                math.min(
                    8,
                    math.floor(
                        part.Size.X*
                        part.Size.Z/
                        1000
                    )
                )

            for i=1,amount do

                if count >= 300 then
                    break
                end

                local p = Instance.new("Part")

                p.Size =
                    Vector3.new(
                        .12,
                        3,
                        .12
                    )

                p.Material =
                    Enum.Material.Grass

                p.Color =
                    Color3.fromRGB(
                        110,180,50
                    )

                p.Anchored = true
                p.CanCollide = false
                p.CanTouch = false
                p.CanQuery = false

                local x =
                    (math.random()-.5)*
                    (part.Size.X-2)

                local z =
                    (math.random()-.5)*
                    (part.Size.Z-2)

                p.Position =
                    part.Position+
                    Vector3.new(
                        x,
                        part.Size.Y/2+1.5,
                        z
                    )

                p.Parent = folder

                table.insert(
                    stalks,
                    {
                        part = p,
                        base = p.CFrame,
                        phase = math.random()*10
                    }
                )

                count += 1
            end
        end
    end

    local connection =
        RunService.Heartbeat:Connect(function()

        if effectsOff or not folder.Parent then
            return
        end

        local t = os.clock()

        for _,d in ipairs(stalks) do

            local sway =
                math.sin(
                    t*1.5+d.phase
                )*.08

            d.part.CFrame =
                d.base*
                CFrame.Angles(
                    sway,
                    0,
                    sway*.5
                )
        end
    end)

    table.insert(connections,connection)
end

