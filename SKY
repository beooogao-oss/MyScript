-- ❤️ TRÁI TIM HẠT DI CHUYỂN
-- =========================================================

local heartFolder
local heartRunning = false
local heartConnection

local function removeHeart()

    heartRunning = false

    if heartConnection then
        heartConnection:Disconnect()
        heartConnection = nil
    end

    if heartFolder then
        heartFolder:Destroy()
        heartFolder = nil
    end
end

local function createHeart()

    removeHeart()

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if not root then
        return
    end

    heartRunning = true

    heartFolder = Instance.new("Folder")
    heartFolder.Name = "SKY_Heart"
    heartFolder.Parent = workspace

    local center =
        root.Position
        + root.CFrame.LookVector * 120
        + Vector3.new(0,70,0)

    local particles = {}

    -- ❤️ HẠT TẠO TIM
    for i = 1,160 do

        local p = Instance.new("Part")

        p.Shape = Enum.PartType.Ball
        p.Size = Vector3.new(2.5,2.5,2.5)

        p.Material = Enum.Material.Neon
        p.Color = Color3.fromRGB(255,45,110)

        p.Anchored = true
        p.CanCollide = false
        p.CanTouch = false
        p.CanQuery = false

        p.Parent = heartFolder

        table.insert(particles,p)
    end

    -- ✨ HẠT XUNG QUANH
    local sparkles = {}

    for i = 1,60 do

        local p = Instance.new("Part")

        p.Shape = Enum.PartType.Ball
        p.Size = Vector3.new(1.5,1.5,1.5)

        p.Material = Enum.Material.Neon
        p.Color = Color3.fromRGB(255,150,200)

        p.Anchored = true
        p.CanCollide = false
        p.CanTouch = false
        p.CanQuery = false

        p.Parent = heartFolder

        table.insert(sparkles,p)
    end

    heartConnection =
        RunService.Heartbeat:Connect(function()

            if not heartRunning
                or not heartFolder
                or not heartFolder.Parent then

                return
            end

            local character = player.Character

            local currentRoot =
                character
                and character:FindFirstChild(
                    "HumanoidRootPart"
                )

            if not currentRoot then
                return
            end

            center =
                currentRoot.Position
                + currentRoot.CFrame.LookVector * 120
                + Vector3.new(0,70,0)

            local now = os.clock()

            -- ❤️ TIM CHUYỂN ĐỘNG
            for i,p in ipairs(particles) do

                local progress =
                    ((i/#particles)
                    + now*0.08) % 1

                local t =
                    progress*math.pi*2

                local x =
                    16*math.sin(t)^3

                local y =
                    13*math.cos(t)
                    -5*math.cos(2*t)
                    -2*math.cos(3*t)
                    -math.cos(4*t)

                local glow =
                    math.sin(
                        now*5+i*0.25
                    )*0.8

                p.Position =
                    center
                    + currentRoot.CFrame.RightVector
                        *(x*5)
                    + Vector3.new(
                        0,
                        y*5+glow,
                        0
                    )

                local size =
                    1.8
                    +(
                        math.sin(
                            now*6+i
                        )+1
                    )*0.7

                p.Size =
                    Vector3.new(
                        size,
                        size,
                        size
                    )
            end

            -- ✨ HẠT BAY XUNG QUANH
            for i,p in ipairs(sparkles) do

                local angle =
                    now*0.5+i*0.8

                local radius =
                    70
                    +math.sin(
                        now*1.5+i
                    )*30

                local height =
                    math.sin(
                        now*1.2+i*0.7
                    )*60

                p.Position =
                    center
                    +Vector3.new(
                        math.cos(angle)*radius,
                        height,
                        math.sin(angle)*radius
                    )

                local size =
                    0.8
                    +math.abs(
                        math.sin(
                            now*4+i
                        )
                    )*1.5

                p.Size =
                    Vector3.new(
                        size,
                        size,
                        size
                    )
            end
        end)
end

