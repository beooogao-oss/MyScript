-- =========================
-- 🌈 CẦU VỒNG BÊN TRÁI
-- =========================

local rainbowFolder

local function removeRainbow()
    if rainbowFolder then
        rainbowFolder:Destroy()
        rainbowFolder = nil
    end
end

local function createRainbow()
    removeRainbow()

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    rainbowFolder = Instance.new("Folder")
    rainbowFolder.Name = "RuHub_Rainbow"
    rainbowFolder.Parent = workspace

    -- BÊN TRÁI NGƯỜI CHƠI
    local center =
        root.Position
        - root.CFrame.RightVector * 180
        + Vector3.new(0, 80, 0)

    local colors = {
        Color3.fromRGB(255, 0, 0),
        Color3.fromRGB(255, 140, 0),
        Color3.fromRGB(255, 255, 0),
        Color3.fromRGB(0, 255, 0),
        Color3.fromRGB(0, 170, 255),
        Color3.fromRGB(0, 0, 255),
        Color3.fromRGB(180, 0, 255)
    }

    for colorIndex, color in ipairs(colors) do
        local radius = 75 - (colorIndex - 1) * 3

        for i = 0, 40 do
            local angle = math.pi * (i / 40)

            local part = Instance.new("Part")
            part.Anchored = true
            part.CanCollide = false
            part.CanTouch = false
            part.CanQuery = false
            part.Material = Enum.Material.Neon
            part.Color = color
            part.Size = Vector3.new(3, 3, 2)

            part.Position =
                center +
                Vector3.new(
                    math.cos(angle) * radius,
                    math.sin(angle) * radius,
                    0
                )

            part.Parent = rainbowFolder
        end
    end
end

makeButton("🌈 Cầu vồng bên trái", createRainbow)
makeButton("❌ Tắt cầu vồng", removeRainbow)

-- =========================
-- 🌌 THIÊN HÀ KIỂU VŨ TRỤ
-- =========================

local galaxyFolder

local function removeGalaxy()
    if galaxyFolder then
        galaxyFolder:Destroy()
        galaxyFolder = nil
    end
end

local function createGalaxy()
    removeGalaxy()

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    galaxyFolder = Instance.new("Folder")
    galaxyFolder.Name = "RuHub_Galaxy"
    galaxyFolder.Parent = workspace

    -- CÁCH NGƯỜI CHƠI 1000 STUDS
    -- CAO 450 STUDS
    local center =
        root.Position
        + root.CFrame.LookVector * 1000
        + Vector3.new(0, 450, 0)

    -- =====================
    -- ⭐ RẤT NHIỀU NGÔI SAO
    -- =====================

    for i = 1, 600 do
        local star = Instance.new("Part")

        star.Shape = Enum.PartType.Ball

        local size = math.random(2, 8)
        star.Size = Vector3.new(size, size, size)

        star.Material = Enum.Material.Neon

        star.Color = Color3.fromRGB(
            math.random(180, 255),
            math.random(180, 255),
            math.random(200, 255)
        )

        star.Anchored = true
        star.CanCollide = false
        star.CanTouch = false
        star.CanQuery = false

        local angle = math.random() * math.pi * 2
        local distance = math.random(100, 750)

        star.Position =
            center +
            Vector3.new(
                math.cos(angle) * distance,
                math.random(-180, 180),
                math.sin(angle) * distance
            )

        star.Parent = galaxyFolder
    end

    -- =====================
    -- 🌀 5 CÁNH THIÊN HÀ
    -- =====================

    for arm = 1, 5 do
        for i = 1, 250 do

            local t = i / 250

            local angle =
                t * math.pi * 7
                + (arm - 1) * (math.pi * 2 / 5)

            local radius = t * 750

            local x = math.cos(angle) * radius
            local z = math.sin(angle) * radius

            local y =
                math.sin(t * math.pi) * 45
                + math.random(-25, 25)

            local dust = Instance.new("Part")

            dust.Shape = Enum.PartType.Ball

            local size = math.random(3, 10)
            dust.Size = Vector3.new(size, size, size)

            dust.Material = Enum.Material.Neon

            dust.Color = Color3.fromRGB(
                math.random(100, 220),
                math.random(80, 180),
                math.random(180, 255)
            )

            dust.Transparency = 0.15

            dust.Anchored = true
            dust.CanCollide = false
            dust.CanTouch = false
            dust.CanQuery = false

            dust.Position =
                center +
                Vector3.new(x, y, z)

            dust.Parent = galaxyFolder
        end
    end

    -- =====================
    -- ☀️ LÕI THIÊN HÀ
    -- =====================

    local core = Instance.new("Part")

    core.Shape = Enum.PartType.Ball
    core.Size = Vector3.new(260, 260, 260)

    core.Material = Enum.Material.Neon
    core.Color = Color3.fromRGB(255, 235, 190)

    core.Transparency = 0.15

    core.Anchored = true
    core.CanCollide = false
    core.CanTouch = false
    core.CanQuery = false

    core.Position = center
    core.Parent = galaxyFolder

    local light = Instance.new("PointLight")
    light.Brightness = 15
    light.Range = 1000
    light.Parent = core
end

makeButton("🌌 Bật thiên hà lớn", createGalaxy)
makeButton("❌ Tắt thiên hà", removeGalaxy)

