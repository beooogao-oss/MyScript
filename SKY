local Rainbow

local function OffRainbow()

    if Rainbow then
        Rainbow:Destroy()
        Rainbow = nil
    end

end

local function RainbowOn()

    OffRainbow()

    local Root =
        Player.Character
        and Player.Character:FindFirstChild("HumanoidRootPart")

    if not Root then return end

    Rainbow = Instance.new("Folder")
    Rainbow.Name = "Rainbow"
    Rainbow.Parent = World

    local Center =
        Root.Position
        - Root.CFrame.RightVector * 180
        + Vector3.new(0,80,0)

    local Colors = {
        Color3.fromRGB(255,0,0),
        Color3.fromRGB(255,140,0),
        Color3.fromRGB(255,255,0),
        Color3.fromRGB(0,255,0),
        Color3.fromRGB(0,170,255),
        Color3.fromRGB(0,0,255),
        Color3.fromRGB(180,0,255)
    }

    for n,color in ipairs(Colors) do

        local radius = 75-(n-1)*3

        for i=0,40 do

            local angle = math.pi*i/40

            local P = Instance.new("Part")

            P.Size = Vector3.new(3,3,2)

            P.Position =
                Center+
                Vector3.new(
                    math.cos(angle)*radius,
                    math.sin(angle)*radius,
                    0
                )

            P.Anchored = true
            P.CanCollide = false
            P.CanTouch = false
            P.CanQuery = false
            P.Material = Enum.Material.Neon
            P.Color = color
            P.Parent = Rainbow

        end
    end

end

Button("🌈 Cầu vồng bên trái",RainbowOn)
Button("❌ Tắt cầu vồng",OffRainbow)

-- =========================
-- 🌌 THIÊN HÀ
-- =========================

local Galaxy
local GalaxyRunning = false

local function OffGalaxy()

    GalaxyRunning = false

    if Galaxy then
        Galaxy:Destroy()
        Galaxy = nil
    end

end

local function GalaxyOn()

    OffGalaxy()

    local Root =
        Player.Character
        and Player.Character:FindFirstChild("HumanoidRootPart")

    if not Root then return end

    GalaxyRunning = true

    Galaxy = Instance.new("Folder")
    Galaxy.Name = "Galaxy"
    Galaxy.Parent = World

    local Center =
        Root.Position+
        Root.CFrame.LookVector*1000+
        Vector3.new(0,450,0)

    local Stars = {}

    for i=1,350 do

        local Star = Instance.new("Part")

        Star.Shape = Enum.PartType.Ball

        local S = math.random(2,6)

        Star.Size =
            Vector3.new(S,S,S)

        Star.Material = Enum.Material.Neon

        Star.Color =
            Color3.fromRGB(
                math.random(170,255),
                math.random(170,255),
                255
            )

        Star.Anchored = true
        Star.CanCollide = false
        Star.CanTouch = false
        Star.CanQuery = false

        local Angle =
            math.random()*math.pi*2

        local Radius =
            math.random(100,700)

        local Height =
            math.random(-220,220)

        Star.Position =
            Center+
            Vector3.new(
                math.cos(Angle)*Radius,
                Height,
                math.sin(Angle)*Radius
            )

        Star.Parent = Galaxy

        table.insert(Stars,{
            Part=Star,
            Angle=Angle,
            Radius=Radius,
            Height=Height,
            Speed=math.random(2,8)/100
        })

    end

    task.spawn(function()

        while GalaxyRunning
        and Galaxy
        and Galaxy.Parent do

            for _,D in ipairs(Stars) do

                if D.Part and D.Part.Parent then

                    D.Angle += D.Speed

                    D.Part.Position =
                        Center+
                        Vector3.new(
                            math.cos(D.Angle)*D.Radius,
                            D.Height,
                            math.sin(D.Angle)*D.Radius
                        )

                end
            end

            task.wait(.03)

        end

    end)

end

Button("🌌 Bật thiên hà lớn",GalaxyOn)
Button("❌ Tắt thiên hà",OffGalaxy)

