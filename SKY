local fireflyFolder
local fireflyRunning=false

local function removeFireflies()
    fireflyRunning=false

    if fireflyFolder then
        fireflyFolder:Destroy()
        fireflyFolder=nil
    end
end

local function createFireflies()
    removeFireflies()

    local char=player.Character
    local root=char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    fireflyRunning=true

    fireflyFolder=Instance.new("Folder")
    fireflyFolder.Name="SKY_Fireflies"
    fireflyFolder.Parent=workspace

    local fireflies={}

    for i=1,250 do
        local p=Instance.new("Part")

        p.Shape=Enum.PartType.Ball
        p.Size=Vector3.new(2,2,2)
        p.Material=Enum.Material.Neon
        p.Color=Color3.fromRGB(255,240,100)

        p.Anchored=true
        p.CanCollide=false
        p.CanTouch=false
        p.CanQuery=false

        p.Parent=fireflyFolder

        table.insert(fireflies,{
            part=p,
            angle=math.random()*math.pi*2,
            radius=math.random(40,300),
            height=math.random(10,180),
            speed=math.random(2,8)/100,
            phase=math.random()*20
        })
    end

    task.spawn(function()
        while fireflyRunning
        and fireflyFolder
        and fireflyFolder.Parent do

            local now=os.clock()

            for _,data in ipairs(fireflies) do
                if data.part and data.part.Parent then

                    data.angle+=data.speed

                    local pulse=
                        .5+
                        math.abs(
                            math.sin(
                                now*4+
                                data.phase
                            )
                        )

                    local size=1.5+pulse*2.5

                    data.part.Size=
                        Vector3.new(size,size,size)

                    data.part.Position=
                        root.Position+
                        Vector3.new(
                            math.cos(data.angle)*data.radius,
                            data.height+
                            math.sin(
                                now*1.5+
                                data.phase
                            )*25,
                            math.sin(data.angle)*data.radius
                        )
                end
            end

            task.wait(.03)
        end
    end)
end

