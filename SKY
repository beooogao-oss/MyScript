local galaxyFolder
local galaxyConnection

local function removeGalaxy()
    if galaxyConnection then
        galaxyConnection:Disconnect()
        galaxyConnection = nil
    end

    if galaxyFolder then
        galaxyFolder:Destroy()
        galaxyFolder = nil
    end
end

local function createStar(parent,pos,size,color,transparency)
    local p = Instance.new("Part")

    p.Shape = Enum.PartType.Ball
    p.Size = Vector3.new(size,size,size)
    p.Material = Enum.Material.Neon
    p.Color = color
    p.Transparency = transparency or 0

    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false

    p.Position = pos
    p.Parent = parent

    return p
end

local function createGalaxy()
    removeGalaxy()

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    galaxyFolder = Instance.new("Folder")
    galaxyFolder.Name = "Galaxy"
    galaxyFolder.Parent = fx

    local center =
        root.Position
        + root.CFrame.LookVector * 150
        + Vector3.new(0,55,0)

    local stars = {}

    local starColors = {
        Color3.fromRGB(255,255,255),
        Color3.fromRGB(210,230,255),
        Color3.fromRGB(180,130,255),
        Color3.fromRGB(255,100,235),
        Color3.fromRGB(130,190,255)
    }

    -- ⭐ HẠT SAO KHẮP THIÊN HÀ
    for i=1,1800 do

        local angle = math.random()*math.pi*2
        local radius = math.random(35,340)

        local x = math.cos(angle)*radius
        local z = math.sin(angle)*radius
        local y = math.random(-125,125)

        local p = createStar(
            galaxyFolder,
            center + Vector3.new(x,y,z),
            math.random(1,5),
            starColors[math.random(1,#starColors)],
            math.random(0,65)/100
        )

        if math.random() < 0.3 then
            table.insert(stars,{
                part = p,
                angle = angle,
                radius = radius,
                height = y,
                speed = math.random(2,8)/1000
            })
        end
    end

    -- 🌀 DẢI TINH VÂN
    for arm=1,7 do

        for i=1,400 do

            local t = i/400

            local angle =
                t*math.pi*9
                + (arm-1)*math.pi*2/7

            local radius = 20+t*300

            local x = math.cos(angle)*radius
            local z = math.sin(angle)*radius

            local y =
                math.sin(t*math.pi)*35
                + math.random(-20,20)

            createStar(
                galaxyFolder,
                center+Vector3.new(x,y,z),
                math.random(2,6),
                Color3.fromRGB(
                    math.random(120,220),
                    math.random(60,150),
                    255
                ),
                math.random(20,70)/100
            )
        end
    end

    --==================================================
    -- 🌈 CẦU VỒNG TRONG CẢNH THIÊN HÀ
    --==================================================

    local rainbowCenter =
        center
        - root.CFrame.RightVector*250
        + Vector3.new(0,15,0)

    local rainbowColors = {
        Color3.fromRGB(255,0,0),
        Color3.fromRGB(255,100,0),
        Color3.fromRGB(255,230,0),
        Color3.fromRGB(0,255,100),
        Color3.fromRGB(0,190,255),
        Color3.fromRGB(70,80,255),
        Color3.fromRGB(220,0,255)
    }

    for n,color in ipairs(rainbowColors) do

        local radius = 75-(n-1)*4

        for i=0,55 do

            local a = math.pi*i/55

            createStar(
                galaxyFolder,
                rainbowCenter+
                Vector3.new(
                    math.cos(a)*radius,
                    math.sin(a)*radius,
                    0
                ),
                5,
                color,
                0
            )
        end
    end

    --==================================================
    -- 💗 HÌNH GIỮA
    --==================================================

    local heartCenter =
        center
        - root.CFrame.RightVector*20
        - Vector3.new(0,30,0)

    for i=0,180 do

        local t = math.pi*2*i/180

        local x = 16*math.sin(t)^3

        local y =
            13*math.cos(t)
            -5*math.cos(2*t)
            -2*math.cos(3*t)
            -math.cos(4*t)

        createStar(
            galaxyFolder,
            heartCenter
            + root.CFrame.RightVector*(x*3)
            + Vector3.new(0,y*3,0),
            5,
            Color3.fromRGB(255,205,255),
            0
        )
    end

    -- ✨ HẠT BAO QUANH HÌNH
    for i=1,600 do

        local angle = math.random()*math.pi*2
        local radius = math.random(45,175)

        createStar(
            galaxyFolder,
            heartCenter+Vector3.new(
                math.cos(angle)*radius,
                math.random(-105,105),
                math.sin(angle)*radius
            ),
            math.random(1,4),
            Color3.fromRGB(
                math.random(150,255),
                math.random(80,220),
                255
            ),
            math.random(20,80)/100
        )
    end

    --==================================================
    -- ☀️ MẶT TRỜI TRẮNG BÊN PHẢI
    --==================================================

    local sunPosition =
        center
        + root.CFrame.RightVector*215
        + Vector3.new(0,40,0)

    local sun = createStar(
        galaxyFolder,
        sunPosition,
        90,
        Color3.fromRGB(255,255,255),
        0
    )

    local sunLight = Instance.new("PointLight")
    sunLight.Brightness = 40
    sunLight.Range = 1000
    sunLight.Color = Color3.fromRGB(240,245,255)
    sunLight.Parent = sun

    -- ✨ QUẦNG HẠT QUANH MẶT TRỜI
    for i=1,300 do

        local angle = math.random()*math.pi*2
        local radius = math.random(55,155)

        createStar(
            galaxyFolder,
            sunPosition+Vector3.new(
                math.cos(angle)*radius,
                math.random(-55,55),
                math.sin(angle)*radius
            ),
            math.random(1,5),
            Color3.fromRGB(255,255,255),
            math.random(40,90)/100
        )
    end

    --==================================================
    -- 🪐 VẬT THỂ LỚN BÊN TRÁI
    --==================================================

    local planet = Instance.new("Part")

    planet.Shape = Enum.PartType.Ball
    planet.Size = Vector3.new(410,410,410)

    planet.Material = Enum.Material.SmoothPlastic
    planet.Color = Color3.fromRGB(48,58,78)

    planet.Anchored = true
    planet.CanCollide = false
    planet.CanTouch = false
    planet.CanQuery = false

    planet.Position =
        center
        - root.CFrame.RightVector*330

    planet.Parent = galaxyFolder

    -- 💫 HẠT/VÀNH QUANH VẬT THỂ
    for i=1,500 do

        local angle = math.random()*math.pi*2
        local radius = math.random(210,375)

        createStar(
            galaxyFolder,
            planet.Position+Vector3.new(
                math.cos(angle)*radius,
                math.random(-15,15),
                math.sin(angle)*radius
            ),
            math.random(2,6),
            Color3.fromRGB(150,165,195),
            .25
        )
    end

    --==================================================
    -- 🔄 SAO CHUYỂN ĐỘNG
    --==================================================

    galaxyConnection = RunService.Heartbeat:Connect(function()

        for _,data in ipairs(stars) do

            if data.part and data.part.Parent then

                data.angle += data.speed

                data.part.Position =
                    center+
                    Vector3.new(
                        math.cos(data.angle)*data.radius,
                        data.height+
                            math.sin(data.angle*3)*5,
                        math.sin(data.angle)*data.radius
                    )
            end
        end
    end)
end

makeButton(
    "🌌 BẬT THIÊN HÀ GIỐNG ẢNH",
    createGalaxy
)

makeButton(
    "❌ TẮT THIÊN HÀ",
    removeGalaxy
)

