local function removeFireflies()

	fireflyRunning = false

	if fireflyFolder then
		fireflyFolder:Destroy()
		fireflyFolder = nil
	end
end

local function createFireflies()

	removeFireflies()

	fireflyRunning = true

	fireflyFolder =
		Instance.new("Folder")

	fireflyFolder.Name =
		"SKY_Fireflies"

	fireflyFolder.Parent =
		worldFolder

	local flies = {}

	for i = 1, 45 do

		local part =
			Instance.new("Part")

		part.Shape =
			Enum.PartType.Ball

		part.Size =
			Vector3.new(
				1.4,
				1.4,
				1.4
			)

		part.Material =
			Enum.Material.Neon

		part.Color =
			Color3.fromRGB(
				255,
				240,
				80
			)

		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false

		part.Parent =
			fireflyFolder

		local light =
			Instance.new("PointLight")

		light.Brightness = 0.8
		light.Range = 8
		light.Color =
			Color3.fromRGB(
				255,
				235,
				90
			)

		light.Parent = part

		table.insert(
			flies,
			{
				part = part,
				angle =
					math.random()
					* math.pi * 2,
				radius =
					math.random(15, 80),
				height =
					math.random(-20, 40),
				speed =
					math.random(3, 8)
					/ 100
			}
		)
	end

	task.spawn(function()

		while fireflyRunning
		and fireflyFolder
		and fireflyFolder.Parent do

			local character =
				player.Character

			local root =
				character
				and character:FindFirstChild(
					"HumanoidRootPart"
				)

			if root then

				for _, data in ipairs(flies) do

					if data.part
					and data.part.Parent then

						data.angle +=
							data.speed

						data.part.Position =
							root.Position
							+ Vector3.new(

								math.cos(
									data.angle
								)
								* data.radius,

								data.height
								+ math.sin(
									os.clock() * 2
								) * 4,

								math.sin(
									data.angle
								)
								* data.radius
							)
					end
				end
			end

			task.wait(0.05)
		end
	end)
end

makeButton(
	"✨ BẬT ĐOM ĐÓM",
	createFireflies
)

makeButton(
	"❌ TẮT ĐOM ĐÓM",
	removeFireflies
)

