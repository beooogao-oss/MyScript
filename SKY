local rainbowFolder
local rainbowRunning = false

local function removeRainbow()

    rainbowRunning = false

    if rainbowFolder then
        rainbowFolder:Destroy()
        rainbowFolder = nil
    end
end

local function createRainbow()

    removeRainbow()

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if not root then
        return
    end

    rainbowRunning = true

    rainbowFolder = Instance.new("Folder")
    rainbowFolder.Name = "RuHub_Rainbow"
    rainbowFolder.Parent = workspace

    local colors = {
        Color3.fromRGB(255,0,0),
        Color3.fromRGB(255,150,0),
        Color3.fromRGB(255,255,0),
        Color3.fromRGB(0,255,0),
        Color3.fromRGB(0,200,255),
        Color3.fromRGB(0,80,255),
        Color3.fromRGB(180,0,255)
    }

    local center =
        root.Position
        - root.CFrame.RightVector * 180
        + Vector3.new(0,80,0)

    for colorIndex, color in ipairs(colors) do

        for i = 1,41 do

            local p = Instance.new("Part")

            p.Anchored = true
            p.CanCollide = false
            p.CanTouch = false
            p.CanQuery = false

            p.Material = Enum.Material.Neon
            p.Color = color
            p.Size = Vector3.new(8,8,8)

            local x = (i - 21) * 15
            local y = ((i - 21)^2) * 0.055
            local z = colorIndex * 9

            p.Position =
                center
                + Vector3.new(x,y,z)

            p.Parent = rainbowFolder
        end
    end
end

makeButton(
