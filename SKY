local function removeRainbow()

	if rainbowFolder then
		rainbowFolder:Destroy()
		rainbowFolder = nil
	end
end

local function createRainbow()

	removeRainbow()

	local character = player.Character
	if not character then
		return
	end

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return
	end

	rainbowFolder =
		Instance.new("Folder")

	rainbowFolder.Name =
		"SKY_Rainbow"

	rainbowFolder.Parent =
		worldFolder

	local center =
		root.Position
		+ Vector3.new(
			0,
			70,
			100
		)

	local colors = {

		Color3.fromRGB(255, 0, 0),

		Color3.fromRGB(255, 130, 0),

		Color3.fromRGB(255, 255, 0),

		Color3.fromRGB(0, 255, 0),

		Color3.fromRGB(0, 170, 255),

		Color3.fromRGB(0, 0, 255),

		Color3.fromRGB(180, 0, 255)
	}

	for index, color in ipairs(colors) do

		local radius =
			70 - (index - 1) * 4

		for i = 0, 35 do

			local angle =
				math.pi
				* (i / 35)

			local part =
				Instance.new("Part")

			part.Size =
				Vector3.new(
					3,
					3,
					3
				)

			part.Material =
				Enum.Material.Neon

			part.Color = color

			part.Anchored = true
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = false

			part.Position =
				center
				+ Vector3.new(

					math.cos(angle)
					* radius,

					math.sin(angle)
					* radius,

					0
				)

			part.Parent =
				rainbowFolder
		end
	end
end

makeButton(
	"🌈 BẬT CẦU VỒNG",
	createRainbow
)

makeButton(
	"❌ TẮT CẦU VỒNG",
	removeRainbow
)

