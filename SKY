RunService.Heartbeat:Connect(function()

	if not waterActive or not waterRegion then
		return
	end

	local character = player.Character
	if not character then
		return
	end

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if not root or not humanoid then
		return
	end

	local min = waterRegion.CFrame.Position
		- waterRegion.Size / 2

	local max = waterRegion.CFrame.Position
		+ waterRegion.Size / 2

	local p = root.Position

	if p.X >= min.X
	and p.X <= max.X
	and p.Y >= min.Y
	and p.Y <= max.Y
	and p.Z >= min.Z
	and p.Z <= max.Z then

		if humanoid:GetState()
			~= Enum.HumanoidStateType.Swimming then

			humanoid:ChangeState(
				Enum.HumanoidStateType.Swimming
			)
		end
	end
end)

