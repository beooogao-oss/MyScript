-- THIÊN HÀ 1500 STUDS
-- =========================

local galaxyFolder

local function removeGalaxy()

    if galaxyFolder then
        galaxyFolder:Destroy()
        galaxyFolder = nil
    end

end

local function createGalaxy()

    removeGalaxy()

    local char = player.Character
    local root =
        char and char:FindFirstChild("HumanoidRootPart")

    if not root then return end

    galaxyFolder =
        Instance.new("Folder")

    galaxyFolder.Name =
        "RuHub_Galaxy"

    galaxyFolder.Parent =
        workspace

    local center =
        root.Position
        + root.CFrame.LookVector * 1000
        + Vector3.new(0,350,0)

    local radius = 750

    for arm=1,4 do

        for i=1,180 do

            local t = i/180

            local angle =
                t*math.pi*5
                + (arm-1)*math.pi/2

            local r =
                t*radius

            local x =
                math.cos(angle)*r

            local z =
                math.sin(angle)*r

            local y =
                math.sin(t*math.pi)*35

            local star =
                Instance.new("Part")

            star.Shape =
                Enum.PartType.Ball

            local size =
                math.random(2,7)

            star.Size =
                Vector3.new(
                    size,
                    size,
                    size
                )

            star.Material =
                Enum.Material.Neon

            star.Color =
                Color3.fromRGB(
                    math.random(150,255),
                    math.random(150,255),
                    255
                )

            star.Anchored = true
            star.CanCollide = false
            star.CanTouch = false
            star.CanQuery = false

            star.Position =
                center +
                Vector3.new(x,y,z)

            star.Parent =
                galaxyFolder

        end
    end

    local core =
        Instance.new("Part")

    core.Shape =
        Enum.PartType.Ball

    core.Size =
        Vector3.new(180,180,180)

    core.Material =
        Enum.Material.Neon

    core.Color =
        Color3.fromRGB(255,220,150)

    core.Transparency = 0.25

    core.Anchored = true
    core.CanCollide = false
    core.CanTouch = false
    core.CanQuery = false

    core.Position =
        center

    core.Parent =
        galaxyFolder
end

makeButton(
    "🌌 Thiên hà 1500",
    439,
    createGalaxy
)

