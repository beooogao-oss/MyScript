makeButton("🌈 Cầu vồng", 247, function()
    if rainbowEffect then
        rainbowEffect:Destroy()
    end

    rainbowEffect = Instance.new("ColorCorrectionEffect")
    rainbowEffect.Name = "RainbowSky"
    rainbowEffect.Parent = Lighting

    task.spawn(function()
        local hue = 0

        while rainbowEffect and rainbowEffect.Parent do
            hue = (hue + 0.01) % 1
            rainbowEffect.TintColor = Color3.fromHSV(hue, 0.35, 1)
            task.wait(0.05)
        end
    end)
end)

makeButton("🌧️ Mưa", 295, function()
    local rain = Instance.new("Part")
    rain.Name = "RuHubRain"
    rain.Size = Vector3.new(80, 1, 80)
    rain.Transparency = 1
    rain.CanCollide = false
    rain.Anchored = true
    rain.Parent = workspace

    local particle = Instance.new("ParticleEmitter")
    particle.Name = "Rain"
    particle.Texture = "rbxassetid://48374994"
    particle.Rate = 500
    particle.Lifetime = NumberRange.new(1, 2)
    particle.Speed = NumberRange.new(60, 80)
    particle.Acceleration = Vector3.new(0, -20, 0)
    particle.Size = NumberSequence.new(0.08)
    particle.Transparency = NumberSequence.new(0.25)
    particle.Parent = rain

    local connection
    connection = game:GetService("RunService").Heartbeat:Connect(function()
        if not rain.Parent then
            connection:Disconnect()
            return
        end

        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")

        if root then
            rain.Position = root.Position + Vector3.new(0, 35, 0)
        end
    end)
end)

