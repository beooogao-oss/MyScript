local windOn = false

local function wind()

    windOn = true

    local connection =
        RunService.Heartbeat:Connect(function()

        if effectsOff or not windOn then
            return
        end

        local character = player.Character

        local root =
            character and
            character:FindFirstChild(
                "HumanoidRootPart"
            )

        if not root then return end

        local attachment =
            root:FindFirstChild(
                "SKY_WindAttachment"
            )

        if not attachment then

            attachment =
                Instance.new("Attachment")

            attachment.Name =
                "SKY_WindAttachment"

            attachment.Parent = root
        end

        local force =
            root:FindFirstChild(
                "SKY_WindForce"
            )

        if not force then

            force =
                Instance.new("VectorForce")

            force.Name =
                "SKY_WindForce"

            force.Attachment0 =
                attachment

            force.RelativeTo =
                Enum.ActuatorRelativeTo.World

            force.ApplyAtCenterOfMass =
                true

            force.Parent = root
        end

        -- 🌬️ GIÓ CHỈ 10%
        force.Force =
            root.CFrame.LookVector*
            root.AssemblyMass*
            workspace.Gravity*
            .10
    end)

    table.insert(connections,connection)
end

