-- 🌊 NƯỚC 30 ĐỘ SÂU
-- 📦 ĐỒ VẬT NỔI + TRÔI
-- 🚫 KHÔNG ĐẨY NGƯỜI CHƠI
-- 🚫 KHÔNG NẢY
-- =========================

local waterFolder
local waterConnection

local WATER_DEPTH=30
local WATER_SIZE=1500

local floatingParts={}

local function removeWater()

    if waterConnection then
        waterConnection:Disconnect()
        waterConnection=nil
    end

    for part,data in pairs(floatingParts) do

        if data.force then
            data.force:Destroy()
        end

        if data.attachment then
            data.attachment:Destroy()
        end

        floatingParts[part]=nil
    end

    if waterFolder then
        waterFolder:Destroy()
        waterFolder=nil
    end
end

local function createWater()

    removeWater()

    local char=player.Character
    local root=char and char:FindFirstChild("HumanoidRootPart")

    if not root then return end

    waterFolder=Instance.new("Folder")
    waterFolder.Name="SKY_Water"
    waterFolder.Parent=workspace

    local water=Instance.new("Part")

    water.Name="Ocean"

    water.Size=Vector3.new(
        WATER_SIZE,
        1,
        WATER_SIZE
    )

    water.Position=
        root.Position-
        Vector3.new(0,5,0)

    water.Anchored=true

    water.CanCollide=false
    water.CanTouch=false
    water.CanQuery=false

    water.Material=Enum.Material.Glass
    water.Color=Color3.fromRGB(25,145,210)
    water.Transparency=.25
    water.Reflectance=.35

    water.Parent=waterFolder

    local volume=Instance.new("Part")

    volume.Name="WaterDepth"

    volume.Size=Vector3.new(
        WATER_SIZE,
        WATER_DEPTH,
        WATER_SIZE
    )

    volume.Position=
        water.Position-
        Vector3.new(
            0,
            WATER_DEPTH/2,
            0
        )

    volume.Anchored=true
    volume.Transparency=1
    volume.CanCollide=false
    volume.CanTouch=false
    volume.CanQuery=false

    volume.Parent=waterFolder

    local scanTimer=0

    waterConnection=
        RunService.Heartbeat:Connect(function(dt)

        if not waterFolder
        or not waterFolder.Parent then

            if waterConnection then
                waterConnection:Disconnect()
                waterConnection=nil
            end

            return
        end

        scanTimer+=dt

        if scanTimer<.15 then
            return
        end

        scanTimer=0

        local parts=
            workspace:GetPartBoundsInBox(
                CFrame.new(
                    water.Position-
                    Vector3.new(
                        0,
                        WATER_DEPTH/2,
                        0
                    )
                ),
                Vector3.new(
                    350,
                    WATER_DEPTH+15,
                    350
                )
            )

        local detected={}

        for _,part in ipairs(parts) do

            if part:IsA("BasePart")
            and not part.Anchored
            and not part:IsDescendantOf(waterFolder)
            and not (
                player.Character
                and part:IsDescendantOf(
                    player.Character
                )
            ) then

                local surfaceY=water.Position.Y
                local bottomY=surfaceY-WATER_DEPTH
                local y=part.Position.Y

                if y<=surfaceY+3
                and y>=bottomY then

                    detected[part]=true

                    local data=floatingParts[part]

                    if not data then

                        local attachment=
                            Instance.new("Attachment")

                        attachment.Name=
                            "SKY_FloatAttachment"

                        attachment.Parent=part

                        local force=
                            Instance.new("VectorForce")

                        force.Name=
                            "SKY_FloatForce"

                        force.Attachment0=
                            attachment

                        force.RelativeTo=
                            Enum.ActuatorRelativeTo.World

                        force.ApplyAtCenterOfMass=true
                        force.Parent=part

                        data={
                            attachment=attachment,
                            force=force,
                            phase=math.random()*20
                        }

                        floatingParts[part]=data
                    end

                    local mass=part.AssemblyMass
                    local velocity=part.AssemblyLinearVelocity

                    -- lực nổi nhẹ, tránh nảy
                    local buoyancy=
                        mass*
                        workspace.Gravity*
                        .98

                    local damping=
                        -velocity.Y*
                        mass*
                        4

                    -- dòng nước trôi ngang
                    local t=
                        os.clock()+
                        data.phase

                    local driftX=
                        math.sin(
                            t*.35+
                            part.Position.Z*.01
                        )*.8

                    local driftZ=
                        math.cos(
                            t*.30+
                            part.Position.X*.01
                        )*.8

                    data.force.Force=
                        Vector3.new(
                            driftX*mass,
                            buoyancy+damping,
                            driftZ*mass
                        )
                end
            end
        end

        -- XÓA LỰC KHI ĐỒ RA KHỎI NƯỚC
        for part,data in pairs(floatingParts) do

            if not detected[part]
            or not part.Parent then

                if data.force then
                    data.force:Destroy()
                end

                if data.attachment then
                    data.attachment:Destroy()
                end

                floatingParts[part]=nil
            end
        end
    end)
end

