-- 🌌 THIÊN HÀ MÀU
-- =========================

local Galaxy
local GalaxyRunning = false

local function StopGalaxy()

    GalaxyRunning = false

    if Galaxy then
        Galaxy:Destroy()
        Galaxy = nil
    end

end

local function StartGalaxy()

    StopGalaxy()

    local Character = Player.Character
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")

    if not Root then return end

    GalaxyRunning = true

    Galaxy = Instance.new("Folder")
    Galaxy.Name = "ColorGalaxy"
    Galaxy.Parent = World

    local Center =
        Root.Position+
        Root.CFrame.LookVector*350+
        Vector3.new(0,150,0)

    local Stars = {}

    -- MÀU THIÊN HÀ
    local GalaxyColors = {
        Color3.fromRGB(70,120,255),
        Color3.fromRGB(120,70,255),
        Color3.fromRGB(190,70,255),
        Color3.fromRGB(255,70,190),
        Color3.fromRGB(80,210,255),
        Color3.fromRGB(255,120,220)
    }

    -- SAO
    for i=1,220 do

        local Star = Instance.new("Part")

        Star.Shape = Enum.PartType.Ball

        local S = math.random(2,5)

        Star.Size =
            Vector3.new(S,S,S)

        Star.Material = Enum.Material.Neon

        Star.Color =
            GalaxyColors[
                math.random(1,#GalaxyColors)
            ]

        Star.Anchored = true
        Star.CanCollide = false
        Star.CanTouch = false
        Star.CanQuery = false

        local Angle =
            math.random()*math.pi*2

        local Radius =
            math.random(40,420)

        local Height =
            math.random(-130,130)

        Star.Position =
            Center+
            Vector3.new(
                math.cos(Angle)*Radius,
                Height,
                math.sin(Angle)*Radius
            )

        Star.Parent = Galaxy

        table.insert(Stars,{
            Part=Star,
            Angle=Angle,
            Radius=Radius,
            Height=Height,
            Speed=math.random(2,7)/100
        })

    end

    -- 🌌 CÁC DẢI BỤI THIÊN HÀ
    for Arm=1,4 do

        for i=1,100 do

            local T=i/100

            local Angle =
                T*math.pi*5+
                (Arm-1)*(math.pi*2/4)

            local Radius=T*400

            local P=Instance.new("Part")

            P.Shape=Enum.PartType.Ball

            local S=math.random(2,5)

            P.Size=Vector3.new(S,S,S)

            P.Material=Enum.Material.Neon

            P.Color =
                GalaxyColors[
                    ((i+Arm)%#GalaxyColors)+1
                ]

            P.Anchored=true
            P.CanCollide=false
            P.CanTouch=false
            P.CanQuery=false

            P.Position =
                Center+
                Vector3.new(
                    math.cos(Angle)*Radius,
                    math.sin(T*math.pi)*35+
                    math.random(-15,15),
                    math.sin(Angle)*Radius
                )

            P.Parent=Galaxy

        end
    end

    -- 🔵 LÕI THIÊN HÀ
    local Core=Instance.new("Part")

    Core.Shape=Enum.PartType.Ball
    Core.Size=Vector3.new(35,35,35)
    Core.Material=Enum.Material.Neon
    Core.Color=Color3.fromRGB(150,100,255)

    Core.Anchored=true
    Core.CanCollide=false
    Core.CanTouch=false
    Core.CanQuery=false
    Core.Position=Center
    Core.Parent=Galaxy

    local Light=Instance.new("PointLight")
    Light.Color=Color3.fromRGB(130,100,255)
    Light.Brightness=8
    Light.Range=150
    Light.Parent=Core

    -- 🔄 CHUYỂN ĐỘNG
    task.spawn(function()

        while GalaxyRunning
        and Galaxy
        and Galaxy.Parent do

            for _,D in ipairs(Stars) do

                if D.Part and D.Part.Parent then

                    D.Angle += D.Speed

                    D.Part.Position =
                        Center+
                        Vector3.new(
                            math.cos(D.Angle)*D.Radius,
                            D.Height+
                            math.sin(D.Angle*2)*5,
                            math.sin(D.Angle)*D.Radius
                        )

                end
            end

            task.wait(0.04)

        end

    end)

end

Button("🌌 Bật thiên hà màu",StartGalaxy)
Button("❌ Tắt thiên hà",StopGalaxy)

