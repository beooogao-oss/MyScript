-- 🌾 CÁNH ĐỒNG LÚA
-- Chỉ mọc trên Part có Material = Grass
-- =========================================================

local riceFolder
local riceRunning = false
local riceConnection

local function removeRice()

    riceRunning = false

    if riceConnection then
        riceConnection:Disconnect()
        riceConnection = nil
    end

    if riceFolder then
        riceFolder:Destroy()
        riceFolder = nil
    end
end

local function createRice()

    removeRice()

    riceRunning = true

    riceFolder = Instance.new("Folder")
    riceFolder.Name = "SKY_Rice"
    riceFolder.Parent = workspace

    local ricePlants = {}

    -- 🌱 Tìm các mặt cỏ
    for _,part in ipairs(workspace:GetDescendants()) do

        if part:IsA("BasePart")
            and part.Material == Enum.Material.Grass
            and part.Size.X > 5
            and part.Size.Z > 5 then

            local amount =
                math.clamp(
                    math.floor(
                        part.Size.X *
                        part.Size.Z /
                        700
                    ),
                    3,
                    35
                )

            for i = 1,amount do

                local x =
                    (math.random()-0.5)
                    *math.max(
                        2,
                        part.Size.X-3
                    )

                local z =
                    (math.random()-0.5)
                    *math.max(
                        2,
                        part.Size.Z-3
                    )

                local localPos =
                    Vector3.new(
                        x,
                        part.Size.Y/2+0.2,
                        z
                    )

                local worldPos =
                    part.CFrame:PointToWorldSpace(
                        localPos
                    )

                -- 🌾 BỤI LÚA
                local stalks = {}

                for s = 1,3 do

                    local stalk =
                        Instance.new("Part")

                    stalk.Name = "Rice"

                    stalk.Size =
                        Vector3.new(
                            0.12,
                            math.random(25,38)/10,
                            0.12
                        )

                    stalk.Material =
                        Enum.Material.Grass

                    stalk.Color =
                        Color3.fromRGB(
                            100,
                            160+math.random(0,30),
                            45
                        )

                    stalk.Anchored = true
                    stalk.CanCollide = false
                    stalk.CanTouch = false
                    stalk.CanQuery = false

                    local offset =
                        Vector3.new(
                            (math.random()-0.5)*1.2,
                            stalk.Size.Y/2,
                            (math.random()-0.5)*1.2
                        )

                    stalk.Position =
                        worldPos+offset

                    stalk.Parent =
                        riceFolder

                    table.insert(
                        stalks,
                        {
                            part = stalk,
                            base = stalk.CFrame,
                            phase = math.random()*10,
                            height = stalk.Size.Y
                        }
                    )
                end

                table.insert(
                    ricePlants,
                    stalks
                )
            end
        end
    end

    -- 🌬️ LÚA LAY NHẸ THEO GIÓ
    riceConnection =
        RunService.Heartbeat:Connect(function()

            if not riceRunning
                or not riceFolder
                or not riceFolder.Parent then
                return
            end

            local now = os.clock()

            for _,group in ipairs(ricePlants) do

                for _,data in ipairs(group) do

                    if data.part
                        and data.part.Parent then

                        local sway =
                            math.sin(
                                now*1.5
                                +data.phase
                            )*0.12

                        data.part.CFrame =
                            data.base
                            *CFrame.Angles(
                                sway,
                                0,
                                sway*0.7
                            )
                    end
                end
            end
        end)
end

makeButton(
    "🌾 Bật cánh đồng lúa",
    createRice
)

makeButton(
    "❌ Tắt cánh đồng lúa",
