-- =========================================================

local function galaxy()

    destroyEffect("SKY_Galaxy")
    stopConnection("Galaxy")

    local root =
        player.Character
        and player.Character:FindFirstChild("HumanoidRootPart")

    if not root then return end

    local folder = Instance.new("Folder")
    folder.Name = "SKY_Galaxy"
    folder.Parent = workspace

    local center =
        root.Position+
        root.CFrame.LookVector*180+
        Vector3.new(0,45,0)

    local particles = {}

    local colors = {
        Color3.fromRGB(255,255,255),
        Color3.fromRGB(255,245,70),
        Color3.fromRGB(255,70,240),
        Color3.fromRGB(190,50,255),
        Color3.fromRGB(120,180,255)
    }

    for i = 1,260 do

        local p = Instance.new("Part")
        p.Shape = Enum.PartType.Ball

        local size = math.random(1,4)
        p.Size = Vector3.new(size,size,size)

        p.Material = Enum.Material.Neon
        p.Color = colors[math.random(1,#colors)]

        p.Anchored = true
        p.CanCollide = false
        p.CanTouch = false
        p.CanQuery = false

        local angle = math.random()*math.pi*2
        local radius = math.random(30,420)

        p.Position =
            center+
            Vector3.new(
                math.cos(angle)*radius,
                math.random(-130,130),
                math.sin(angle)*radius
            )

        p.Parent = folder

        particles[i] = {
            part=p,
            angle=angle,
            radius=radius,
            height=p.Position.Y-center.Y,
            speed=math.random(3,10)/100
        }
    end

    local planet = Instance.new("Part")
    planet.Shape = Enum.PartType.Ball
    planet.Size = Vector3.new(115,115,115)
    planet.Position = center+Vector3.new(0,-15,0)
    planet.Material = Enum.Material.Neon
    planet.Color = Color3.fromRGB(235,205,255)
    planet.Anchored = true
    planet.CanCollide = false
    planet.CanTouch = false
    planet.CanQuery = false
    planet.Parent = folder

    local planetLight = Instance.new("PointLight")
    planetLight.Color = Color3.fromRGB(255,180,255)
    planetLight.Brightness = 10
    planetLight.Range = 280
    planetLight.Parent = planet

    connections.Galaxy =
        RunService.Heartbeat:Connect(function()

        if not folder.Parent then
            stopConnection("Galaxy")
            return
        end

        local t = os.clock()

        for _,d in ipairs(particles) do

            d.angle += d.speed

            d.part.Position =
                center+
                Vector3.new(
                    math.cos(d.angle)*d.radius,
                    d.height+math.sin(t*2+d.angle)*12,
                    math.sin(d.angle)*d.radius
                )
        end

        planet.CFrame =
            CFrame.new(
                center+Vector3.new(0,-15,0)
            )*
            CFrame.Angles(
                0,
                t*.2,
                0
            )
    end)
end

