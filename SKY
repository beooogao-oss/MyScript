    heartRunning = true

    heartFolder = Instance.new("Folder")
    heartFolder.Name = "RuHub_Heart"
    heartFolder.Parent = workspace

    local center =
        root.Position
        + root.CFrame.LookVector * 120
        + Vector3.new(0,80,0)

    -- ❤️ VIỀN TIM
    for i = 1,221 do

        local t =
            math.pi * 2 * i / 221

        local x =
            16 * math.sin(t)^3

        local y =
            13 * math.cos(t)
            - 5 * math.cos(2*t)
            - 2 * math.cos(3*t)
            - math.cos(4*t)

        local p = Instance.new("Part")

        p.Shape = Enum.PartType.Ball
        p.Size = Vector3.new(4,4,4)

        p.Material = Enum.Material.Neon
        p.Color = Color3.fromRGB(255,50,100)

        p.Anchored = true
        p.CanCollide = false
        p.CanTouch = false
        p.CanQuery = false

        p.Position =
            center
            + Vector3.new(
                x * 5,
                y * 5,
                0
            )

        p.Parent = heartFolder
    end

    -- ✨ HẠT SÁNG
    for i = 1,650 do

        local p = Instance.new("Part")

        p.Shape = Enum.PartType.Ball
        p.Size = Vector3.new(1,1,1)

        p.Material = Enum.Material.Neon
        p.Color = Color3.fromRGB(255,100,150)

        p.Anchored = true
        p.CanCollide = false
        p.CanTouch = false
        p.CanQuery = false

        p.Position =
            center
            + Vector3.new(
                math.random(-250,250),
                math.random(-180,180),
                math.random(-100,100)
            )

        p.Parent = heartFolder
