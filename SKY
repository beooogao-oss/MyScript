local connections = {}

local function stopConnection(name)
    if connections[name] then
        connections[name]:Disconnect()
        connections[name] = nil
    end
end

local function destroyEffect(name)
    local x = workspace:FindFirstChild(name)
    if x then x:Destroy() end
end

