-- =========================================================

local heartFolder
local heartConnection

local function removeHeart()

    if heartConnection then
        heartConnection:Disconnect()
        heartConnection = nil
    end

    if heartFolder then
        heartFolder:Destroy()
        heartFolder = nil
    end
end

local function createHeart()

    removeHeart()

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if not root then return end

    heartFolder = Instance.new("Folder")
    heartFolder.Name = "SKY_Heart"
    heartFolder.Parent = workspace

    local particles = {}

    for i = 1,120 do

        local p = Instance.new("Part")

        p.Shape = Enum.PartType.Ball
        p.Size = Vector3.new(2.5,2.5,2.5)

        p.Material = Enum.Material.Neon
        p.Color = Color3.fromRGB(255,45,110)

        p.Anchored = true
        p.CanCollide = false
        p.CanTouch = false
        p.CanQuery = false

        p.Parent = heartFolder

        particles[i] = p
    end

    heartConnection =
        RunService.Heartbeat:Connect(function()

            if not heartFolder then return end

            local character = player.Character

            local currentRoot =
                character
                and character:FindFirstChild(
                    "HumanoidRootPart"
                )

            if not currentRoot then return end

            local center =
                currentRoot.Position
                + currentRoot.CFrame.LookVector*120
                + Vector3.new(0,70,0)

            local now = os.clock()

            for i,p in ipairs(particles) do

                local t =
                    (
                        i/#particles
                        +now*0.08
                    )%1
                    *math.pi*2

                local x =
                    16*math.sin(t)^3

                local y =
                    13*math.cos(t)
                    -5*math.cos(2*t)
                    -2*math.cos(3*t)
                    -math.cos(4*t)

                p.Position =
                    center
                    +currentRoot.CFrame.RightVector
                        *(x*5)
                    +Vector3.new(
                        0,
                        y*5,
                        0
                    )
            end
        end)
end

