-- =========================================================

local function rice()

    if effectsOff then return end

    destroyEffect("SKY_Rice")

    local f = Instance.new("Folder")
    f.Name = "SKY_Rice"
    f.Parent = workspace

    local stalks = {}
    local count = 0

    for _,part in ipairs(workspace:GetDescendants()) do

        if count >= 300 then break end

        if part:IsA("BasePart")
        and part.Material == Enum.Material.Grass
        and part.Size.X > 6
        and part.Size.Z > 6 then

            for i=1,
                math.min(
                    8,
                    math.floor(
                        part.Size.X*
                        part.Size.Z/1000
                    )
                ) do

                if count >= 300 then break end

                local p = Instance.new("Part")

                p.Size = Vector3.new(.12,3,.12)
                p.Material = Enum.Material.Grass
                p.Color = Color3.fromRGB(110,180,50)

                p.Anchored = true
                p.CanCollide = false
                p.CanTouch = false
                p.CanQuery = false

                local x =
                    (math.random()-.5)
                    *(part.Size.X-2)

                local z =
                    (math.random()-.5)
                    *(part.Size.Z-2)

                p.Position =
                    part.Position +
                    Vector3.new(
                        x,
                        part.Size.Y/2+1.5,
                        z
                    )

                p.Parent = f

                table.insert(
                    stalks,
                    {
                        p = p,
                        base = p.CFrame,
                        phase = math.random()*10
                    }
                )

                count += 1
            end
        end
    end

    local c = RunService.Heartbeat:Connect(function()

        if effectsOff or not f.Parent then return end

        local t = os.clock()

        for _,d in ipairs(stalks) do

            local s =
                math.sin(
                    t*1.5+d.phase
                )*.08

            d.p.CFrame =
                d.base*
                CFrame.Angles(
                    s,
                    0,
                    s*.5
                )
        end
    end)

    table.insert(connections,c)
end

