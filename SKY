local Rainbow

local function StopRainbow()

    if Rainbow then
        Rainbow:Destroy()
        Rainbow = nil
    end

end

local function StartRainbow()

    StopRainbow()

    local Character = Player.Character
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")

    if not Root then return end

    Rainbow = Instance.new("Folder")
    Rainbow.Name = "Rainbow"
    Rainbow.Parent = World

    local Center =
        Root.Position
        - Root.CFrame.RightVector * 180
        + Vector3.new(0,80,0)

    local Colors = {
        Color3.fromRGB(255,50,70),
        Color3.fromRGB(255,140,30),
        Color3.fromRGB(255,240,40),
        Color3.fromRGB(40,255,100),
        Color3.fromRGB(30,190,255),
        Color3.fromRGB(70,80,255),
        Color3.fromRGB(190,60,255)
    }

    for n,Color in ipairs(Colors) do

        local Radius = 75-(n-1)*3

        for i=0,40 do

            local Angle = math.pi*i/40

            local P = Instance.new("Part")

            P.Size = Vector3.new(3,3,2)
            P.Position =
                Center+
                Vector3.new(
                    math.cos(Angle)*Radius,
                    math.sin(Angle)*Radius,
                    0
                )

            P.Anchored = true
            P.CanCollide = false
            P.CanTouch = false
            P.CanQuery = false
            P.Material = Enum.Material.Neon
            P.Color = Color

            P.Parent = Rainbow

        end
    end

end

Button("🌈 Bật cầu vồng",StartRainbow)
Button("❌ Tắt cầu vồng",StopRainbow)

