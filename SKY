local function galaxy()

    if effectsOff then return end

    destroyEffect("SKY_Galaxy")

    local root =
        player.Character
        and player.Character:FindFirstChild("HumanoidRootPart")

    if not root then return end

    local folder = Instance.new("Folder")
    folder.Name = "SKY_Galaxy"
    folder.Parent = workspace

    local center =
        root.Position
        + root.CFrame.LookVector * 180
        + Vector3.new(0,45,0)

    -- ⭐ HẠT SAO
    local particles = {}

    local colors = {
        Color3.fromRGB(255,255,255),
        Color3.fromRGB(255,245,70),
        Color3.fromRGB(255,70,240),
        Color3.fromRGB(190,50,255),
        Color3.fromRGB(120,180,255)
    }

    for i=1,260 do

        local p = Instance.new("Part")

        p.Shape = Enum.PartType.Ball

        local size = math.random(1,4)

        p.Size = Vector3.new(size,size,size)

        p.Material = Enum.Material.Neon
        p.Color = colors[
            math.random(1,#colors)
        ]

        p.Anchored = true
        p.CanCollide = false
        p.CanTouch = false
        p.CanQuery = false

        local angle = math.random()*math.pi*2
        local radius = math.random(30,420)

        p.Position =
            center +
            Vector3.new(
                math.cos(angle)*radius,
                math.random(-130,130),
                math.sin(angle)*radius
            )

        p.Parent = folder

        particles[i] = {
            part = p,
            angle = angle,
            radius = radius,
            height = p.Position.Y-center.Y,
            speed = math.random(3,10)/100
        }
    end

    -- =====================================================
    -- 💗 TIM NEON
    -- =====================================================

    local heartFolder = Instance.new("Folder")
    heartFolder.Name = "Heart"
    heartFolder.Parent = folder

    local heartParts = {}

    for i=1,65 do

        local p = Instance.new("Part")

        p.Shape = Enum.PartType.Ball
        p.Size = Vector3.new(3,3,3)

        p.Material = Enum.Material.Neon
        p.Color = Color3.fromRGB(255,80,220)

        p.Anchored = true
        p.CanCollide = false
        p.CanTouch = false
        p.CanQuery = false

        p.Parent = heartFolder

        heartParts[i] = p
    end

    -- =====================================================
    -- 🪐 3 VÒNG MỎNG
    -- =====================================================

    local ringFolder = Instance.new("Folder")
    ringFolder.Name = "PlanetRing"
    ringFolder.Parent = folder

    local rings = {}

    for i=1,3 do

        local ring = Instance.new("Part")

        ring.Shape = Enum.PartType.Cylinder

        local size = 145+i*25

        ring.Size = Vector3.new(
            3,
            size,
            size
        )

        ring.Material = Enum.Material.Neon

        if i == 1 then
            ring.Color =
                Color3.fromRGB(255,255,255)

        elseif i == 2 then
            ring.Color =
                Color3.fromRGB(230,150,255)

        else
            ring.Color =
                Color3.fromRGB(255,210,255)
        end

        ring.Transparency = .08

        ring.Anchored = true
        ring.CanCollide = false
        ring.CanTouch = false
        ring.CanQuery = false

        ring.Parent = ringFolder

        rings[i] = ring
    end

    -- =====================================================
    -- 🪐 LÕI HÀNH TINH
    -- =====================================================

    local planet = Instance.new("Part")

    planet.Shape = Enum.PartType.Ball
    planet.Size = Vector3.new(115,115,115)

    planet.Position =
        center + Vector3.new(0,-15,0)

    planet.Material = Enum.Material.Neon
    planet.Color =
        Color3.fromRGB(235,205,255)

    planet.Anchored = true
    planet.CanCollide = false
    planet.CanTouch = false
    planet.CanQuery = false

    planet.Parent = folder

    local planetLight = Instance.new("PointLight")

    planetLight.Color =
        Color3.fromRGB(255,180,255)

    planetLight.Brightness = 10
    planetLight.Range = 280

    planetLight.Parent = planet

    -- =====================================================
    -- ☀️ CẦU SÁNG
    -- =====================================================

    local sun = Instance.new("Part")

    sun.Shape = Enum.PartType.Ball
    sun.Size = Vector3.new(55,55,55)

    sun.Position =
        center + Vector3.new(230,70,0)

    sun.Material = Enum.Material.Neon
    sun.Color =
        Color3.fromRGB(255,255,220)

    sun.Anchored = true
    sun.CanCollide = false
    sun.CanTouch = false
    sun.CanQuery = false

    sun.Parent = folder

    local sunLight = Instance.new("PointLight")

    sunLight.Color =
        Color3.fromRGB(255,255,180)

    sunLight.Brightness = 12
    sunLight.Range = 300

    sunLight.Parent = sun

    -- =====================================================
    -- 🔄 GALAXY CHUYỂN ĐỘNG
    -- =====================================================

    local connection

    connection = RunService.Heartbeat:Connect(function()

        if effectsOff or not folder.Parent then

            if connection then
                connection:Disconnect()
            end

            return
        end

        local t = os.clock()

        -- 🌠 HẠT BAY
        for _,d in ipairs(particles) do

            d.angle += d.speed

            d.part.Position =
                center +
                Vector3.new(
                    math.cos(d.angle)*d.radius,
                    d.height+
                        math.sin(t*2+d.angle)*12,
                    math.sin(d.angle)*d.radius
                )
        end

        -- 💗 TIM
        for i,p in ipairs(heartParts) do

            local a =
                ((i/#heartParts)+t*.08)
                *math.pi*2

            local x =
                16*math.sin(a)^3

            local y =
                13*math.cos(a)
                -5*math.cos(2*a)
                -2*math.cos(3*a)
                -math.cos(4*a)

            p.Position =
                center+
                Vector3.new(
                    x*2.2,
                    y*2.2+65,
                    0
                )
        end

        -- 🪐 VÒNG
        for i,ring in ipairs(rings) do

            ring.CFrame =
                CFrame.new(
                    center+
                    Vector3.new(0,-15,0)
                )
                *
                CFrame.Angles(
                    math.rad(68),
                    t*(.12+i*.025),
                    math.rad(8)
                )
        end

        -- 🪐 HÀNH TINH
        planet.CFrame =
            CFrame.new(
                center+
                Vector3.new(0,-15,0)
            )
            *
            CFrame.Angles(
                0,
                t*.2,
                0
            )

        -- ☀️ CẦU SÁNG
        sun.Position =
            center+
            Vector3.new(
                math.cos(t*.3)*230,
                70+math.sin(t*.5)*30,
                math.sin(t*.3)*100
            )
    end)

    table.insert(connections,connection)
end

