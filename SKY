local buttonY = 5

local function makeButton(text,callback)

    local b =
        Instance.new("TextButton")

    b.Size =
        UDim2.new(1,-14,0,42)

    b.Position =
        UDim2.fromOffset(7,buttonY)

    b.Text = text
    b.TextSize = 16

    b.TextColor3 =
        Color3.fromRGB(225,235,230)

    b.BackgroundColor3 =
        Color3.fromRGB(31,57,46)

    b.BorderSizePixel = 0

    b.Parent = scroll

    local c =
        Instance.new("UICorner")

    c.CornerRadius =
        UDim.new(0,14)

    c.Parent = b

    b.MouseButton1Click:Connect(callback)

    buttonY += 48

    scroll.CanvasSize =
        UDim2.new(0,0,0,buttonY + 5)

    return b
end

