local function makeDuck()

	local model = Instance.new("Model")
	model.Name = "Duck"
	model.Parent = duckFolder

	-- Thân
	local body = Instance.new("Part")

	body.Shape = Enum.PartType.Ball
	body.Size = Vector3.new(
		DUCK_SIZE,
		DUCK_SIZE * 0.75,
		DUCK_SIZE
	)

	body.Color = Color3.fromRGB(255,230,50)
	body.Material = Enum.Material.SmoothPlastic

	body.Anchored = true
	body.CanCollide = false
	body.CanTouch = false
	body.CanQuery = false

	body.Parent = model

	-- Đầu
	local head = Instance.new("Part")

	head.Shape = Enum.PartType.Ball
	head.Size = Vector3.new(
		0.65,
		0.65,
		0.65
	)

	head.Color = Color3.fromRGB(255,235,60)
	head.Material = Enum.Material.SmoothPlastic

	head.Anchored = true
	head.CanCollide = false
	head.CanTouch = false
	head.CanQuery = false

	head.Parent = model

	-- Mỏ
	local beak = Instance.new("Part")

	beak.Shape = Enum.PartType.Ball
	beak.Size = Vector3.new(
		0.35,
		0.22,
		0.35
	)

	beak.Color = Color3.fromRGB(255,140,0)
	beak.Material = Enum.Material.SmoothPlastic

	beak.Anchored = true
	beak.CanCollide = false
	beak.CanTouch = false
	beak.CanQuery = false

	beak.Parent = model

	-- Mắt trái
	local eye1 = Instance.new("Part")

	eye1.Shape = Enum.PartType.Ball
	eye1.Size = Vector3.new(
		0.12,
		0.12,
		0.12
	)

	eye1.Color = Color3.fromRGB(0,0,0)
	eye1.Material = Enum.Material.Neon

	eye1.Anchored = true
	eye1.CanCollide = false
	eye1.CanTouch = false
	eye1.CanQuery = false

	eye1.Parent = model

	-- Mắt phải
	local eye2 = eye1:Clone()
	eye2.Parent = model

	return {
		model = model,
		body = body,
		head = head,
		beak = beak,
		eye1 = eye1,
		eye2 = eye2
	}

end

