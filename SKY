local galaxyFolder
local galaxyRunning = false

local function removeGalaxy()
    galaxyRunning = false

    if galaxyFolder then
        galaxyFolder:Destroy()
        galaxyFolder = nil
    end
end

local function createGalaxy()
    removeGalaxy()

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    galaxyRunning = true

    galaxyFolder = Instance.new("Folder")
    galaxyFolder.Name = "SKY_Galaxy"
    galaxyFolder.Parent = workspace

    local center =
        root.Position+
        root.CFrame.LookVector*1000+
        Vector3.new(0,450,0)

    local movingStars = {}

    for i=1,450 do
        local star = Instance.new("Part")

        star.Shape = Enum.PartType.Ball

        local size = math.random(2,7)
        star.Size = Vector3.new(size,size,size)

        star.Material = Enum.Material.Neon

        star.Color = Color3.fromRGB(
            math.random(180,255),
            math.random(180,255),
            math.random(200,255)
        )

        star.Anchored = true
        star.CanCollide = false
        star.CanTouch = false
        star.CanQuery = false

        local angle = math.random()*math.pi*2
        local distance = math.random(100,750)
        local height = math.random(-220,220)

        star.Position =
            center+
            Vector3.new(
                math.cos(angle)*distance,
                height,
                math.sin(angle)*distance
            )

        star.Parent = galaxyFolder

        table.insert(movingStars,{
            part=star,
            angle=angle,
            distance=distance,
            height=height,
            speed=math.random(2,8)/100
        })
    end

    for arm=1,5 do
        for i=1,230 do
            local t=i/230

            local angle =
                t*math.pi*7+
                (arm-1)*(math.pi*2/5)

            local radius=t*750

            local x=math.cos(angle)*radius
            local z=math.sin(angle)*radius

            local y =
                math.sin(t*math.pi)*40+
                math.random(-20,20)

            local dust=Instance.new("Part")

            dust.Shape=Enum.PartType.Ball

            local size=math.random(3,9)
            dust.Size=Vector3.new(size,size,size)

            dust.Material=Enum.Material.Neon

            dust.Color=Color3.fromRGB(
                math.random(100,220),
                math.random(80,180),
                math.random(180,255)
            )

            dust.Transparency=.2
            dust.Anchored=true
            dust.CanCollide=false
            dust.CanTouch=false
            dust.CanQuery=false

            dust.Position=
                center+
                Vector3.new(x,y,z)

            dust.Parent=galaxyFolder
        end
    end

    local planet=Instance.new("Part")

    planet.Shape=Enum.PartType.Ball
    planet.Size=Vector3.new(430,430,430)
    planet.Material=Enum.Material.SmoothPlastic
    planet.Color=Color3.fromRGB(75,80,95)

    planet.Anchored=true
    planet.CanCollide=false
    planet.CanTouch=false
    planet.CanQuery=false

    planet.Position=
        center-
        root.CFrame.RightVector*430+
        Vector3.new(0,-80,0)

    planet.Parent=galaxyFolder

    for i=1,3 do
        local ring=Instance.new("Part")

        ring.Shape=Enum.PartType.Cylinder

        ring.Size=Vector3.new(
            12,
            650+i*80,
            650+i*80
        )

        ring.Material=Enum.Material.Neon

        ring.Color=Color3.fromRGB(
            100+i*30,
            100+i*20,
            130+i*30
        )

        ring.Transparency=.45
        ring.Anchored=true
        ring.CanCollide=false
        ring.CanTouch=false
        ring.CanQuery=false

        ring.CFrame=
            CFrame.new(planet.Position)*
            CFrame.Angles(
                math.rad(65),
                0,
                math.rad(20)
            )

        ring.Parent=galaxyFolder
    end

    local sun=Instance.new("Part")

    sun.Shape=Enum.PartType.Ball
    sun.Size=Vector3.new(260,260,260)
    sun.Material=Enum.Material.Neon
    sun.Color=Color3.fromRGB(255,245,210)

    sun.Anchored=true
    sun.CanCollide=false
    sun.CanTouch=false
    sun.CanQuery=false

    sun.Position=
        center+
        root.CFrame.RightVector*500+
        Vector3.new(0,80,0)

    sun.Parent=galaxyFolder

    local light=Instance.new("PointLight")
    light.Brightness=20
    light.Range=1200
    light.Parent=sun

    task.spawn(function()
        while galaxyRunning
        and galaxyFolder
        and galaxyFolder.Parent do

            for _,data in ipairs(movingStars) do
                if data.part and data.part.Parent then
                    data.angle+=data.speed

                    data.part.Position=
                        center+
                        Vector3.new(
                            math.cos(data.angle)*data.distance,
                            data.height,
                            math.sin(data.angle)*data.distance
                        )
                end
            end

            task.wait(.03)
        end
    end)
end

