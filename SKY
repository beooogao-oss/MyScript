				Color3.fromRGB(
					math.random(100,220),
					math.random(80,180),
					math.random(180,255)
				)

			p.Transparency=0.2

			p.Anchored=true
			p.CanCollide=false
			p.CanTouch=false
			p.CanQuery=false

			p.Position =
				center
				+ Vector3.new(
					math.cos(angle)*radius,
					math.sin(t*math.pi)*40
						+math.random(-20,20),
					math.sin(angle)*radius
				)

			p.Parent=galaxyFolder
		end
	end

	local planet=Instance.new("Part")

	planet.Shape=Enum.PartType.Ball
	planet.Size=Vector3.new(430,430,430)

	planet.Material=Enum.Material.SmoothPlastic
	planet.Color=Color3.fromRGB(75,80,95)

	planet.Anchored=true
	planet.CanCollide=false
	planet.CanTouch=false
	planet.CanQuery=false

	planet.Position =
		center
		- root.CFrame.RightVector*430
		+ Vector3.new(0,-80,0)

	planet.Parent=galaxyFolder

	for i=1,3 do

		local ring=Instance.new("Part")

		ring.Shape=Enum.PartType.Cylinder

		ring.Size=Vector3.new(
			12,
			650+i*80,
			650+i*80
		)

		ring.Material=Enum.Material.Neon

		ring.Color =
			Color3.fromRGB(
				100+i*30,
				100+i*20,
				130+i*30
			)

		ring.Transparency=0.45

		ring.Anchored=true
		ring.CanCollide=false
		ring.CanTouch=false
		ring.CanQuery=false

		ring.CFrame =
			CFrame.new(planet.Position)
			*CFrame.Angles(
				math.rad(65),
				0,
				math.rad(20)
			)

		ring.Parent=galaxyFolder
	end

	local sun=Instance.new("Part")

	sun.Shape=Enum.PartType.Ball
	sun.Size=Vector3.new(260,260,260)

	sun.Material=Enum.Material.Neon
	sun.Color=Color3.fromRGB(255,245,210)

	sun.Anchored=true
	sun.CanCollide=false
	sun.CanTouch=false
	sun.CanQuery=false

	sun.Position =
		center
		+ root.CFrame.RightVector*500
		+ Vector3.new(0,80,0)

	sun.Parent=galaxyFolder

	local light=Instance.new("PointLight")
	light.Brightness=20
	light.Range=1200
	light.Parent=sun

	task.spawn(function()

		while galaxyRunning
		and galaxyFolder
		and galaxyFolder.Parent do

			for _,data in ipairs(stars) do

				if data.part and data.part.Parent then

					data.angle += data.speed

					data.part.Position =
						center
						+Vector3.new(
							math.cos(data.angle)
							*data.distance,

							data.height,

							math.sin(data.angle)
							*data.distance
						)
				end
