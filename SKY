makeButton("🌈 Cầu vồng đôi", 343, function()

    for _, obj in ipairs(workspace:GetChildren()) do
        if obj.Name == "RuHub_Rainbow" then
            obj:Destroy()
        end
    end

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if not root then return end

    local center =
        root.Position
        + root.CFrame.LookVector * 150
        + Vector3.new(0, 70, 0)

    local colors = {
        Color3.fromRGB(255,0,0),
        Color3.fromRGB(255,140,0),
        Color3.fromRGB(255,255,0),
        Color3.fromRGB(0,255,0),
        Color3.fromRGB(0,170,255),
        Color3.fromRGB(0,0,255),
        Color3.fromRGB(180,0,255)
    }

    for rainbow = 1,2 do

        local radius = 70 + rainbow * 8

        for cIndex,color in ipairs(colors) do

            for i = 0,35 do

                local angle = math.pi * (i / 35)

                local x = math.cos(angle) * radius
                local y = math.sin(angle) * radius

                local part = Instance.new("Part")
                part.Name = "RuHub_Rainbow"
                part.Anchored = true
                part.CanCollide = false
                part.Material = Enum.Material.Neon
                part.Color = color
                part.Size = Vector3.new(4,4,2)

                part.Position =
                    center
                    + Vector3.new(
                        x,
                        y,
                        rainbow * 5
                    )

                part.Parent = workspace
            end
        end
    end
end)

