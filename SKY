local function water()

    if effectsOff then return end

    destroyEffect("SKY_Water")

    local root =
        player.Character
        and player.Character:FindFirstChild("HumanoidRootPart")

    if not root then return end

    local f = Instance.new("Folder")
    f.Name = "SKY_Water"
    f.Parent = workspace

    local w = Instance.new("Part")

    w.Name = "Ocean"
    w.Size = Vector3.new(1500,1,1500)

    w.Position =
        root.Position - Vector3.new(0,5,0)

    w.Anchored = true
    w.CanCollide = false
    w.CanTouch = false
    w.CanQuery = false

    w.Material = Enum.Material.Glass
    w.Color = Color3.fromRGB(25,145,210)
    w.Transparency = .3

    w.Parent = f

    local c = RunService.Heartbeat:Connect(function()

        if effectsOff or not f.Parent then return end

        local wy = w.Position.Y

        for _,p in ipairs(
            workspace:GetPartBoundsInBox(
                CFrame.new(w.Position),
                Vector3.new(300,25,300)
            )
        ) do

            if p:IsA("BasePart")
            and not p.Anchored
            and not p:IsDescendantOf(f)
            and not (
                player.Character
                and p:IsDescendantOf(player.Character)
            ) then

                local depth = wy-p.Position.Y

                if depth > -2 and depth < 8 then

                    local a =
                        p:FindFirstChild(
                            "SKY_FloatAttachment"
                        )

                    if not a then

                        a = Instance.new("Attachment")
                        a.Name = "SKY_FloatAttachment"
                        a.Parent = p

                    end

                    local force =
                        p:FindFirstChild("SKY_FloatForce")

                    if not force then

                        force = Instance.new("VectorForce")
                        force.Name = "SKY_FloatForce"

                        force.Attachment0 = a
                        force.RelativeTo =
                            Enum.ActuatorRelativeTo.World

                        force.ApplyAtCenterOfMass = true
                        force.Parent = p
                    end

                    force.Force =
                        Vector3.new(
                            0,
                            p.AssemblyMass
                            * workspace.Gravity
                            * 1.1,
                            0
                        )
                end
            end
        end
    end)

    table.insert(connections,c)
end

