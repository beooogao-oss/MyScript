local fireflyFolder
local fireflyRunning = false

local function removeFireflies()

	fireflyRunning = false

	if fireflyFolder then
		fireflyFolder:Destroy()
		fireflyFolder = nil
	end
end

local function createFireflies()

	removeFireflies()

	fireflyRunning = true

	fireflyFolder = Instance.new("Folder")
	fireflyFolder.Name = "SKY_Fireflies"
	fireflyFolder.Parent = workspace

	local flies = {}

	for i = 1,45 do

		local p = Instance.new("Part")

		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.new(1.5,1.5,1.5)
		p.Material = Enum.Material.Neon
		p.Color = Color3.fromRGB(255,240,80)

		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false

		p.Parent = fireflyFolder

		local light = Instance.new("PointLight")
		light.Brightness = 0.7
		light.Range = 8
		light.Color = Color3.fromRGB(255,230,80)
		light.Parent = p

		table.insert(flies,{
			part=p,
			angle=math.random()*math.pi*2,
			radius=math.random(15,90),
			height=math.random(-30,45),
			speed=math.random(3,8)/100
		})
	end

	task.spawn(function()

		while fireflyRunning
		and fireflyFolder
		and fireflyFolder.Parent do

			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")

			if root then

				for _,data in ipairs(flies) do

					if data.part and data.part.Parent then

						data.angle += data.speed

						data.part.Position =
							root.Position
							+ Vector3.new(
								math.cos(data.angle)
								* data.radius,

								data.height
								+ math.sin(os.clock()*2)
								* 4,

								math.sin(data.angle)
								* data.radius
							)
					end
				end
			end

			task.wait(0.05)
		end
	end)

end

button("✨ Bật đom đóm",createFireflies)
button("❌ Tắt đom đóm",removeFireflies)

