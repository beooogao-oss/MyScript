local Heart

local function StopHeart()
	if Heart then
		Heart:Destroy()
		Heart=nil
	end
end

local function StartHeart()

	StopHeart()

	local char=Player.Character
	local root=char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	Heart=Instance.new("Folder")
	Heart.Parent=Folder

	local center=
		root.Position+
		root.CFrame.LookVector*120+
		Vector3.new(0,60,0)

	for i=0,180 do

		local t=math.pi*2*i/180

		local x=16*math.sin(t)^3

		local y=
			13*math.cos(t)
			-5*math.cos(2*t)
			-2*math.cos(3*t)
			-math.cos(4*t)

		local p=Instance.new("Part")
		p.Shape=Enum.PartType.Ball
		p.Size=Vector3.new(4,4,4)
		p.Material=Enum.Material.Neon
		p.Color=Color3.fromRGB(255,60,190)
		p.Anchored=true
		p.CanCollide=false
		p.CanTouch=false
		p.CanQuery=false

		p.Position=
			center+
			root.CFrame.RightVector*(x*2.5)+
			Vector3.new(0,y*2.5,0)

		p.Parent=Heart
	end

	-- ✨ HẠT BAO QUANH
	for i=1,350 do

		local a=math.random()*math.pi*2
		local r=math.random(55,150)

		local p=Instance.new("Part")
		p.Shape=Enum.PartType.Ball
		p.Size=Vector3.new(
			math.random(1,4),
			math.random(1,4),
			math.random(1,4)
		)
		p.Material=Enum.Material.Neon
		p.Color=GalaxyColors[math.random(1,#GalaxyColors)]
		p.Anchored=true
		p.CanCollide=false
		p.CanTouch=false
		p.CanQuery=false

		p.Position=
			center+Vector3.new(
				math.cos(a)*r,
				math.random(-70,90),
				math.sin(a)*r
			)

		p.Parent=Heart
	end
end

Button("❤️ BẬT TRÁI TIM",StartHeart)
Button("❌ TẮT TRÁI TIM",StopHeart)

