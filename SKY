-- THIÊN THẠCH
-- =========================

local meteor
local meteorRunning = false

local function removeMeteor()

    meteorRunning = false

    if meteor then
        meteor:Destroy()
        meteor = nil
    end

end

local function createMeteor()

    removeMeteor()

    local char = player.Character
    local root =
        char and char:FindFirstChild("HumanoidRootPart")

    if not root then return end

    meteorRunning = true

    -- CÁCH 1000 STUDS
    local startPos =
        root.Position
        + root.CFrame.LookVector * 1000
        + Vector3.new(0,500,0)

    local endPos =
        root.Position
        + root.CFrame.LookVector * 1000

    meteor =
        Instance.new("Part")

    meteor.Name =
        "RuHub_Meteor"

    meteor.Shape =
        Enum.PartType.Ball

    -- 500 STUDS
    meteor.Size =
        Vector3.new(500,500,500)

    meteor.Material =
        Enum.Material.Neon

    meteor.Color =
        Color3.fromRGB(255,90,15)

    meteor.Anchored = true
    meteor.CanCollide = false
    meteor.CanTouch = false
    meteor.CanQuery = false

    meteor.Position =
        startPos

    meteor.Parent =
        workspace

    local fire =
        Instance.new("Fire")

    fire.Size = 250
    fire.Heat = 30
    fire.Parent = meteor

    task.spawn(function()

        local duration = 6
        local startTime = tick()

        while meteor
            and meteor.Parent
            and meteorRunning do

            local alpha =
                math.clamp(
                    (tick()-startTime)/duration,
                    0,
                    1
                )

            meteor.Position =
                startPos:Lerp(
                    endPos,
                    alpha
                )

            if alpha >= 1 then

                meteorRunning = false

                local explosion =
                    Instance.new("Explosion")

                explosion.Position =
                    meteor.Position

                explosion.BlastRadius = 100
                explosion.BlastPressure = 0

                explosion.Parent =
                    workspace

                meteor:Destroy()
                meteor = nil

                break
            end

            RunService.Heartbeat:Wait()

        end
    end)
end

makeButton(
