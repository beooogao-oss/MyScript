-- 🌊 NƯỚC + ĐỒ VẬT NỔI + BƠI
-- =========================================================

local waterFolder
local waterPart
local waterEnabled = false

local floatObjects = {}
local waterConnection

local function clearFloatForce(part)

    local force =
        part:FindFirstChild("SKY_FloatForce")

    if force then
        force:Destroy()
    end

    local attachment =
        part:FindFirstChild("SKY_FloatAttachment")

    if attachment then
        attachment:Destroy()
    end
end

local function removeWater()

    waterEnabled = false

    if waterConnection then
        waterConnection:Disconnect()
        waterConnection = nil
    end

    for part in pairs(floatObjects) do

        if part and part.Parent then
            clearFloatForce(part)
        end
    end

    floatObjects = {}

    if waterFolder then
        waterFolder:Destroy()
        waterFolder = nil
    end

    waterPart = nil
end

local function createWater()

    removeWater()

    local char = player.Character
    local root =
        char
        and char:FindFirstChild("HumanoidRootPart")

    if not root then
        return
    end

    waterEnabled = true

    waterFolder = Instance.new("Folder")
    waterFolder.Name = "SKY_Water"
    waterFolder.Parent = workspace

    -- 🌊 MẶT NƯỚC
    waterPart = Instance.new("Part")

    waterPart.Name = "SKY_Ocean"

    waterPart.Size =
        Vector3.new(
            2000,
            1,
            2000
        )

    waterPart.Position =
        root.Position
        +Vector3.new(0,-5,0)

    waterPart.Anchored = true
    waterPart.CanCollide = false
    waterPart.CanTouch = false
    waterPart.CanQuery = false

    waterPart.Material =
        Enum.Material.Glass

    waterPart.Color =
        Color3.fromRGB(
            25,
            145,
            210
        )

    waterPart.Transparency = 0.28
    waterPart.Reflectance = 0.25

    waterPart.Parent = waterFolder

    -- 🌊 SÓNG NHẸ
    local waves = {}

    for i = 1,25 do

        local wave = Instance.new("Part")

        wave.Anchored = true
        wave.CanCollide = false
        wave.CanTouch = false
        wave.CanQuery = false

        wave.Material = Enum.Material.Neon
        wave.Color = Color3.fromRGB(100,210,255)

        wave.Transparency = 0.65

        wave.Size =
            Vector3.new(
                math.random(15,35),
                0.15,
                2
            )

        wave.Position =
            root.Position
            +Vector3.new(
                math.random(-100,100),
                -4.45,
                math.random(-100,100)
            )

        wave.Parent = waterFolder

        table.insert(waves,wave)
    end

    -- 🌊 XỬ LÝ NƯỚC
    waterConnection =
        RunService.Heartbeat:Connect(function()

            if not waterEnabled
                or not waterPart then
                return
            end

            local waterY =
                waterPart.Position.Y

            -- 💧 SÓNG
            local now = os.clock()

            for i,wave in ipairs(waves) do

                if wave.Parent then

                    local x =
                        wave.Position.X

                    local z =
                        wave.Position.Z

                    wave.Position =
                        Vector3.new(
                            x,
                            waterY+0.55
                                +math.sin(
                                    now*1.5+i
                                )*0.15,
                            z
                        )

                    wave.Orientation =
                        Vector3.new(
                            0,
                            now*10+i*20,
                            0
                        )
                end
            end

            -- 📦 CHỈ XỬ LÝ ĐỒ VẬT GẦN MẶT NƯỚC
            for _,part in ipairs(
                workspace:GetPartBoundsInBox(
                    CFrame.new(
                        waterPart.Position
                    ),
                    Vector3.new(
                        500,
                        25,
                        500
                    )
                )
            ) do

                if part:IsA("BasePart")
                    and not part.Anchored
                    and not part:IsDescendantOf(waterFolder)
                    and not (
                        player.Character
                        and part:IsDescendantOf(
                            player.Character
                        )
                    ) then

                    local depth =
                        waterY
                        - part.Position.Y

                    if depth > -2
                        and depth < 7 then

                        local force =
                            part:FindFirstChild(
                                "SKY_FloatForce"
                            )

                        if not force then

                            local attachment =
                                Instance.new(
                                    "Attachment"
                                )

                            attachment.Name =
                                "SKY_FloatAttachment"

                            attachment.Parent =
                                part

                            force =
                                Instance.new(
                                    "VectorForce"
                                )

                            force.Name =
                                "SKY_FloatForce"

                            force.Attachment0 =
                                attachment

                            force.RelativeTo =
                                Enum.ActuatorRelativeTo.World

                            force.ApplyAtCenterOfMass =
                                true

                            force.Parent =
                                part

                            floatObjects[part] =
                                true
                        end

                        -- ⬆️ LỰC NỔI NHẸ
                        local mass =
                            part.AssemblyMass

                        local buoyancy =
                            math.clamp(
                                0.8
                                +depth*0.12,
                                0.65,
                                1.15
                            )

                        force.Force =
                            Vector3.new(
                                0,
                                mass
                                *workspace.Gravity
                                *buoyancy,
                                0
                            )

                    elseif depth <= -2 then

                        clearFloatForce(part)
                        floatObjects[part] = nil
                    end
                end
            end
        end)
end

