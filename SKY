-- 4000 × 4000
-- MẶT NƯỚC THẤP HƠN CHÂN 2 STUDS
-- ĐÁY -302 STUDS
--==================================================

local waterActive = false
local waterRegion

local WATER_SIZE_X = 4000
local WATER_SIZE_Z = 4000

local WATER_TOP_OFFSET = -2
local WATER_BOTTOM_OFFSET = -302

local WATER_HEIGHT =
	WATER_TOP_OFFSET - WATER_BOTTOM_OFFSET

local function removeWater()

	waterActive = false

	if waterRegion then

		Terrain:FillRegion(
			waterRegion,
			4,
			Enum.Material.Air
		)

		waterRegion = nil
	end
end

local function createWater()

	removeWater()

	local char = player.Character
	local root =
		char and char:FindFirstChild("HumanoidRootPart")

	if not root then
		return
	end

	waterActive = true

	local waterTopY =
		root.Position.Y + WATER_TOP_OFFSET

	local waterBottomY =
		root.Position.Y + WATER_BOTTOM_OFFSET

	local waterCenterY =
		(waterTopY + waterBottomY) / 2

	local center = Vector3.new(
		root.Position.X,
		waterCenterY,
		root.Position.Z
	)

	waterRegion = Region3.new(

		center - Vector3.new(
			WATER_SIZE_X / 2,
			WATER_HEIGHT / 2,
			WATER_SIZE_Z / 2
		),

		center + Vector3.new(
			WATER_SIZE_X / 2,
			WATER_HEIGHT / 2,
			WATER_SIZE_Z / 2
		)

	):ExpandToGrid(4)

	Terrain:FillRegion(
		waterRegion,
		4,
		Enum.Material.Water
	)

	-- NƯỚC XANH GIỐNG ẢNH

	Terrain.WaterColor =
		Color3.fromRGB(25, 165, 225)

	Terrain.WaterTransparency = 0.08
	Terrain.WaterReflectance = 0.55

	Terrain.WaterWaveSize = 0.8
	Terrain.WaterWaveSpeed = 12
end

button(
	"🌊 Biển",
	createWater
)

button(
	"❌ Tắt biển",
	removeWater
)

