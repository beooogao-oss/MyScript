-- CẦU VỒNG ĐỨNG YÊN
local rainbowFolder

local function removeRainbow()
    if rainbowFolder then
        rainbowFolder:Destroy()
        rainbowFolder = nil
    end
end

local function createRainbow()
    removeRainbow()

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    rainbowFolder = Instance.new("Folder")
    rainbowFolder.Name = "RuHub_Rainbow"
    rainbowFolder.Parent = workspace

    local center =
        root.Position
        + root.CFrame.LookVector * 180
        + Vector3.new(0,80,0)

    local colors = {
        Color3.fromRGB(255,0,0),
        Color3.fromRGB(255,140,0),
        Color3.fromRGB(255,255,0),
        Color3.fromRGB(0,255,0),
        Color3.fromRGB(0,170,255),
        Color3.fromRGB(0,0,255),
        Color3.fromRGB(180,0,255)
    }

    for colorIndex, color in ipairs(colors) do
        local radius = 75 - (colorIndex - 1) * 3

        for i = 0, 40 do
            local angle = math.pi * (i / 40)

            local part = Instance.new("Part")
            part.Anchored = true
            part.CanCollide = false
            part.CanTouch = false
            part.CanQuery = false
            part.Material = Enum.Material.Neon
            part.Color = color
            part.Size = Vector3.new(3,3,2)

            part.Position =
                center + Vector3.new(
                    math.cos(angle) * radius,
                    math.sin(angle) * radius,
                    0
                )

            part.Parent = rainbowFolder
        end
    end
end

makeButton("🌈 Cầu vồng", 247, function()
    createRainbow()
end)

makeButton("❌ Tắt cầu vồng", 295, function()
    removeRainbow()
end)

-- THIÊN THẠCH
local meteor
local meteorRunning = false

local function removeMeteor()
    meteorRunning = false

    if meteor then
        meteor:Destroy()
        meteor = nil
    end
end

local function createMeteor()
    removeMeteor()

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    meteorRunning = true

    -- CÁCH NGƯỜI CHƠI 1000 STUDS
    local startPos =
        root.Position
        + root.CFrame.LookVector * 1000
        + Vector3.new(0, 500, 0)

    local endPos =
        root.Position
        + root.CFrame.LookVector * 1000
        + Vector3.new(0, 0, 0)

    meteor = Instance.new("Part")
    meteor.Name = "RuHub_Meteor"
    meteor.Shape = Enum.PartType.Ball

    -- KÍCH THƯỚC 500 STUDS
    meteor.Size = Vector3.new(500,500,500)

    meteor.Material = Enum.Material.Neon
    meteor.Color = Color3.fromRGB(255,90,15)

    meteor.Anchored = true
    meteor.CanCollide = false
    meteor.CanTouch = false
    meteor.CanQuery = false

    meteor.Position = startPos
    meteor.Parent = workspace

    local fire = Instance.new("Fire")
    fire.Size = 250
    fire.Heat = 30
    fire.Parent = meteor

    task.spawn(function()
        local duration = 6
        local startTime = tick()

        while meteor and meteor.Parent and meteorRunning do

            local alpha = math.clamp(
                (tick() - startTime) / duration,
                0,
                1
            )

            meteor.Position =
                startPos:Lerp(endPos, alpha)

            if alpha >= 1 then

                meteorRunning = false

                local explosion = Instance.new("Explosion")
                explosion.Position = meteor.Position
                explosion.BlastRadius = 100
                explosion.BlastPressure = 0
                explosion.DestroyJointRadiusPercent = 0
                explosion.Parent = workspace

                meteor:Destroy()
                meteor = nil

                break
            end

            RunService.Heartbeat:Wait()
        end
    end)
end

makeButton("☄️ Thiên thạch 500m", 343, function()
