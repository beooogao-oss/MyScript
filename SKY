-- BƠI
--==================================================

RunService.Heartbeat:Connect(function()

	if not waterActive then
		return
	end

	if not waterPart then
		return
	end

	local character = player.Character
	if not character then
		return
	end

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if not root or not humanoid then
		return
	end

	local topY =
		waterPart.Position.Y
		+ waterPart.Size.Y / 2

	local bottomY =
		waterPart.Position.Y
		- waterPart.Size.Y / 2

	local xMin =
		waterPart.Position.X
		- waterPart.Size.X / 2

	local xMax =
		waterPart.Position.X
		+ waterPart.Size.X / 2

	local zMin =
		waterPart.Position.Z
		- waterPart.Size.Z / 2

	local zMax =
		waterPart.Position.Z
		+ waterPart.Size.Z / 2

	local p = root.Position

	if p.X >= xMin
	and p.X <= xMax
	and p.Z >= zMin
	and p.Z <= zMax
	and p.Y <= topY
	and p.Y >= bottomY then

		humanoid:ChangeState(
			Enum.HumanoidStateType.Swimming
		)
	end
end)

--==================================================
-- ĐOM ĐÓM
--==================================================

local fireflyFolder
local fireflyRunning = false

local function removeFireflies()

	fireflyRunning = false

	if fireflyFolder then
		fireflyFolder:Destroy()
		fireflyFolder = nil
	end
end

local function createFireflies()

	removeFireflies()

	fireflyRunning = true

	fireflyFolder =
		Instance.new("Folder")

	fireflyFolder.Name =
		"SKY_Fireflies"

	fireflyFolder.Parent =
		worldFolder

	local flies = {}

	for i = 1, 40 do

		local part =
			Instance.new("Part")

		part.Shape =
			Enum.PartType.Ball

		part.Size =
			Vector3.new(
				1.5,
				1.5,
				1.5
			)

		part.Material =
			Enum.Material.Neon

		part.Color =
			Color3.fromRGB(
				255,
				240,
				80
			)

		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false

		part.Parent =
			fireflyFolder

		local light =
			Instance.new("PointLight")

		light.Brightness = 0.7
		light.Range = 8
		light.Color =
			Color3.fromRGB(
				255,
				230,
				80
			)

		light.Parent = part

		table.insert(
			flies,
			{
				part = part,
				angle =
					math.random()
					* math.pi * 2,
				radius =
					math.random(15, 80),
				height =
					math.random(-20, 40),
				speed =
					math.random(3, 8)
					/ 100
			}
		)
	end

	task.spawn(function()

		while fireflyRunning
		and fireflyFolder
		and fireflyFolder.Parent do

			local character =
				player.Character

			local root =
				character
				and character:FindFirstChild(
					"HumanoidRootPart"
				)

			if root then

				for _, data in ipairs(flies) do

					if data.part
					and data.part.Parent then

						data.angle +=
							data.speed

						data.part.Position =
							root.Position
							+ Vector3.new(

								math.cos(
									data.angle
								)
								* data.radius,

								data.height
								+ math.sin(
									os.clock() * 2
								) * 4,

								math.sin(
									data.angle
								)
								* data.radius
							)
					end
				end
			end

			task.wait(0.05)
		end
	end)
end

button(
	"✨ BẬT ĐOM ĐÓM",
	createFireflies
)

button(
	"❌ TẮT ĐOM ĐÓM",
	removeFireflies
)

