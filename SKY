local function removeGalaxy()

	if galaxyFolder then
		galaxyFolder:Destroy()
		galaxyFolder = nil
	end
end

local function createGalaxy()

	removeGalaxy()

	local character = player.Character
	if not character then
		return
	end

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return
	end

	galaxyFolder =
		Instance.new("Folder")

	galaxyFolder.Name =
		"SKY_Galaxy"

	galaxyFolder.Parent =
		worldFolder

	local center =
		root.Position
		+ Vector3.new(
			0,
			250,
			0
		)

	-- SAO
	for i = 1, 450 do

		local part =
			Instance.new("Part")

		part.Shape =
			Enum.PartType.Ball

		part.Size =
			Vector3.new(
				math.random(1, 3),
				math.random(1, 3),
				math.random(1, 3)
			)

		part.Material =
			Enum.Material.Neon

		part.Color =
			Color3.fromRGB(
				220 + math.random(0, 35),
				220 + math.random(0, 35),
				255
			)

		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false

		local offset =
			Vector3.new(
				math.random(-900, 900),
				math.random(-450, 450),
				math.random(-900, 900)
			)

		part.Position =
			center + offset

		part.Parent =
			galaxyFolder
	end

	-- 5 CÁNH THIÊN HÀ
	for arm = 1, 5 do

		local armAngle =
			(arm / 5)
			* math.pi * 2

		for i = 1, 230 do

			local distance =
				20
				+ (i / 230) * 850

			local angle =
				armAngle
				+ distance / 180

			local offset =
				Vector3.new(

					math.cos(angle)
					* distance,

					math.sin(i * 0.4)
					* 35,

					math.sin(angle)
					* distance
				)

			local part =
				Instance.new("Part")

			part.Shape =
				Enum.PartType.Ball

			part.Size =
				Vector3.new(
					2,
					2,
					2
				)

			part.Material =
				Enum.Material.Neon

			part.Color =
				Color3.fromRGB(
					130,
					170,
					255
				)

			part.Anchored = true
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = false

			part.Position =
				center + offset

			part.Parent =
				galaxyFolder
		end
	end

	-- MẶT TRỜI
	local sun =
		Instance.new("Part")

	sun.Shape =
		Enum.PartType.Ball

	sun.Size =
		Vector3.new(
			80,
			80,
			80
		)

	sun.Material =
		Enum.Material.Neon

	sun.Color =
		Color3.fromRGB(
			255,
			180,
			60
		)

	sun.Anchored = true
	sun.CanCollide = false
	sun.CanTouch = false
	sun.CanQuery = false

	sun.Position =
		center

	sun.Parent =
		galaxyFolder

	local light =
		Instance.new("PointLight")

	light.Brightness = 8
	light.Range = 500

	light.Color =
		Color3.fromRGB(
			255,
			180,
			100
		)

	light.Parent = sun
end

makeButton(
