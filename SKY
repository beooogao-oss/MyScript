-- CẦU VỒNG BÊN TRÁI
-- =========================

local rainbowFolder

local function removeRainbow()

    if rainbowFolder then
        rainbowFolder:Destroy()
        rainbowFolder = nil
    end

end

local function createRainbow()

    removeRainbow()

    local char = player.Character
    local root =
        char and char:FindFirstChild("HumanoidRootPart")

    if not root then return end

    rainbowFolder =
        Instance.new("Folder")

    rainbowFolder.Name =
        "RuHub_Rainbow"

    rainbowFolder.Parent =
        workspace

    -- BÊN TRÁI NGƯỜI CHƠI
    local center =
        root.Position
        - root.CFrame.RightVector * 180
        + Vector3.new(0,80,0)

    local colors = {

        Color3.fromRGB(255,0,0),
        Color3.fromRGB(255,140,0),
        Color3.fromRGB(255,255,0),
        Color3.fromRGB(0,255,0),
        Color3.fromRGB(0,170,255),
        Color3.fromRGB(0,0,255),
        Color3.fromRGB(180,0,255)

    }

    for colorIndex,color in ipairs(colors) do

        local radius =
            75 - (colorIndex-1)*3

        for i=0,40 do

            local angle =
                math.pi*(i/40)

            local part =
                Instance.new("Part")

            part.Anchored = true
            part.CanCollide = false
            part.CanTouch = false
            part.CanQuery = false

            part.Material =
                Enum.Material.Neon

            part.Color = color

            part.Size =
                Vector3.new(3,3,2)

            part.Position =
                center +
                Vector3.new(
                    math.cos(angle)*radius,
                    math.sin(angle)*radius,
                    0
                )

            part.Parent =
                rainbowFolder

        end
    end
end

makeButton(
