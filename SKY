local effectsOff = false
local connections = {}

local function destroyEffect(name)

    local x = workspace:FindFirstChild(name)

    if x then
        x:Destroy()
    end
end

local function disconnectAll()

    for _,connection in ipairs(connections) do

        if connection then
            connection:Disconnect()
        end
    end

    table.clear(connections)
end

local function cleanupForces()

    local character = player.Character
    local root =
        character and character:FindFirstChild("HumanoidRootPart")

    if root then

        for _,name in ipairs({
            "SKY_SwimForce",
            "SKY_SwimAttachment",
            "SKY_WindForce",
            "SKY_WindAttachment"
        }) do

            local x = root:FindFirstChild(name)

            if x then
                x:Destroy()
            end
        end
    end

    for _,v in ipairs(workspace:GetDescendants()) do

        if v:IsA("VectorForce")
        and (
            v.Name == "SKY_FloatForce"
            or v.Name == "SKY_LightWind"
        ) then

            v:Destroy()

        elseif v:IsA("Attachment")
        and (
            v.Name == "SKY_FloatAttachment"
            or v.Name == "SKY_WindAttachment"
        ) then

            v:Destroy()
        end
    end
end

local function stopAllEffects()

    effectsOff = true

    disconnectAll()

    for _,name in ipairs({
        "SKY_Rainbow",
        "SKY_Galaxy",
        "SKY_Heart",
        "SKY_Fireflies",
        "SKY_Water",
        "SKY_Rice"
    }) do

        destroyEffect(name)
    end

    cleanupForces()

    print("⚡ SKY: TẤT CẢ HIỆU ỨNG ĐÃ TẮT")
end

local function enableAll()

    effectsOff = false

    print("✨ SKY: HIỆU ỨNG ĐÃ BẬT LẠI")
end

