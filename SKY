local catFolder
local catRunning = false

local function removeCat()
    catRunning = false

    if catFolder then
        catFolder:Destroy()
        catFolder = nil
    end
end

local function createCat()
    removeCat()

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    catRunning = true

    catFolder = Instance.new("Folder")
    catFolder.Name = "GiantCat"
    catFolder.Parent = world

    local base =
        root.Position
        + root.CFrame.RightVector*80
        + Vector3.new(0,35,0)

    local function part(size,offset,color,shape)
        local p=Instance.new("Part")

        p.Size=size
        p.Position=base+offset
        p.Anchored=true
        p.CanCollide=false
        p.CanTouch=false
        p.CanQuery=false
        p.Material=Enum.Material.SmoothPlastic
        p.Color=color

        if shape then
            p.Shape=shape
        end

        p.Parent=catFolder

        return p
    end

    local bodyColor=Color3.fromRGB(210,210,220)
    local dark=Color3.fromRGB(70,70,80)
    local pink=Color3.fromRGB(255,130,170)

    -- 😺 THÂN
    part(
        Vector3.new(45,55,65),
        Vector3.new(0,0,0),
        bodyColor,
        Enum.PartType.Ball
    )

    -- ĐẦU
    part(
        Vector3.new(60,55,55),
        Vector3.new(0,38,-15),
        bodyColor,
        Enum.PartType.Ball
    )

    -- TAI
    part(
        Vector3.new(22,30,22),
        Vector3.new(-22,70,-15),
        bodyColor,
        Enum.PartType.Wedge
    )

    part(
        Vector3.new(22,30,22),
        Vector3.new(22,70,-15),
        bodyColor,
        Enum.PartType.Wedge
    )

    -- MẮT
    local eye1=part(
        Vector3.new(8,10,5),
        Vector3.new(-12,43,-40),
        Color3.fromRGB(0,255,180),
        Enum.PartType.Ball
    )

    local eye2=part(
        Vector3.new(8,10,5),
        Vector3.new(12,43,-40),
        Color3.fromRGB(0,255,180),
        Enum.PartType.Ball
    )

    for _,eye in ipairs({eye1,eye2}) do
        local l=Instance.new("PointLight")
        l.Color=Color3.fromRGB(0,255,180)
        l.Brightness=3
        l.Range=18
        l.Parent=eye
    end

    -- MŨI
    part(
        Vector3.new(7,6,5),
        Vector3.new(0,30,-43),
        pink,
        Enum.PartType.Ball
    )

    -- CHÂN
    part(
        Vector3.new(18,35,22),
        Vector3.new(-17,-38,-20),
        bodyColor,
        Enum.PartType.Ball
    )

    part(
        Vector3.new(18,35,22),
        Vector3.new(17,-38,-20),
        bodyColor,
        Enum.PartType.Ball
    )

    part(
        Vector3.new(18,35,22),
        Vector3.new(-17,-38,20),
        bodyColor,
        Enum.PartType.Ball
    )

    part(
        Vector3.new(18,35,22),
        Vector3.new(17,-38,20),
        bodyColor,
        Enum.PartType.Ball
    )

    -- ĐUÔI
    local tailParts={}

    for i=1,8 do
        local angle=i/8*math.pi

        local x=55+math.sin(angle)*18
        local y=-5+math.cos(angle)*30

        local tail=part(
            Vector3.new(16,16,16),
            Vector3.new(x,y,25),
            bodyColor,
            Enum.PartType.Ball
        )

        table.insert(tailParts,tail)
    end

    -- ✨ HẠT PHÁT SÁNG
    local colors={
        Color3.fromRGB(0,255,255),
        Color3.fromRGB(80,150,255),
        Color3.fromRGB(190,70,255),
        Color3.fromRGB(255,80,220),
        Color3.fromRGB(255,255,255)
    }

    local particles={}

    for i=1,180 do
        local p=Instance.new("Part")
        p.Shape=Enum.PartType.Ball

        local s=math.random(1,4)
        p.Size=Vector3.new(s,s,s)

        p.Material=Enum.Material.Neon
        p.Color=colors[math.random(1,#colors)]

        p.Anchored=true
        p.CanCollide=false
        p.CanTouch=false
        p.CanQuery=false

        local angle=math.random()*math.pi*2
        local radius=math.random(45,100)
        local height=math.random(-60,100)

        p.Position=
            base+
            Vector3.new(
                math.cos(angle)*radius,
                height,
                math.sin(angle)*radius
            )

        p.Parent=catFolder

        table.insert(particles,{
            part=p,
            angle=angle,
            radius=radius,
            height=height,
            speed=math.random(5,15)/100
        })
    end

    -- 🌟 HÀO QUANG
    local glow=Instance.new("Part")
    glow.Shape=Enum.PartType.Ball
    glow.Size=Vector3.new(110,110,110)
    glow.Position=base+Vector3.new(0,20,0)
    glow.Material=Enum.Material.Neon
    glow.Color=Color3.fromRGB(120,70,255)
    glow.Transparency=0.85
    glow.Anchored=true
    glow.CanCollide=false
    glow.CanTouch=false
    glow.CanQuery=false
    glow.Parent=catFolder

    -- HẠT DI CHUYỂN
    task.spawn(function()
        while catRunning
        and catFolder
        and catFolder.Parent do

            for _,data in ipairs(particles) do
                if data.part and data.part.Parent then

                    data.angle += data.speed

                    data.part.Position =
                        base+
                        Vector3.new(
                            math.cos(data.angle)*data.radius,
                            data.height+
                                math.sin(data.angle*2)*8,
                            math.sin(data.angle)*data.radius
                        )
                end
            end

            task.wait(0.03)
        end
    end)
end

