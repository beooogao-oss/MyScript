local swimConnection
local swimForce
local swimAttachment
local swimming = false

local function startSwim()

    if swimming then return end

    swimming = true

    swimConnection =
        RunService.Heartbeat:Connect(function()

            if not waterEnabled
                or not waterPart then
                return
            end

            local char = player.Character

            local humanoid =
                char
                and char:FindFirstChildOfClass(
                    "Humanoid"
                )

            local root =
                char
                and char:FindFirstChild(
                    "HumanoidRootPart"
                )

            if not humanoid or not root then
                return
            end

            local waterY =
                waterPart.Position.Y

            local y =
                root.Position.Y

            if y < waterY+3
                and y > waterY-12 then

                humanoid:ChangeState(
                    Enum.HumanoidStateType.Swimming
                )

                if not swimAttachment then

                    swimAttachment =
                        Instance.new("Attachment")

                    swimAttachment.Name =
                        "SKY_SwimAttachment"

                    swimAttachment.Parent = root
                end

                if not swimForce then

                    swimForce =
                        Instance.new("VectorForce")

                    swimForce.Name =
                        "SKY_SwimForce"

                    swimForce.Attachment0 =
                        swimAttachment

                    swimForce.RelativeTo =
                        Enum.ActuatorRelativeTo.World

                    swimForce.ApplyAtCenterOfMass =
                        true

                    swimForce.Parent = root
                end

                local mass =
                    root.AssemblyMass

                local depth =
                    waterY-root.Position.Y

                local lift =
                    math.clamp(
                        1.05+depth*0.08,
                        1.0,
                        1.35
                    )

                swimForce.Force =
                    Vector3.new(
                        0,
                        mass
                        *workspace.Gravity
                        *lift,
                        0
                    )

            else

                if swimForce then
                    swimForce.Force =
                        Vector3.zero
                end
            end
        end)
end

local function stopSwim()

    swimming = false

    if swimConnection then
        swimConnection:Disconnect()
        swimConnection = nil
    end

    if swimForce then
        swimForce:Destroy()
        swimForce = nil
    end

    if swimAttachment then
        swimAttachment:Destroy()
        swimAttachment = nil
    end
end

makeButton(
    "🏊 Bật bơi + nổi",
    startSwim
)

makeButton(
    "🚶 Tắt bơi",
    stopSwim
)

