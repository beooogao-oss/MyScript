--==================================================
-- NƯỚC
-- 4000 x 4000
-- MẶT NƯỚC +50M
-- ĐỘ SÂU 100M
--==================================================

local waterActive = false
local waterRegion = nil

local WATER_SIZE = 4000
local WATER_HEIGHT = 50
local WATER_DEPTH = 100

local function removeWater()

	waterActive = false

	if waterRegion then

		Terrain:FillRegion(
			waterRegion,
			4,
			Enum.Material.Air
		)

		waterRegion = nil
	end
end

local function createWater()

	removeWater()

	local character = player.Character
	if not character then
		return
	end

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return
	end

	waterActive = true

	local playerPosition = root.Position

	-- MẶT NƯỚC CAO HƠN NGƯỜI CHƠI 50M
	local waterTopY =
		playerPosition.Y + WATER_HEIGHT

	-- ĐÁY NƯỚC SÂU 100M
	local waterBottomY =
		waterTopY - WATER_DEPTH

	local half =
		WATER_SIZE / 2

	local centerY =
		(waterTopY + waterBottomY) / 2

	local center =
		Vector3.new(
			playerPosition.X,
			centerY,
			playerPosition.Z
		)

	waterRegion = Region3.new(

		center - Vector3.new(
			half,
			WATER_DEPTH / 2,
			half
		),

		center + Vector3.new(
			half,
			WATER_DEPTH / 2,
			half
		)

	):ExpandToGrid(4)

	Terrain:FillRegion(
		waterRegion,
		4,
		Enum.Material.Water
	)

	Terrain.WaterColor =
		Color3.fromRGB(
			15,
			125,
			180
		)

	Terrain.WaterTransparency = 0.12
	Terrain.WaterReflectance = 0.35
	Terrain.WaterWaveSize = 0.15
	Terrain.WaterWaveSpeed = 5
end

makeButton(
	"🌊 BẬT NƯỚC 4000×4000",
	createWater
)

makeButton(
	"❌ TẮT NƯỚC",
	removeWater
)

