local function heart()

    destroyEffect("SKY_Heart")
    stopConnection("Heart")

    local root =
        player.Character
        and player.Character:FindFirstChild("HumanoidRootPart")

    if not root then return end

    local folder = Instance.new("Folder")
    folder.Name = "SKY_Heart"
    folder.Parent = workspace

    local parts = {}

    for i = 1,60 do

        local p = Instance.new("Part")

        p.Shape = Enum.PartType.Ball
        p.Size = Vector3.new(2,2,2)
        p.Material = Enum.Material.Neon
        p.Color = Color3.fromRGB(255,40,100)

        p.Anchored = true
        p.CanCollide = false
        p.CanTouch = false
        p.CanQuery = false

        p.Parent = folder
        parts[i] = p
    end

    connections.Heart =
        RunService.Heartbeat:Connect(function()

        if not folder.Parent then
            stopConnection("Heart")
            return
        end

        local r =
            player.Character
            and player.Character:FindFirstChild(
                "HumanoidRootPart"
            )

        if not r then return end

        local center =
            r.Position+
            r.CFrame.LookVector*100+
            Vector3.new(0,50,0)

        local t = os.clock()

        for i,p in ipairs(parts) do

            local a =
                ((i/#parts)+t*.06)
                *math.pi*2

            local x = 16*math.sin(a)^3

            local y =
                13*math.cos(a)
                -5*math.cos(2*a)
                -2*math.cos(3*a)
                -math.cos(4*a)

            p.Position =
                center+
                r.CFrame.RightVector*(x*3)+
                Vector3.new(0,y*3,0)
        end
    end)
end

