-- =========================
-- CẦU VỒNG
-- =========================

local rainbowFolder

local function removeRainbow()

    if rainbowFolder then
        rainbowFolder:Destroy()
        rainbowFolder = nil
    end

end

local function createRainbow()

    removeRainbow()

    local char =
        player.Character

    local root =
        char and
        char:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root then return end

    rainbowFolder =
        Instance.new("Folder")

    rainbowFolder.Name =
        "RuHub_Rainbow"

    rainbowFolder.Parent =
        workspace

    -- BÊN TRÁI
    local center =
        root.Position
        - root.CFrame.RightVector * 180
        + Vector3.new(0,80,0)

    local colors = {

        Color3.fromRGB(255,0,0),
        Color3.fromRGB(255,140,0),
        Color3.fromRGB(255,255,0),
        Color3.fromRGB(0,255,0),
        Color3.fromRGB(0,170,255),
        Color3.fromRGB(0,0,255),
        Color3.fromRGB(180,0,255)

    }

    for colorIndex,color in ipairs(colors) do

        local radius =
            75 -
            (colorIndex-1)*3

        for i=0,40 do

            local angle =
                math.pi*(i/40)

            local part =
                Instance.new("Part")

            part.Anchored = true
            part.CanCollide = false
            part.CanTouch = false
            part.CanQuery = false

            part.Material =
                Enum.Material.Neon

            part.Color = color

            part.Size =
                Vector3.new(3,3,2)

            part.Position =
                center +
                Vector3.new(
                    math.cos(angle)*radius,
                    math.sin(angle)*radius,
                    0
                )

            part.Parent =
                rainbowFolder
        end
    end
end

makeButton(
    "🌈 Cầu vồng bên trái",
    createRainbow
)

makeButton(
    "❌ Tắt cầu vồng",
    removeRainbow
)

-- =========================
-- THIÊN HÀ
-- =========================

local galaxyFolder

local function removeGalaxy()

    if galaxyFolder then
        galaxyFolder:Destroy()
        galaxyFolder = nil
    end

end

local function createGalaxy()

    removeGalaxy()

    local char =
        player.Character

    local root =
        char and
        char:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root then return end

    galaxyFolder =
        Instance.new("Folder")

    galaxyFolder.Name =
        "RuHub_Galaxy"

    galaxyFolder.Parent =
        workspace

    local center =
        root.Position
        + root.CFrame.LookVector * 1000
        + Vector3.new(0,350,0)

    -- ĐƯỜNG KÍNH 1500 STUDS
    local radius = 750

    for arm=1,4 do

        for i=1,180 do

            local t =
                i/180

            local angle =
                t*math.pi*5
                + (arm-1)*math.pi/2

            local r =
                t*radius

            local x =
                math.cos(angle)*r

            local z =
                math.sin(angle)*r

            local y =
                math.sin(t*math.pi)*35

            local star =
                Instance.new("Part")

            star.Shape =
                Enum.PartType.Ball

            local size =
                math.random(2,7)

            star.Size =
                Vector3.new(
                    size,
                    size,
                    size
                )

            star.Material =
                Enum.Material.Neon

            star.Color =
                Color3.fromRGB(
                    math.random(150,255),
                    math.random(150,255),
                    255
                )

            star.Anchored = true
            star.CanCollide = false
            star.CanTouch = false
            star.CanQuery = false

            star.Position =
                center +
                Vector3.new(x,y,z)

            star.Parent =
                galaxyFolder
        end
    end

    -- LÕI
    local core =
        Instance.new("Part")

    core.Shape =
        Enum.PartType.Ball

    core.Size =
        Vector3.new(180,180,180)

    core.Material =
        Enum.Material.Neon

    core.Color =
        Color3.fromRGB(
            255,220,150
        )

    core.Transparency = 0.25

    core.Anchored = true
    core.CanCollide = false
    core.CanTouch = false
    core.CanQuery = false

    core.Position =
        center

    core.Parent =
        galaxyFolder
end

makeButton(
    "🌌 Thiên hà 1500",
    createGalaxy
)

makeButton(
    "❌ Tắt thiên hà",
    removeGalaxy
)

