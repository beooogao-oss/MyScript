local function fireflies()

    if effectsOff then return end

    destroyEffect("SKY_Fireflies")

    local f = Instance.new("Folder")
    f.Name = "SKY_Fireflies"
    f.Parent = workspace

    local data = {}

    for i=1,50 do

        local p = Instance.new("Part")

        p.Shape = Enum.PartType.Ball
        p.Size = Vector3.new(2,2,2)
        p.Material = Enum.Material.Neon
        p.Color = Color3.fromRGB(255,240,100)

        p.Anchored = true
        p.CanCollide = false
        p.CanTouch = false
        p.CanQuery = false

        p.Parent = f

        data[i] = {
            p = p,
            a = math.random()*6.28,
            r = math.random(30,150),
            h = math.random(10,80)
        }
    end

    local c = RunService.Heartbeat:Connect(function()

        if effectsOff or not f.Parent then return end

        local root =
            player.Character
            and player.Character:FindFirstChild("HumanoidRootPart")

        if not root then return end

        local t = os.clock()

        for _,d in ipairs(data) do

            d.a += .01

            d.p.Position =
                root.Position +
                Vector3.new(
                    math.cos(d.a)*d.r,
                    d.h+math.sin(t)*10,
                    math.sin(d.a)*d.r
                )
        end
    end)

    table.insert(connections,c)
end

