local waterActive = false
local waterRegion

local WATER_SIZE = 4000
local WATER_DEPTH = 200

local function removeWater()

	waterActive = false

	if waterRegion then
		Terrain:FillRegion(
			waterRegion,
			4,
			Enum.Material.Air
		)

		waterRegion = nil
	end
end

local function createWater()

	removeWater()

	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")

	if not root then return end

	waterActive = true

	local half = WATER_SIZE / 2

	local center = root.Position - Vector3.new(0,50,0)

	waterRegion = Region3.new(
		center - Vector3.new(
			half,
			WATER_DEPTH / 2,
			half
		),

		center + Vector3.new(
			half,
			WATER_DEPTH / 2,
			half
		)
	):ExpandToGrid(4)

	Terrain:FillRegion(
		waterRegion,
		4,
		Enum.Material.Water
	)

	Terrain.WaterColor =
		Color3.fromRGB(15,125,180)

	Terrain.WaterTransparency = 0.18
	Terrain.WaterReflectance = 0.35

	Terrain.WaterWaveSize = 0.25
	Terrain.WaterWaveSpeed = 7

end

button("🌊 BẬT BIỂN 4000 × 4000",createWater)
button("❌ Tắt biển",removeWater)

