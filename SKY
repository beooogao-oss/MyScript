local Rainbow

local function StopRainbow()
	if Rainbow then
		Rainbow:Destroy()
		Rainbow=nil
	end
end

local function StartRainbow()

	StopRainbow()

	local char=Player.Character
	local root=char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	Rainbow=Instance.new("Folder")
	Rainbow.Parent=Folder

	local center=
		root.Position
		-root.CFrame.RightVector*150
		+Vector3.new(0,70,0)

	local colors={
		Color3.fromRGB(255,0,0),
		Color3.fromRGB(255,140,0),
		Color3.fromRGB(255,255,0),
		Color3.fromRGB(0,255,80),
		Color3.fromRGB(0,180,255),
		Color3.fromRGB(80,80,255),
		Color3.fromRGB(210,0,255)
	}

	for n,c in ipairs(colors) do
		local r=70-(n-1)*4

		for i=0,40 do

			local a=math.pi*i/40

			local p=Instance.new("Part")
			p.Shape=Enum.PartType.Ball
			p.Size=Vector3.new(3,3,3)
			p.Material=Enum.Material.Neon
			p.Color=c
			p.Anchored=true
			p.CanCollide=false
			p.CanTouch=false
			p.CanQuery=false

			p.Position=
				center+
				Vector3.new(
					math.cos(a)*r,
					math.sin(a)*r,
					0
				)

			p.Parent=Rainbow
		end
	end
end

Button("🌈 Bật cầu vồng",StartRainbow)
Button("❌ Tắt cầu vồng",StopRainbow)

