local function removeWater()

	waterActive = false

	if waterRegion then

		pcall(function()
			Terrain:FillRegion(
				waterRegion,
				4,
				Enum.Material.Air
			)
		end)

		waterRegion = nil
	end
end

local function createWater()

	removeWater()

	local character = player.Character
	if not character then
		return
	end

	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end

	local playerPosition = root.Position

	local topY = playerPosition.Y + 50
	local bottomY = topY - 100

	local half = 2000

	local centerY =
		(topY + bottomY) / 2

	local center = Vector3.new(
		playerPosition.X,
		centerY,
		playerPosition.Z
	)

	local region = Region3.new(
		center - Vector3.new(
			half,
			50,
			half
		),

		center + Vector3.new(
			half,
			50,
			half
		)
	)

	region = region:ExpandToGrid(4)

	waterRegion = region

	pcall(function()

		Terrain:FillRegion(
			region,
			4,
			Enum.Material.Water
		)

	end)

	-- MÀU NƯỚC KIỂU BIỂN
	Terrain.WaterColor =
		Color3.fromRGB(
			15,
			125,
			180
		)

	Terrain.WaterTransparency = 0.12
	Terrain.WaterReflectance = 0.35

	Terrain.WaterWaveSize = 0.18
	Terrain.WaterWaveSpeed = 7

	waterActive = true
end

makeButton(
	"🌊 BẬT NƯỚC BIỂN",
	createWater
)

makeButton(
	"❌ TẮT NƯỚC",
	removeWater
)

