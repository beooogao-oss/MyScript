end

local function createGalaxy()

	removeGalaxy()

	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")

	if not root then return end

	galaxyRunning = true

	galaxyFolder = Instance.new("Folder")
	galaxyFolder.Name = "SKY_Galaxy"
	galaxyFolder.Parent = workspace

	local center =
		root.Position
		+ root.CFrame.LookVector*1000
		+ Vector3.new(0,450,0)

	local stars = {}

	for i=1,450 do

		local star = Instance.new("Part")

		star.Shape = Enum.PartType.Ball

		local size = math.random(2,7)

		star.Size =
			Vector3.new(size,size,size)

		star.Material = Enum.Material.Neon

		star.Color =
			Color3.fromRGB(
				math.random(180,255),
				math.random(180,255),
				math.random(200,255)
			)

		star.Anchored = true
		star.CanCollide = false
		star.CanTouch = false
		star.CanQuery = false

		local angle =
			math.random()*math.pi*2

		local distance =
			math.random(100,750)

		local height =
			math.random(-220,220)

		star.Position =
			center
			+ Vector3.new(
				math.cos(angle)*distance,
				height,
				math.sin(angle)*distance
			)

		star.Parent = galaxyFolder

		table.insert(stars,{
			part=star,
			angle=angle,
			distance=distance,
			height=height,
			speed=math.random(2,8)/100
		})
	end

	for arm=1,5 do

		for i=1,230 do

			local t=i/230

			local angle =
				t*math.pi*7
				+(arm-1)*(math.pi*2/5)

			local radius=t*750

			local p=Instance.new("Part")

			p.Shape=Enum.PartType.Ball

			local size=math.random(3,9)

			p.Size=Vector3.new(size,size,size)

