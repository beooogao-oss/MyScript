local effectsOff = false
local connections = {}

local function destroyEffect(name)

    local x = workspace:FindFirstChild(name)

    if x then
        x:Destroy()
    end
end

local function disconnectAll()

    for _,c in ipairs(connections) do

        if c then
            c:Disconnect()
        end

    end

    table.clear(connections)
end

local function stopAllEffects()

    effectsOff = true

    disconnectAll()

    for _,name in ipairs({
        "SKY_Rainbow",
        "SKY_Galaxy",
        "SKY_Heart",
        "SKY_Fireflies",
        "SKY_Water",
        "SKY_Rice"
    }) do
        destroyEffect(name)
    end

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if root then

        for _,name in ipairs({
            "SKY_SwimForce",
            "SKY_SwimAttachment",
            "SKY_WindForce",
            "SKY_WindAttachment"
        }) do

            local x = root:FindFirstChild(name)

            if x then
                x:Destroy()
            end

        end
    end

    -- DỌN LỰC ĐỒ VẬT
    for _,v in ipairs(workspace:GetDescendants()) do

        if v:IsA("VectorForce")
        and (
            v.Name == "SKY_FloatForce"
            or v.Name == "SKY_LightWind"
        ) then
            v:Destroy()

        elseif v:IsA("Attachment")
        and (
            v.Name == "SKY_FloatAttachment"
            or v.Name == "SKY_WindAttachment"
        ) then
            v:Destroy()
        end
    end

    print("⚡ SKY: ĐÃ TẮT TẤT CẢ")
end

local function enableAll()

    effectsOff = false

    print("✨ SKY: ĐÃ BẬT LẠI")
end

