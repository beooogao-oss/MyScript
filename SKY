            local x = (i-11)*18
            local y = ((i-11)^2)*.08

            p.Position =
                root.Position
                - root.CFrame.RightVector*180
                + Vector3.new(
                    x,
                    y+70,
                    c*9
                )

            p.Parent = folder
        end
