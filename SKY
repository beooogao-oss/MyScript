local heartFolder

local function removeHeart()

	if heartFolder then
		heartFolder:Destroy()
		heartFolder = nil
	end
end

local function createHeart()

	removeHeart()

	local character =
		player.Character

	local root =
		character
		and character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return
	end

	heartFolder =
		Instance.new("Folder")

	heartFolder.Name =
		"SKY_Heart"

	heartFolder.Parent =
		worldFolder

	local center =
		root.Position
		+ root.CFrame.LookVector
		* 100
		+ Vector3.new(
			0,
			70,
			0
		)

	for i = 0, 150 do

		local t =
			math.pi * 2
			* (i / 150)

		local x =
			16 * math.sin(t)^3

		local y =
			13 * math.cos(t)
			- 5 * math.cos(2*t)
			- 2 * math.cos(3*t)
			- math.cos(4*t)

		local part =
			Instance.new("Part")

		part.Shape =
			Enum.PartType.Ball

		part.Size =
			Vector3.new(
				4,
				4,
				4
			)

		part.Material =
			Enum.Material.Neon

		part.Color =
			Color3.fromRGB(
				255,
				70,
				120
			)

		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false

		part.Position =
			center
			+ root.CFrame.RightVector
			* (x * 3)
			+ Vector3.new(
				0,
				y * 3,
				0
			)

		part.Parent =
			heartFolder
	end
end

button(
	"❤️ BẬT TRÁI TIM",
	createHeart
)

button(
	"❌ TẮT TRÁI TIM",
	removeHeart
)
