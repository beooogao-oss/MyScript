local rainbowFolder

local function removeRainbow()
    if rainbowFolder then
        rainbowFolder:Destroy()
        rainbowFolder = nil
    end
end

local function createRainbow()
    removeRainbow()

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    rainbowFolder = Instance.new("Folder")
    rainbowFolder.Name = "Rainbow"
    rainbowFolder.Parent = world

    local center =
        root.Position
        - root.CFrame.RightVector * 180
        + Vector3.new(0,80,0)

    local colors = {
        Color3.fromRGB(255,0,0),
        Color3.fromRGB(255,140,0),
        Color3.fromRGB(255,255,0),
        Color3.fromRGB(0,255,0),
        Color3.fromRGB(0,170,255),
        Color3.fromRGB(0,0,255),
        Color3.fromRGB(180,0,255)
    }

    for index,color in ipairs(colors) do
        local radius = 75-(index-1)*3

        for i=0,40 do
            local angle = math.pi*(i/40)

            local p = Instance.new("Part")
            p.Anchored = true
            p.CanCollide = false
            p.CanTouch = false
            p.CanQuery = false
            p.Material = Enum.Material.Neon
            p.Color = color
            p.Size = Vector3.new(3,3,2)

            p.Position =
                center+
                Vector3.new(
                    math.cos(angle)*radius,
                    math.sin(angle)*radius,
                    0
                )

            p.Parent = rainbowFolder
        end
    end
end

makeButton("🌈 Cầu vồng bên trái",createRainbow)
makeButton("❌ Tắt cầu vồng",removeRainbow)

