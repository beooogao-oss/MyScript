local heartFolder

local function removeHeart()

	if heartFolder then
		heartFolder:Destroy()
		heartFolder = nil
	end
end

local function createHeart()

	removeHeart()

	local char = player.Character
	local root =
		char and char:FindFirstChild("HumanoidRootPart")

	if not root then
		return
	end

	heartFolder =
		Instance.new("Folder")

	heartFolder.Name =
		"SKY_Heart"

	heartFolder.Parent =
		workspace

	local center =
		root.Position
		+ root.CFrame.LookVector * 120
		+ Vector3.new(0, 80, 0)

	-- VIỀN TRÁI TIM

	for i = 0, 220 do

		local t =
			math.pi * 2 * (i / 220)

		local x =
			16 * math.sin(t)^3

		local y =
			13 * math.cos(t)
			- 5 * math.cos(2 * t)
			- 2 * math.cos(3 * t)
			- math.cos(4 * t)

		local p =
			Instance.new("Part")

		p.Shape =
			Enum.PartType.Ball

		p.Size =
			Vector3.new(5, 5, 5)

		p.Material =
			Enum.Material.Neon

		p.Color =
			Color3.fromRGB(
				255,
				math.random(70, 220),
				180
			)

		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false

		p.Position =
			center
			+ root.CFrame.RightVector
				* (x * 3)
			+ Vector3.new(
				0,
				y * 3,
				0
			)

		p.Parent =
			heartFolder
	end

	-- HẠT XUNG QUANH

	for i = 1, 650 do

		local angle =
			math.random() * math.pi * 2

		local radius =
			math.random(70, 190)

		local p =
			Instance.new("Part")

		p.Shape =
			Enum.PartType.Ball

		local size =
			math.random(1, 4)

		p.Size =
			Vector3.new(
				size,
				size,
				size
			)

		p.Material =
			Enum.Material.Neon

		p.Color =
			Color3.fromRGB(
				math.random(160, 255),
				math.random(60, 220),
				255
			)

		p.Transparency =
			math.random(0, 65) / 100

		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false

		p.Position =
			center
			+ Vector3.new(
				math.cos(angle) * radius,
				math.random(-120, 120),
				math.sin(angle) * radius
			)

		p.Parent =
			heartFolder
	end
end

