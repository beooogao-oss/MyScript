local function galaxy()

    if effectsOff then return end

    destroyEffect("SKY_Galaxy")

    local root =
        player.Character
        and player.Character:FindFirstChild("HumanoidRootPart")

    if not root then return end

    local f = Instance.new("Folder")
    f.Name = "SKY_Galaxy"
    f.Parent = workspace

    local center =
        root.Position
        + root.CFrame.LookVector * 700
        + Vector3.new(0,350,0)

    -- ⭐ 250 SAO
    for i=1,250 do

        local star = Instance.new("Part")

        star.Shape = Enum.PartType.Ball
        star.Size = Vector3.new(2,2,2)
        star.Material = Enum.Material.Neon
        star.Color = Color3.new(1,1,1)

        star.Anchored = true
        star.CanCollide = false
        star.CanTouch = false
        star.CanQuery = false

        star.Position =
            center +
            Vector3.new(
                math.random(-700,700),
                math.random(-350,350),
                math.random(-700,700)
            )

        star.Parent = f
    end

    -- 🪐 HÀNH TINH TÍM KHỔNG LỒ
    local planet = Instance.new("Part")

    planet.Shape = Enum.PartType.Ball
    planet.Size = Vector3.new(300,300,300)
    planet.Position = center

    planet.Anchored = true
    planet.CanCollide = false
    planet.CanTouch = false
    planet.CanQuery = false

    planet.Material = Enum.Material.Neon
    planet.Color = Color3.fromRGB(90,30,190)

    planet.Parent = f

    -- 💍 3 VÒNG
    for i=1,3 do

        local ring = Instance.new("Part")

        ring.Shape = Enum.PartType.Cylinder

        ring.Size =
            Vector3.new(
                8,
                430 + i*70,
                430 + i*70
            )

        ring.Position = center

        ring.Anchored = true
        ring.CanCollide = false
        ring.CanTouch = false
        ring.CanQuery = false

        ring.Material = Enum.Material.Neon
        ring.Color = Color3.fromRGB(180,80,255)
        ring.Transparency = .35

        ring.CFrame =
            CFrame.new(center)
            * CFrame.Angles(
                math.rad(65),
                0,
                math.rad(i*8)
            )

        ring.Parent = f
    end

    -- ☀️ MẶT TRỜI
    local sun = Instance.new("Part")

    sun.Shape = Enum.PartType.Ball
    sun.Size = Vector3.new(100,100,100)

    sun.Position =
        center + Vector3.new(500,250,0)

    sun.Anchored = true
    sun.CanCollide = false
    sun.CanTouch = false
    sun.CanQuery = false

    sun.Material = Enum.Material.Neon
    sun.Color = Color3.fromRGB(255,220,50)

    sun.Parent = f

    local light = Instance.new("PointLight")

    light.Brightness = 8
    light.Range = 500
    light.Color = Color3.fromRGB(255,220,100)

    light.Parent = sun

    -- 🔄 CHUYỂN ĐỘNG
    local c = RunService.Heartbeat:Connect(function()

        if effectsOff or not f.Parent then
            return
        end

        local rot = os.clock()*.15

        planet.CFrame =
            CFrame.new(center)
            * CFrame.Angles(0,rot,0)

        for _,v in ipairs(f:GetChildren()) do

            if v:IsA("BasePart")
            and v ~= planet
            and v ~= sun
            and v.Shape == Enum.PartType.Cylinder then

                v.CFrame =
                    CFrame.new(center)
                    * CFrame.Angles(
                        math.rad(65),
                        rot,
                        math.rad(8)
                    )
            end
        end
    end)

    table.insert(connections,c)
end

