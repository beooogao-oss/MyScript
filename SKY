local function water()

    if effectsOff then return end

    destroyEffect("SKY_Water")

    local root =
        player.Character
        and player.Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root then return end

    local folder = Instance.new("Folder")
    folder.Name = "SKY_Water"
    folder.Parent = workspace

    local water = Instance.new("Part")

    water.Name = "Ocean"
    water.Size =
        Vector3.new(1500,1,1500)

    water.Position =
        root.Position-
        Vector3.new(0,5,0)

    water.Anchored = true
    water.CanCollide = false
    water.CanTouch = false
    water.CanQuery = false

    water.Material = Enum.Material.Glass
    water.Color =
        Color3.fromRGB(25,145,210)

    water.Transparency = .3
    water.Reflectance = .25

    water.Parent = folder

    local scanTimer = 0

    local connection =
        RunService.Heartbeat:Connect(function(dt)

        if effectsOff or not folder.Parent then
            return
        end

        scanTimer += dt

        -- Không quét mỗi frame để giảm lag
        if scanTimer < .15 then
            return
        end

        scanTimer = 0

        local waterY = water.Position.Y

        local parts =
            workspace:GetPartBoundsInBox(
                CFrame.new(water.Position),
                Vector3.new(300,25,300)
            )

        for _,p in ipairs(parts) do

            if p:IsA("BasePart")
            and not p.Anchored
            and not p:IsDescendantOf(folder)
            and not (
                player.Character
                and p:IsDescendantOf(
                    player.Character
                )
            ) then

                local depth =
                    waterY-p.Position.Y

                if depth > -2 and depth < 8 then

                    local attachment =
                        p:FindFirstChild(
                            "SKY_FloatAttachment"
                        )

                    if not attachment then

                        attachment =
                            Instance.new("Attachment")

                        attachment.Name =
                            "SKY_FloatAttachment"

                        attachment.Parent = p
                    end

                    local force =
                        p:FindFirstChild(
                            "SKY_FloatForce"
                        )

                    if not force then

                        force =
                            Instance.new("VectorForce")

                        force.Name =
                            "SKY_FloatForce"

                        force.Attachment0 =
                            attachment

                        force.RelativeTo =
                            Enum.ActuatorRelativeTo.World

                        force.ApplyAtCenterOfMass =
                            true

                        force.Parent = p
                    end

                    force.Force =
                        Vector3.new(
                            0,
                            p.AssemblyMass*
                            workspace.Gravity*
                            1.1,
                            0
                        )
                end
            end
        end
    end)

    table.insert(connections,connection)
end

