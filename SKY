local function makeButton(text, y, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -24, 0, 42)
    b.Position = UDim2.fromOffset(12, y)
    b.Text = text
    b.TextSize = 16
    b.TextColor3 = Color3.fromRGB(225, 235, 230)
    b.BackgroundColor3 = Color3.fromRGB(31, 57, 46)
    b.BorderSizePixel = 0
    b.Parent = frame

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 14)
    c.Parent = b

    b.MouseButton1Click:Connect(callback)

    return b
end

-- =========================
-- MƯA SAO BĂNG
-- =========================

local meteorRain = false
local meteorObjects = {}

local function clearMeteors()
    for _, obj in ipairs(meteorObjects) do
        if obj and obj.Parent then
            obj:Destroy()
        end
    end

    table.clear(meteorObjects)
end

local function createMeteor()
    if not meteorRain then return end

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    -- Cách nhân vật khoảng 400 studs
    local center =
        root.Position
        + root.CFrame.LookVector * 400
        + Vector3.new(0, 180, 0)

    local offset = Vector3.new(
        math.random(-180, 180),
        math.random(-30, 100),
        math.random(-120, 120)
    )

    local startPos = center + offset
    local endPos = startPos + Vector3.new(
        math.random(-180, 180),
        -math.random(100, 180),
        math.random(-100, 100)
    )

    local meteor = Instance.new("Part")
    meteor.Name = "RuHubMeteor"
    meteor.Shape = Enum.PartType.Ball
    meteor.Size = Vector3.new(5, 5, 5)
    meteor.Material = Enum.Material.Neon
    meteor.Color = Color3.fromRGB(255, 170, 60)
    meteor.Anchored = true
    meteor.CanCollide = false
    meteor.CanTouch = false
    meteor.CanQuery = false
    meteor.Position = startPos
    meteor.Parent = workspace

    table.insert(meteorObjects, meteor)

    local attachment0 = Instance.new("Attachment")
    attachment0.Parent = meteor

    local trail = Instance.new("Trail")
    trail.Attachment0 = attachment0
    trail.Attachment1 = attachment0
    trail.Lifetime = 0.35
    trail.LightEmission = 1
    trail.Color = ColorSequence.new(
        Color3.fromRGB(255, 230, 150),
        Color3.fromRGB(255, 70, 20)
    )
    trail.Parent = meteor

    local duration = 1.5
    local startTime = tick()

    local connection
    connection = RunService.Heartbeat:Connect(function()
        if not meteor.Parent or not meteorRain then
            connection:Disconnect()

            if meteor.Parent then
                meteor:Destroy()
            end

            return
        end

        local alpha = math.clamp(
            (tick() - startTime) / duration,
            0,
            1
        )

        meteor.Position = startPos:Lerp(endPos, alpha)

        if alpha >= 1 then
            connection:Disconnect()

            if meteor.Parent then
                meteor:Destroy()
            end
        end
    end)
end

local function startMeteorRain()
    if meteorRain then return end

    meteorRain = true

    task.spawn(function()
        while meteorRain do
            createMeteor()
            task.wait(math.random(15, 40) / 100)
        end
    end)
end

local function stopMeteorRain()
    meteorRain = false
    clearMeteors()
end

