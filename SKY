local Rainbow

local function StopRainbow()
	if Rainbow then
		Rainbow:Destroy()
		Rainbow = nil
	end
end

local function StartRainbow()

	StopRainbow()

	local Char = Player.Character
	local Root = Char and Char:FindFirstChild("HumanoidRootPart")
	if not Root then return end

	Rainbow = Instance.new("Folder")
	Rainbow.Parent = Objects

	local Center =
		Root.Position
		- Root.CFrame.RightVector * 150
		+ Vector3.new(0,65,0)

	local Colors = {
		Color3.fromRGB(255,40,40),
		Color3.fromRGB(255,150,20),
		Color3.fromRGB(255,255,30),
		Color3.fromRGB(40,255,100),
		Color3.fromRGB(30,200,255),
		Color3.fromRGB(70,80,255),
		Color3.fromRGB(210,50,255)
	}

	for n,color in ipairs(Colors) do

		local Radius = 65-(n-1)*3

		for i=0,35 do

			local A = math.pi*i/35

			local P = Instance.new("Part")
			P.Shape = Enum.PartType.Ball
			P.Size = Vector3.new(3,3,3)
			P.Material = Enum.Material.Neon
			P.Color = color
			P.Anchored = true
			P.CanCollide = false
			P.CanTouch = false
			P.CanQuery = false

			P.Position =
				Center+
				Vector3.new(
					math.cos(A)*Radius,
					math.sin(A)*Radius,
					0
				)

			P.Parent = Rainbow
		end
	end
end

Button("🌈 Bật cầu vồng",StartRainbow)
Button("❌ Tắt cầu vồng",StopRainbow)

--==================================================
-- 🌌 GALAXY GIỐNG ẢNH
--==================================================

local Galaxy
local GalaxyRunning = false

local GalaxyColors = {
	Color3.fromRGB(70,90,255),
	Color3.fromRGB(90,150,255),
	Color3.fromRGB(150,60,255),
	Color3.fromRGB(210,50,255),
	Color3.fromRGB(255,60,190),
	Color3.fromRGB(80,220,255)
}

local function StopGalaxy()

	GalaxyRunning = false

	if Galaxy then
		Galaxy:Destroy()
		Galaxy = nil
	end
end

local function StartGalaxy()

	StopGalaxy()

	local Char = Player.Character
	local Root = Char and Char:FindFirstChild("HumanoidRootPart")
	if not Root then return end

	GalaxyRunning = true

	Galaxy = Instance.new("Folder")
	Galaxy.Name = "RuHub_ColorGalaxy"
	Galaxy.Parent = Objects

	-- ĐẶT PHÍA TRƯỚC
	local Center =
		Root.Position
		+ Root.CFrame.LookVector * 180
		+ Vector3.new(0,70,0)

	local Moving = {}

	--================================================
	-- ✨ HẠT SAO NHIỀU MÀU
	--================================================

	for i=1,320 do

		local P = Instance.new("Part")
		P.Shape = Enum.PartType.Ball

		local S = math.random(1,5)

		P.Size = Vector3.new(S,S,S)
		P.Material = Enum.Material.Neon
		P.Color = GalaxyColors[
			math.random(1,#GalaxyColors)
		]

		P.Anchored = true
		P.CanCollide = false
		P.CanTouch = false
		P.CanQuery = false

		local A = math.random()*math.pi*2
		local R = math.random(35,180)
		local H = math.random(-70,80)

		P.Position =
			Center+
			Vector3.new(
				math.cos(A)*R,
				H,
				math.sin(A)*R
			)

		P.Parent = Galaxy

		table.insert(Moving,{
			part=P,
			angle=A,
			radius=R,
			height=H,
			speed=math.random(2,8)/100
		})
	end

	--================================================
	-- 🌀 DẢI XOẮN THIÊN HÀ
	--================================================

	for Arm=1,5 do

		for i=1,180 do

			local T=i/180

			local A =
				T*math.pi*7
				+(Arm-1)*(math.pi*2/5)

			local R=T*210

			local P=Instance.new("Part")

			P.Shape=Enum.PartType.Ball

			local S=math.random(2,5)

			P.Size=Vector3.new(S,S,S)

			P.Material=Enum.Material.Neon

			P.Color =
				GalaxyColors[
					math.random(1,#GalaxyColors)
				]

			P.Anchored=true
			P.CanCollide=false
			P.CanTouch=false
			P.CanQuery=false

			P.Position =
				Center+
				Vector3.new(
					math.cos(A)*R,
					math.sin(T*math.pi)*25+
					math.random(-15,15),
					math.sin(A)*R
				)

			P.Parent=Galaxy
		end
	end

	--================================================
	-- ☀️ LÕI TRẮNG
	--================================================

	local Core=Instance.new("Part")

	Core.Shape=Enum.PartType.Ball
	Core.Size=Vector3.new(45,45,45)
	Core.Material=Enum.Material.Neon
	Core.Color=Color3.fromRGB(255,255,255)

	Core.Anchored=true
	Core.CanCollide=false
	Core.CanTouch=false
	Core.CanQuery=false
	Core.Position=Center
	Core.Parent=Galaxy

	local Light=Instance.new("PointLight")
	Light.Color=Color3.fromRGB(170,130,255)
	Light.Brightness=15
	Light.Range=250
	Light.Parent=Core

	--================================================
	-- 🔄 XOAY
	--================================================

	task.spawn(function()

		while GalaxyRunning
		and Galaxy
		and Galaxy.Parent do

			for _,D in ipairs(Moving) do

				if D.part and D.part.Parent then

					D.angle += D.speed

					D.part.Position =
						Center+
						Vector3.new(
							math.cos(D.angle)*D.radius,
							D.height+
							math.sin(D.angle*2)*8,
							math.sin(D.angle)*D.radius
						)
				end
			end

			task.wait(.04)
		end
	end)
end

Button("🌌 Bật thiên hà V2",StartGalaxy)
Button("❌ Tắt thiên hà",StopGalaxy)

