local rainbowFolder

local function removeRainbow()
    if rainbowFolder then
        rainbowFolder:Destroy()
        rainbowFolder = nil
    end
end

local function createRainbow()
    removeRainbow()

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    rainbowFolder = Instance.new("Folder")
    rainbowFolder.Name = "Rainbow"
    rainbowFolder.Parent = fx

    local center =
        root.Position
        - root.CFrame.RightVector * 180
        + Vector3.new(0,75,0)

    local colors = {
        Color3.fromRGB(255,0,0),
        Color3.fromRGB(255,130,0),
        Color3.fromRGB(255,240,0),
        Color3.fromRGB(0,255,80),
        Color3.fromRGB(0,190,255),
        Color3.fromRGB(50,80,255),
        Color3.fromRGB(220,0,255)
    }

    for n,color in ipairs(colors) do
        local radius = 78 - (n-1)*4

        for i=0,55 do
            local angle = math.pi*(i/55)

            local p = Instance.new("Part")
            p.Shape = Enum.PartType.Ball
            p.Size = Vector3.new(4,4,4)
            p.Material = Enum.Material.Neon
            p.Color = color
            p.Anchored = true
            p.CanCollide = false
            p.CanTouch = false
            p.CanQuery = false

            p.Position =
                center +
                Vector3.new(
                    math.cos(angle)*radius,
                    math.sin(angle)*radius,
                    0
                )

            p.Parent = rainbowFolder
        end
    end
end

makeButton("🌈 Bật cầu vồng",createRainbow)
makeButton("❌ Tắt cầu vồng",removeRainbow)

