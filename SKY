local Heart
local HeartRunning=false

local function StopHeart()

    HeartRunning=false

    if Heart then
        Heart:Destroy()
        Heart=nil
    end

end

local function StartHeart()

    StopHeart()

    local Character=Player.Character
    local Root=Character and Character:FindFirstChild("HumanoidRootPart")

    if not Root then return end

    HeartRunning=true

    Heart=Instance.new("Folder")
    Heart.Name="CosmicHeart"
    Heart.Parent=World

    local Center =
        Root.Position+
        Root.CFrame.LookVector*100+
        Vector3.new(0,60,0)

    -- ❤️ TRÁI TIM
    for i=0,180 do

        local T=math.pi*2*i/180

        local X=16*math.sin(T)^3

        local Y=
            13*math.cos(T)
            -5*math.cos(2*T)
            -2*math.cos(3*T)
            -math.cos(4*T)

        local P=Instance.new("Part")

        P.Shape=Enum.PartType.Ball
        P.Size=Vector3.new(5,5,5)

        P.Material=Enum.Material.Neon
        P.Color=Color3.fromRGB(255,60,190)

        P.Anchored=true
        P.CanCollide=false
        P.CanTouch=false
        P.CanQuery=false

        P.Position=
            Center+
            Root.CFrame.RightVector*(X*3)+
            Vector3.new(0,Y*3,0)

        P.Parent=Heart

    end

    -- 🔵 QUẢ CẦU NĂNG LƯỢNG
    local Core=Instance.new("Part")

    Core.Shape=Enum.PartType.Ball
    Core.Size=Vector3.new(55,55,55)

    Core.Material=Enum.Material.Neon
    Core.Color=Color3.fromRGB(80,150,255)

    Core.Anchored=true
    Core.CanCollide=false
    Core.CanTouch=false
    Core.CanQuery=false

    Core.Position=Center
    Core.Parent=Heart

    local CoreLight=Instance.new("PointLight")

    CoreLight.Color=
        Color3.fromRGB(100,180,255)

    CoreLight.Brightness=20
    CoreLight.Range=180
    CoreLight.Parent=Core

    -- ✨ HẠT
    local Particles={}

    local ParticleColors={
        Color3.fromRGB(255,255,255),
        Color3.fromRGB(255,100,220),
        Color3.fromRGB(190,80,255),
        Color3.fromRGB(80,180,255),
        Color3.fromRGB(100,255,255)
    }

    for i=1,400 do

        local P=Instance.new("Part")

        P.Shape=Enum.PartType.Ball

        local S=math.random(1,4)

        P.Size=Vector3.new(S,S,S)

        P.Material=Enum.Material.Neon

        P.Color=
            ParticleColors[
                math.random(1,#ParticleColors)
            ]

        P.Anchored=true
        P.CanCollide=false
        P.CanTouch=false
        P.CanQuery=false

        local Angle=
            math.random()*math.pi*2

        local Radius=
            math.random(65,170)

        local Height=
            math.random(-80,120)

        P.Position=
            Center+
            Vector3.new(
                math.cos(Angle)*Radius,
                Height,
                math.sin(Angle)*Radius
            )

        P.Parent=Heart

        table.insert(Particles,{
            Part=P,
            Angle=Angle,
            Radius=Radius,
            Height=Height,
            Speed=math.random(2,9)/100
        })

    end

    -- 🔄 HẠT + QUẢ CẦU CHUYỂN ĐỘNG
    task.spawn(function()

        while HeartRunning
        and Heart
        and Heart.Parent do

            for _,D in ipairs(Particles) do

                if D.Part and D.Part.Parent then

                    D.Angle+=D.Speed

                    D.Part.Position=
                        Center+
                        Vector3.new(
                            math.cos(D.Angle)*D.Radius,
                            D.Height+
                            math.sin(D.Angle*2)*8,
                            math.sin(D.Angle)*D.Radius
                        )

                end

            end

            local Pulse=
                55+
                math.sin(os.clock()*3)*6

            Core.Size=
                Vector3.new(
                    Pulse,
                    Pulse,
                    Pulse
                )

            task.wait(0.03)

        end

    end)

end

