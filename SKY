local ironBusy = false

local function makePart(parent, size, color, cf, material)
	local p = Instance.new("Part")
	p.Size = size
	p.CFrame = cf
	p.Anchored = true
	p.CanCollide = false
	p.Material = material or Enum.Material.SmoothPlastic
	p.Color = color
	p.Parent = parent
	return p
end

local function IronManSnap()

	if ironBusy then return end
	ironBusy = true

	local char = player.Character
	if not char then
		ironBusy = false
		return
	end

	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then
		ironBusy = false
		return
	end

	local oldPos = root.CFrame
	local pos = root.Position + root.CFrame.LookVector * 7

	local model = Instance.new("Model")
	model.Name = "SKY_IronMan"
	model.Parent = workspace

	-- Màu giáp
	local red = Color3.fromRGB(150,20,20)
	local gold = Color3.fromRGB(255,180,35)
	local dark = Color3.fromRGB(35,35,40)
	local skin = Color3.fromRGB(210,160,120)

	-- =================================================
	-- THÂN ĐỨNG THẲNG
	-- =================================================

	local bodyCF = CFrame.new(pos + Vector3.new(0,4,0))

	makePart(
		model,
		Vector3.new(2.8,3.2,1.5),
		red,
		bodyCF,
		Enum.Material.Metal
	)

	-- Ngực vàng
	makePart(
		model,
		Vector3.new(1.5,1.8,0.12),
		gold,
		bodyCF * CFrame.new(0,0,0.78),
		Enum.Material.Metal
	)

	-- Arc Reactor
	local reactor = makePart(
		model,
		Vector3.new(.55,.55,.15),
		Color3.fromRGB(100,230,255),
		bodyCF * CFrame.new(0,0.1,0.9),
		Enum.Material.Neon
	)

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(80,220,255)
	light.Brightness = 3
	light.Range = 12
	light.Parent = reactor

	-- =================================================
	-- ĐẦU + MẶT KHÔNG MẶT NẠ
	-- =================================================

	local head = makePart(
		model,
		Vector3.new(1.25,1.25,1.25),
		skin,
		pos + Vector3.new(0,6.25,0)
	)

	-- Tóc
	makePart(
		model,
		Vector3.new(1.3,.35,1.3),
		Color3.fromRGB(45,25,15),
		head.CFrame * CFrame.new(0,.58,0)
	)

	-- =================================================
	-- CHÂN ĐỨNG THẲNG
	-- =================================================

	makePart(
		model,
		Vector3.new(1.1,3.4,1.1),
		dark,
		pos + Vector3.new(-.75,1.3,0),
		Enum.Material.Metal
	)

	makePart(
		model,
		Vector3.new(1.1,3.4,1.1),
		dark,
		pos + Vector3.new(.75,1.3,0),
		Enum.Material.Metal
	)

	-- =================================================
	-- VAI + TAY
	-- =================================================

	makePart(
		model,
		Vector3.new(.8,1.1,1.6),
		red,
		pos + Vector3.new(-1.75,4.8,0),
		Enum.Material.Metal
	)

	makePart(
		model,
		Vector3.new(.8,1.1,1.6),
		red,
		pos + Vector3.new(1.75,4.8,0),
		Enum.Material.Metal
	)

	local leftArm = makePart(
		model,
		Vector3.new(.75,2.8,.9),
		red,
		pos + Vector3.new(-1.8,3.4,0),
		Enum.Material.Metal
	)

	local rightArm = makePart(
		model,
		Vector3.new(.75,2.8,.9),
		red,
		pos + Vector3.new(1.8,3.4,0),
		Enum.Material.Metal
	)

	-- =================================================
	-- 6 VIÊN ĐÁ TRÊN BỘ GIÁP
	-- =================================================

	local stones = {
		Color3.fromRGB(255,60,60),
		Color3.fromRGB(80,170,255),
		Color3.fromRGB(120,255,100),
		Color3.fromRGB(210,80,255),
		Color3.fromRGB(255,180,40),
		Color3.fromRGB(255,80,180)
	}

	for i = 1,6 do
		local x = ((i-1)%3 - 1) * .55
		local y = 4.0 + math.floor((i-1)/3) * .65

		local stone = makePart(
			model,
			Vector3.new(.3,.3,.16),
			stones[i],
			CFrame.new(pos + Vector3.new(x,y,.9)),
			Enum.Material.Neon
		)

		local sl = Instance.new("PointLight")
		sl.Color = stones[i]
		sl.Brightness = 3
		sl.Range = 7
		sl.Parent = stone
	end

	-- =================================================
	-- ĐƯA TAY LÊN BÚNG
	-- =================================================

	local startCF = rightArm.CFrame
	local snapCF =
		CFrame.new(pos + Vector3.new(1.45,5.0,.45))
		* CFrame.Angles(math.rad(-45),0,math.rad(-25))

	local tween = TweenService:Create(
		rightArm,
		TweenInfo.new(.7,Enum.EasingStyle.Sine,Enum.EasingDirection.Out),
		{CFrame = snapCF}
	)

	tween:Play()
	tween.Completed:Wait()

	task.wait(.25)

	-- =================================================
	-- TIẾNG "TẠCH"
	-- =================================================

	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://9118823101"
	sound.Volume = 5
	sound.Parent = rightArm
	sound:Play()
	Debris:AddItem(sound,3)

	-- =================================================
	-- ÁNH SÁNG LÓA 1000 STUDS
	-- =================================================

	local flash = Instance.new("Part")
	flash.Shape = Enum.PartType.Ball
	flash.Size = Vector3.new(5,5,5)
	flash.Position = pos + Vector3.new(0,4,0)
	flash.Anchored = true
	flash.CanCollide = false
	flash.Transparency = .15
	flash.Material = Enum.Material.Neon
	flash.Color = Color3.fromRGB(255,255,255)
	flash.Parent = workspace

	local flashLight = Instance.new("PointLight")
	flashLight.Brightness = 50
	flashLight.Range = 1000
	flashLight.Color = Color3.fromRGB(255,255,255)
	flashLight.Parent = flash

	TweenService:Create(
		flash,
		TweenInfo.new(.8),
		{
			Size = Vector3.new(1000,1000,1000),
			Transparency = 1
		}
	):Play()

	Debris:AddItem(flash,1)

	-- Vòng sáng
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(.2,8,8)
	ring.CFrame = CFrame.new(pos + Vector3.new(0,4,0))
		* CFrame.Angles(0,0,math.rad(90))
	ring.Anchored = true
	ring.CanCollide = false
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(255,255,255)
	ring.Transparency = .2
	ring.Parent = workspace

	TweenService:Create(
		ring,
		TweenInfo.new(1),
		{
			Size = Vector3.new(.2,1000,1000),
			Transparency = 1
		}
	):Play()

	Debris:AddItem(ring,1.2)

	-- =================================================
	-- TAY HẠ XUỐNG
	-- =================================================

	task.wait(.5)

	TweenService:Create(
		rightArm,
		TweenInfo.new(.6,Enum.EasingStyle.Sine),
		{CFrame = startCF}
	):Play()

	task.wait(1)

	model:Destroy()
	ironBusy = false
end

