    end
end

local function createHeart()

    removeHeart()

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    heartFolder = Instance.new("Folder")
    heartFolder.Name = "Heart"
    heartFolder.Parent = fx

    local center =
        root.Position
        + root.CFrame.LookVector*100
        + Vector3.new(0,55,0)

    -- 💗 TRÁI TIM
    for i=0,200 do

        local t = math.pi*2*i/200

        local x = 16*math.sin(t)^3

        local y =
            13*math.cos(t)
            -5*math.cos(2*t)
            -2*math.cos(3*t)
            -math.cos(4*t)

        createStar(
            heartFolder,
            center
            + root.CFrame.RightVector*(x*2.8)
            + Vector3.new(0,y*2.8,0),
            4,
            Color3.fromRGB(255,180,245),
            0
        )
    end

    -- ✨ HẠT BAO QUANH
    for i=1,500 do

        local angle = math.random()*math.pi*2
        local radius = math.random(50,160)

        createStar(
            heartFolder,
            center+Vector3.new(
                math.cos(angle)*radius,
                math.random(-90,100),
                math.sin(angle)*radius
            ),
            math.random(1,4),
            Color3.fromRGB(
                math.random(150,255),
                math.random(60,220),
                255
            ),
            math.random(20,80)/100
        )
    end
end

