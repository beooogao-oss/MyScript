local Galaxy
local GalaxyRunning = false

local function OffGalaxy()

    GalaxyRunning = false

    if Galaxy then
        Galaxy:Destroy()
        Galaxy = nil
    end

end

local function GalaxyOn()

    OffGalaxy()

    local Character = Player.Character
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")

    if not Root then return end

    GalaxyRunning = true

    Galaxy = Instance.new("Folder")
    Galaxy.Name = "Galaxy"
    Galaxy.Parent = World

    local Center =
        Root.Position +
        Root.CFrame.LookVector * 1000 +
        Vector3.new(0,450,0)

    local Stars = {}

    for i=1,350 do

        local Star = Instance.new("Part")

        Star.Shape = Enum.PartType.Ball

        local Size = math.random(2,6)

        Star.Size =
            Vector3.new(Size,Size,Size)

        Star.Material = Enum.Material.Neon

        Star.Color =
            Color3.fromRGB(
                math.random(170,255),
                math.random(170,255),
                255
            )

        Star.Anchored = true
        Star.CanCollide = false
        Star.CanTouch = false
        Star.CanQuery = false

        local Angle =
            math.random()*math.pi*2

        local Radius =
            math.random(100,700)

        local Height =
            math.random(-220,220)

        Star.Position =
            Center+
            Vector3.new(
                math.cos(Angle)*Radius,
                Height,
                math.sin(Angle)*Radius
            )

        Star.Parent = Galaxy

        table.insert(
            Stars,
            {
                Part = Star,
                Angle = Angle,
                Radius = Radius,
                Height = Height,
                Speed = math.random(2,8)/100
            }
        )

    end

    task.spawn(function()

        while GalaxyRunning
        and Galaxy
        and Galaxy.Parent do

            for _,Data in ipairs(Stars) do

                if Data.Part
                and Data.Part.Parent then

                    Data.Angle += Data.Speed

                    Data.Part.Position =
                        Center+
                        Vector3.new(
                            math.cos(Data.Angle)
                            *Data.Radius,

                            Data.Height,

                            math.sin(Data.Angle)
                            *Data.Radius
                        )

                end

            end

            task.wait(.03)

        end

    end)

end

Button("🌌 Bật thiên hà lớn",GalaxyOn)
Button("❌ Tắt thiên hà",OffGalaxy)

