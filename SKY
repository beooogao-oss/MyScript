local swimOn = false

local function swim()

    swimOn = true

    local connection =
        RunService.Heartbeat:Connect(function()

        if effectsOff or not swimOn then
            return
        end

        local character = player.Character

        local humanoid =
            character and
            character:FindFirstChildOfClass(
                "Humanoid"
            )

        local root =
            character and
            character:FindFirstChild(
                "HumanoidRootPart"
            )

        local waterFolder =
            workspace:FindFirstChild(
                "SKY_Water"
            )

        local ocean =
            waterFolder and
            waterFolder:FindFirstChild(
                "Ocean"
            )

        if not humanoid
        or not root
        or not ocean then
            return
        end

        local depth =
            ocean.Position.Y-root.Position.Y

        if depth > -2 and depth < 10 then

            humanoid:ChangeState(
                Enum.HumanoidStateType.Swimming
            )

            local attachment =
                root:FindFirstChild(
                    "SKY_SwimAttachment"
                )

            if not attachment then

                attachment =
                    Instance.new("Attachment")

                attachment.Name =
                    "SKY_SwimAttachment"

                attachment.Parent = root
            end

            local force =
                root:FindFirstChild(
                    "SKY_SwimForce"
                )

            if not force then

                force =
                    Instance.new("VectorForce")

                force.Name =
                    "SKY_SwimForce"

                force.Attachment0 =
                    attachment

                force.RelativeTo =
                    Enum.ActuatorRelativeTo.World

                force.ApplyAtCenterOfMass =
                    true

                force.Parent = root
            end

            local lift =
                math.clamp(
                    1.05+
                    depth*.08,
                    1,
                    1.35
                )

            force.Force =
                Vector3.new(
                    0,
                    root.AssemblyMass*
                    workspace.Gravity*
                    lift,
                    0
                )

        else

            local force =
                root:FindFirstChild(
                    "SKY_SwimForce"
                )

            local attachment =
