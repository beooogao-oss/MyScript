-- 🌌 THIÊN HÀ GIỐNG ẢNH
--==================================================

local Galaxy
local GalaxyConnection

local GalaxyColors={
	Color3.fromRGB(40,90,255),
	Color3.fromRGB(70,160,255),
	Color3.fromRGB(120,50,255),
	Color3.fromRGB(190,40,255),
	Color3.fromRGB(255,40,190),
	Color3.fromRGB(255,100,220),
	Color3.fromRGB(210,230,255),
	Color3.fromRGB(255,255,255)
}

local function StopGalaxy()

	if GalaxyConnection then
		GalaxyConnection:Disconnect()
		GalaxyConnection=nil
	end

	if Galaxy then
		Galaxy:Destroy()
		Galaxy=nil
	end
end

local function StartGalaxy()

	StopGalaxy()

	local char=Player.Character
	local root=char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	Galaxy=Instance.new("Folder")
	Galaxy.Name="Galaxy"
	Galaxy.Parent=Folder

	local center=
		root.Position
		+root.CFrame.LookVector*260
		+Vector3.new(0,80,0)

	local moving={}

	local function Star(pos,size,color,trans)

		local p=Instance.new("Part")
		p.Shape=Enum.PartType.Ball
		p.Size=Vector3.new(size,size,size)
		p.Material=Enum.Material.Neon
		p.Color=color
		p.Transparency=trans or 0
		p.Anchored=true
		p.CanCollide=false
		p.CanTouch=false
		p.CanQuery=false
		p.Position=pos
		p.Parent=Galaxy

		return p
	end

	-- ⭐ NỀN SAO
	for i=1,700 do

		local a=math.random()*math.pi*2
		local r=math.random(80,430)

		Star(
			center+Vector3.new(
				math.cos(a)*r,
				math.random(-170,170),
				math.sin(a)*r
			),
			math.random(1,5),
			GalaxyColors[math.random(1,#GalaxyColors)],
			math.random(0,45)/100
		)
	end

	-- 🌀 DẢI XOẮN
	for arm=1,6 do

		for i=1,350 do

			local t=i/350

			local a=
				t*math.pi*8
				+(arm-1)*math.pi*2/6

			local r=25+t*410

			local p=Star(
				center+Vector3.new(
					math.cos(a)*r,
					math.sin(t*math.pi)*45+
					math.random(-18,18),
					math.sin(a)*r
				),
				math.random(2,6),
				GalaxyColors[math.random(1,#GalaxyColors)],
				math.random(5,40)/100
			)

			if math.random()<.18 then
				table.insert(moving,{
					part=p,
					a=a,
					r=r,
					y=math.random(-50,50),
					speed=math.random(2,8)/100
				})
			end
		end
	end

	-- ☀️ MẶT TRỜI BÊN PHẢI
	local sunPos=
		center
		+root.CFrame.RightVector*390
		+Vector3.new(0,70,0)

	local sun=Star(
		sunPos,
		110,
		Color3.fromRGB(255,255,255)
	)

	local light=Instance.new("PointLight")
	light.Brightness=25
	light.Range=1000
	light.Color=Color3.fromRGB(220,230,255)
	light.Parent=sun

	-- ✨ QUẦNG MẶT TRỜI
	for i=1,100 do

		local a=math.random()*math.pi*2
		local r=math.random(70,190)

		Star(
			sunPos+Vector3.new(
				math.cos(a)*r,
				math.random(-60,60),
				math.sin(a)*r
			),
			math.random(2,7),
			Color3.fromRGB(255,245,220),
			math.random(25,75)/100
		)
	end

	-- 🪐 HÀNH TINH BÊN TRÁI
	local planetPos=
		center
		-root.CFrame.RightVector*300

	local planet=Instance.new("Part")
	planet.Shape=Enum.PartType.Ball
	planet.Size=Vector3.new(430,430,430)
	planet.Material=Enum.Material.SmoothPlastic
	planet.Color=Color3.fromRGB(45,55,75)
	planet.Anchored=true
	planet.CanCollide=false
	planet.CanTouch=false
	planet.CanQuery=false
	planet.Position=planetPos
	planet.Parent=Galaxy

	-- 💍 VÀNH TIỂU HÀNH TINH
	local rocks={}

	for i=1,500 do

		local a=math.random()*math.pi*2
		local r=math.random(220,390)

		local rock=Star(
			planetPos+Vector3.new(
				math.cos(a)*r,
				math.random(-15,15),
				math.sin(a)*r
			),
			math.random(2,8),
			Color3.fromRGB(
				math.random(90,180),
				math.random(90,180),
				math.random(100,190)
			)
		)

		table.insert(rocks,{
			part=rock,
			a=a,
			r=r,
			y=math.random(-15,15)
		})
	end

	-- 🔄 CHUYỂN ĐỘNG
	GalaxyConnection=RunService.Heartbeat:Connect(function()

		for _,d in ipairs(moving) do
			if d.part and d.part.Parent then

				d.a+=d.speed

				d.part.Position=
					center+Vector3.new(
						math.cos(d.a)*d.r,
						d.y+math.sin(d.a*2)*10,
						math.sin(d.a)*d.r
					)
			end
		end

		for _,d in ipairs(rocks) do
			if d.part and d.part.Parent then

				d.a+=.002

				d.part.Position=
					planetPos+Vector3.new(
						math.cos(d.a)*d.r,
						d.y,
						math.sin(d.a)*d.r
					)
			end
		end
	end)
end

Button("🌌 BẬT THIÊN HÀ",StartGalaxy)
Button("❌ TẮT THIÊN HÀ",StopGalaxy)

