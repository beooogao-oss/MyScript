local waterFolder
local waterPart
local waterEnabled = false
local floatConnection

local function removeWater()

    waterEnabled = false

    if floatConnection then
        floatConnection:Disconnect()
        floatConnection = nil
    end

    if waterFolder then
        waterFolder:Destroy()
        waterFolder = nil
    end

    -- Xóa lực nổi cũ
    for _,obj in ipairs(
        workspace:GetDescendants()
    ) do

        if obj:IsA("VectorForce")
            and obj.Name == "RuHub_FloatForce" then

            local att =
                obj.Parent:FindFirstChild(
                    "RuHub_FloatAttachment"
                )

            obj:Destroy()

            if att then
                att:Destroy()
            end
        end
    end
end

local function createWater()

    removeWater()

    local char = player.Character

    local root =
        char
        and char:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root then
        return
    end

    waterEnabled = true

    waterFolder = Instance.new("Folder")
    waterFolder.Name = "RuHub_Water"
    waterFolder.Parent = workspace

    -- 🌊 MẶT NƯỚC
    waterPart = Instance.new("Part")

    waterPart.Name = "Ocean"

    waterPart.Size =
        Vector3.new(
            2000,
            1,
            2000
        )

    waterPart.Position =
        root.Position
        + Vector3.new(0,-8,0)

    waterPart.Anchored = true
    waterPart.CanCollide = false
    waterPart.CanTouch = false
    waterPart.CanQuery = false

    waterPart.Material =
        Enum.Material.SmoothPlastic

    waterPart.Color =
        Color3.fromRGB(
            35,
            145,
            205
        )

    waterPart.Transparency = 0.12
    waterPart.Reflectance = 0.35

    waterPart.Parent = waterFolder

    -- 🌊 VẬT NỔI
    floatConnection =
        RunService.Heartbeat:Connect(
            function()

                if not waterEnabled
                    or not waterPart then
                    return
                end

                local waterY =
                    waterPart.Position.Y

                for _,part in ipairs(
                    workspace:GetDescendants()
                ) do

                    if part:IsA("BasePart")
                        and not part.Anchored
                        and not part:IsDescendantOf(
                            waterFolder
                        )
                        and not (
                            player.Character
                            and part:IsDescendantOf(
                                player.Character
                            )
                        ) then

                        local force =
                            part:FindFirstChild(
                                "RuHub_FloatForce"
                            )

                        if not force then

                            local attachment =
                                Instance.new(
                                    "Attachment"
                                )

                            attachment.Name =
                                "RuHub_FloatAttachment"

                            attachment.Parent =
                                part

                            force =
                                Instance.new(
                                    "VectorForce"
                                )

                            force.Name =
                                "RuHub_FloatForce"

                            force.Attachment0 =
                                attachment

                            force.RelativeTo =
                                Enum.ActuatorRelativeTo.World

                            force.ApplyAtCenterOfMass =
                                true

                            force.Parent =
                                part
                        end

                        local depth =
                            waterY
                            - part.Position.Y

                        if depth > -1.5
                            and depth < 8 then

                            local mass =
                                part.AssemblyMass

                            local strength =
                                math.clamp(
                                    0.15
                                    + depth * 0.12,
                                    0.05,
                                    0.45
                                )

                            force.Force =
                                Vector3.new(
                                    0,
                                    mass
                                    * workspace.Gravity
                                    * strength,
                                    0
                                )
                        else

                            force.Force =
                                Vector3.zero
                        end
                    end
                end
            end
        )
end

