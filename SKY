-- TẠO VÒNG VỊT
--==================================================

local function createDucks()

	removeDucks()

	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")

	if not root then
		return
	end

	duckFolder = Instance.new("Folder")
	duckFolder.Name = "SKY_Ducks"
	duckFolder.Parent = workspace

	for i = 1, DUCK_COUNT do

		local duck = makeDuck()

		duck.angle =
			((i - 1) / DUCK_COUNT)
			* math.pi * 2

		duck.bobOffset =
			(i / DUCK_COUNT)
			* math.pi * 2

		table.insert(ducks,duck)

	end

	--==================================================
	-- CHUYỂN ĐỘNG MƯỢT
	--==================================================

	duckConnection = RunService.Heartbeat:Connect(function(dt)

		local character = player.Character
		local rootPart =
			character
			and character:FindFirstChild("HumanoidRootPart")

		if not rootPart then
			return
		end

		for _,duck in ipairs(ducks) do

			if duck.model
			and duck.model.Parent then

				-- Quay vòng
				duck.angle =
					duck.angle
					+ DUCK_SPEED * dt

				-- Vị trí vòng tròn
				local x =
					math.cos(duck.angle)
					* DUCK_RADIUS

				local z =
					math.sin(duck.angle)
					* DUCK_RADIUS

				-- Nhấp nhô rất nhẹ
				local y =
					DUCK_HEIGHT
					+ math.sin(
						os.clock() * 3
						+ duck.bobOffset
					) * 0.15

				local position =
					rootPart.Position
					+ Vector3.new(x,y,z)

				-- Hướng vịt theo hướng chạy
				local nextAngle =
					duck.angle + 0.1

				local nextPosition =
					rootPart.Position
					+ Vector3.new(
						math.cos(nextAngle)
						* DUCK_RADIUS,

						y,

						math.sin(nextAngle)
						* DUCK_RADIUS
					)

				local cf =
					CFrame.lookAt(
						position,
						nextPosition
					)

				-- Thân
				duck.body.CFrame =
					cf

				-- Đầu
				duck.head.CFrame =
					cf
					* CFrame.new(
						0,
						0.25,
						-0.28
					)

				-- Mỏ
				duck.beak.CFrame =
					cf
					* CFrame.new(
						0,
						0.22,
						-0.62
					)

				-- Mắt
				duck.eye1.CFrame =
					cf
					* CFrame.new(
						-0.18,
						0.35,
						-0.48
					)

				duck.eye2.CFrame =
					cf
					* CFrame.new(
						0.18,
						0.35,
						-0.48
					)

			end

		end

	end)

end

