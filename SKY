-- 🌌 THIÊN HÀ
-- =========================

local galaxyFolder
local galaxyRunning = false

local function removeGalaxy()

    galaxyRunning = false

    if galaxyFolder then
        galaxyFolder:Destroy()
        galaxyFolder = nil
    end
end

local function createGalaxy()

    removeGalaxy()

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    galaxyRunning = true

    galaxyFolder = Instance.new("Folder")
    galaxyFolder.Name = "RuHub_Galaxy"
    galaxyFolder.Parent = workspace

    local center =
        root.Position+
        root.CFrame.LookVector*1000+
        Vector3.new(0,450,0)

    local movingStars = {}

    for i=1,450 do

        local star = Instance.new("Part")

        star.Shape = Enum.PartType.Ball

        local size = math.random(2,7)

        star.Size =
            Vector3.new(size,size,size)

        star.Material = Enum.Material.Neon

        star.Color =
            Color3.fromRGB(
                math.random(180,255),
                math.random(180,255),
                math.random(200,255)
            )

        star.Anchored = true
        star.CanCollide = false
        star.CanTouch = false
        star.CanQuery = false

        local angle =
            math.random()*math.pi*2

        local distance =
            math.random(100,750)

        local height =
            math.random(-220,220)

        star.Position =
            center+
            Vector3.new(
                math.cos(angle)*distance,
                height,
                math.sin(angle)*distance
            )

        star.Parent = galaxyFolder

        table.insert(
            movingStars,
            {
                part=star,
                angle=angle,
                distance=distance,
                height=height,
                speed=math.random(2,8)/100
            }
        )
    end

    task.spawn(function()

        while galaxyRunning
            and galaxyFolder
            and galaxyFolder.Parent do

            for _,data in ipairs(movingStars) do

                if data.part
                    and data.part.Parent then

                    data.angle += data.speed

                    data.part.Position =
                        center+
                        Vector3.new(
                            math.cos(data.angle)
                                *data.distance,

                            data.height,

                            math.sin(data.angle)
                                *data.distance
                        )
                end
            end

            task.wait(0.03)
        end
    end)
end

makeButton("🌌 Bật thiên hà lớn",createGalaxy)
makeButton("❌ Tắt thiên hà",removeGalaxy)

-- ==================================================
-- ✈️ MÁY BAY LỚN + HẠT PHÁT SÁNG
-- ==================================================

local planeFolder
local planeRunning = false
local planeConnection

local planeColors = {
    Color3.fromRGB(0,255,255),
    Color3.fromRGB(80,150,255),
    Color3.fromRGB(180,60,255),
    Color3.fromRGB(255,70,220),
    Color3.fromRGB(255,255,255)
}

local function stopPlane()

    planeRunning = false

    if planeConnection then
        planeConnection:Disconnect()
        planeConnection = nil
    end

    if planeFolder then
        planeFolder:Destroy()
        planeFolder = nil
    end
end

local function createPlane()

    stopPlane()

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if not root then return end

    planeRunning = true

    planeFolder = Instance.new("Folder")
    planeFolder.Name = "RuHub_BIG_PLANE"
    planeFolder.Parent = workspace

    -- Máy bay bay ngang phía trước
    local start =
        root.Position
        + root.CFrame.LookVector*450
        + root.CFrame.RightVector*500
        + Vector3.new(0,220,0)

    local direction = -root.CFrame.RightVector

    local planeCF =
        CFrame.lookAt(
            start,
            start+direction
        )

    local parts = {}

    local function addPart(size,offset,color,material)

        local p = Instance.new("Part")

        p.Size = size
        p.CFrame = planeCF*CFrame.new(offset)

        p.Anchored = true
        p.CanCollide = false
        p.CanTouch = false
        p.CanQuery = false

        p.Color = color
        p.Material = material or Enum.Material.WoodPlanks

        p.Parent = planeFolder

        table.insert(parts,p)

        return p
    end

    -- THÂN 200 STUDS
    addPart(
        Vector3.new(24,16,150),
        Vector3.new(0,0,0),
        Color3.fromRGB(170,135,90),
        Enum.Material.WoodPlanks
    )

    -- MŨI
    addPart(
        Vector3.new(30,20,35),
        Vector3.new(0,0,-90),
        Color3.fromRGB(190,155,105),
        Enum.Material.WoodPlanks
    )

    -- CÁNH TRÁI
    addPart(
        Vector3.new(190,6,30),
        Vector3.new(-85,0,-5),
        Color3.fromRGB(170,135,90),
        Enum.Material.WoodPlanks
    )

    -- CÁNH PHẢI
    addPart(
        Vector3.new(190,6,30),
        Vector3.new(85,0,-5),
        Color3.fromRGB(170,135,90),
        Enum.Material.WoodPlanks
    )

    -- ĐUÔI
    addPart(
        Vector3.new(80,5,22),
        Vector3.new(0,0,65),
        Color3.fromRGB(170,135,90),
        Enum.Material.WoodPlanks
    )

    addPart(
        Vector3.new(8,45,25),
        Vector3.new(0,20,70),
        Color3.fromRGB(170,135,90),
        Enum.Material.WoodPlanks
    )

    -- QUE NEON
    local function addNeon(size,offset)

        local p = addPart(
            size,
            offset,
            Color3.fromRGB(0,255,255),
            Enum.Material.Neon
        )

        local light = Instance.new("PointLight")

        light.Color =
            Color3.fromRGB(0,255,255)

        light.Brightness = 4
        light.Range = 25
        light.Parent = p
    end

    addNeon(
        Vector3.new(3,3,110),
        Vector3.new(0,10,-5)
    )

    addNeon(
        Vector3.new(3,3,80),
        Vector3.new(-75,5,-5)
    )

    addNeon(
        Vector3.new(3,3,80),
        Vector3.new(75,5,-5)
    )

    -- ==================================================
    -- ✨ HẠT XUNG QUANH MÁY BAY
    -- ==================================================

    for i=1,300 do

        local x = math.random(-180,180)
        local y = math.random(-60,60)
        local z = math.random(-100,120)

        local p = Instance.new("Part")

        p.Shape = Enum.PartType.Ball

        local s = math.random(1,5)

        p.Size =
            Vector3.new(s,s,s)

        p.Material = Enum.Material.Neon

        p.Color =
            planeColors[
                math.random(1,#planeColors)
            ]

        p.Anchored = true
        p.CanCollide = false
        p.CanTouch = false
        p.CanQuery = false

        p.CFrame =
            planeCF*CFrame.new(x,y,z)

        p.Parent = planeFolder

        table.insert(parts,p)
    end

    -- ==================================================
    -- 🌈 VỆT HẠT PHÍA SAU
    -- ==================================================

    for i=1,500 do

        local x = math.random(-90,90)
        local y = math.random(-50,50)
        local z = math.random(70,550)

        local p = Instance.new("Part")

        p.Shape = Enum.PartType.Ball

        local s = math.random(1,6)

        p.Size =
            Vector3.new(s,s,s)

        p.Material = Enum.Material.Neon

        p.Color =
            planeColors[
                math.random(1,#planeColors)
            ]

        p.Anchored = true
        p.CanCollide = false
        p.CanTouch = false
        p.CanQuery = false

        p.Transparency =
            math.random(0,3)/10

        p.CFrame =
            planeCF*CFrame.new(x,y,z)

        p.Parent = planeFolder

        table.insert(parts,p)
    end

    -- ==================================================
    -- 🛫 BAY NGANG
    -- ==================================================

    local distance = 0
    local speed = 110

    planeConnection =
        RunService.Heartbeat:Connect(function(dt)

            if not planeRunning
                or not planeFolder
                or not planeFolder.Parent then

                stopPlane()
                return
            end

            distance += speed*dt

            local moveCF =
                planeCF*CFrame.new(
                    distance,0,0
                )

            for _,obj in ipairs(parts) do

                if obj
                    and obj.Parent then

                    local localCF =
                        planeCF:ToObjectSpace(
                            obj.CFrame
                        )

                    obj.CFrame =
                        moveCF*localCF
                end
            end

            -- Bay qua một đoạn rồi biến mất
            if distance > 1100 then
                stopPlane()
            end
        end)
end

