local Heart
local HeartRunning=false

local function StopHeart()

	HeartRunning=false

	if Heart then
		Heart:Destroy()
		Heart=nil
	end
end

local function StartHeart()

	StopHeart()

	local Char=Player.Character
	local Root=Char and Char:FindFirstChild("HumanoidRootPart")
	if not Root then return end

	HeartRunning=true

	Heart=Instance.new("Folder")
	Heart.Name="CosmicHeart"
	Heart.Parent=Objects

	local Center =
		Root.Position+
		Root.CFrame.LookVector*110+
		Vector3.new(0,55,0)

	-- ❤️ HÌNH TRÁI TIM
	for i=0,180 do

		local T=math.pi*2*i/180

		local X=16*math.sin(T)^3

		local Y=
			13*math.cos(T)
			-5*math.cos(2*T)
			-2*math.cos(3*T)
			-math.cos(4*T)

		local P=Instance.new("Part")

		P.Shape=Enum.PartType.Ball
		P.Size=Vector3.new(5,5,5)
		P.Material=Enum.Material.Neon
		P.Color=Color3.fromRGB(255,80,200)

		P.Anchored=true
		P.CanCollide=false
		P.CanTouch=false
		P.CanQuery=false

		P.Position =
			Center+
			Root.CFrame.RightVector*(X*2.7)+
			Vector3.new(0,Y*2.7,0)

		P.Parent=Heart
	end

	-- 🔵 QUẢ CẦU NĂNG LƯỢNG
	local Core=Instance.new("Part")

	Core.Shape=Enum.PartType.Ball
	Core.Size=Vector3.new(50,50,50)
	Core.Material=Enum.Material.Neon
	Core.Color=Color3.fromRGB(80,150,255)

	Core.Anchored=true
	Core.CanCollide=false
	Core.CanTouch=false
	Core.CanQuery=false
	Core.Position=Center
	Core.Parent=Heart

	local L=Instance.new("PointLight")
	L.Color=Color3.fromRGB(100,180,255)
	L.Brightness=20
	L.Range=180
	L.Parent=Core

	-- ✨ HẠT
	for i=1,350 do

		local P=Instance.new("Part")

		P.Shape=Enum.PartType.Ball

		local S=math.random(1,4)
		P.Size=Vector3.new(S,S,S)

		P.Material=Enum.Material.Neon
		P.Color=
			GalaxyColors[
				math.random(1,#GalaxyColors)
			]

		P.Anchored=true
		P.CanCollide=false
		P.CanTouch=false
		P.CanQuery=false

		local A=math.random()*math.pi*2
		local R=math.random(55,150)
		local H=math.random(-70,90)

		P.Position =
			Center+
			Vector3.new(
				math.cos(A)*R,
				H,
				math.sin(A)*R
			)

		P.Parent=Heart
	end

	-- LÕI NHẤP NHÁY
	task.spawn(function()

		while HeartRunning
		and Heart
		and Heart.Parent do

			local S=
				50+
				math.sin(os.clock()*3)*6

			Core.Size=Vector3.new(S,S,S)

			task.wait(.03)
		end
	end)
end

Button("❤️ Bật trái tim vũ trụ",StartHeart)
Button("❌ Tắt trái tim",StopHeart)

