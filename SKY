--================ 🌈 CẦU VỒNG ================

local rainbow

local function stopRainbow()
    if rainbow then
        rainbow:Destroy()
        rainbow = nil
    end
end

local function startRainbow()
    stopRainbow()

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    rainbow = Instance.new("Folder")
    rainbow.Parent = effects

    local center =
        root.Position-root.CFrame.RightVector*150
        +Vector3.new(0,70,0)

    local colors = {
        Color3.fromRGB(255,0,0),
        Color3.fromRGB(255,140,0),
        Color3.fromRGB(255,255,0),
        Color3.fromRGB(0,255,80),
        Color3.fromRGB(0,180,255),
        Color3.fromRGB(80,80,255),
        Color3.fromRGB(210,0,255)
    }

    for n,c in ipairs(colors) do
        local radius = 70-(n-1)*4

        for i=0,40 do
            local a=math.pi*i/40

            local p=Instance.new("Part")
            p.Shape=Enum.PartType.Ball
            p.Size=Vector3.new(3,3,3)
            p.Material=Enum.Material.Neon
            p.Color=c
            p.Anchored=true
            p.CanCollide=false
            p.CanTouch=false
            p.CanQuery=false

            p.Position=center+Vector3.new(
                math.cos(a)*radius,
                math.sin(a)*radius,
                0
            )

            p.Parent=rainbow
        end
    end
end

button("🌈 Bật cầu vồng",startRainbow)
button("❌ Tắt cầu vồng",stopRainbow)

--================ 🌌 THIÊN HÀ ================

local galaxy
local galaxyConnection

local function stopGalaxy()
    if galaxyConnection then
        galaxyConnection:Disconnect()
        galaxyConnection=nil
    end

    if galaxy then
        galaxy:Destroy()
        galaxy=nil
    end
end

local function startGalaxy()
    stopGalaxy()

    local char=player.Character
    local root=char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    galaxy=Instance.new("Folder")
    galaxy.Name="Galaxy"
    galaxy.Parent=effects

    local center =
        root.Position+
        root.CFrame.LookVector*120+
        Vector3.new(0,50,0)

    local stars={}

    local colors={
        Color3.fromRGB(255,255,255),
        Color3.fromRGB(180,220,255),
        Color3.fromRGB(150,80,255),
        Color3.fromRGB(230,70,255),
        Color3.fromRGB(255,100,220)
    }

    local function star(pos,size,color,trans)
        local p=Instance.new("Part")
        p.Shape=Enum.PartType.Ball
        p.Size=Vector3.new(size,size,size)
        p.Material=Enum.Material.Neon
        p.Color=color
        p.Transparency=trans or 0
        p.Anchored=true
        p.CanCollide=false
        p.CanTouch=false
        p.CanQuery=false
        p.Position=pos
        p.Parent=galaxy
        return p
    end

    -- ⭐ HẠT SAO DÀY NHƯ ẢNH
    for i=1,1200 do
        local a=math.random()*math.pi*2
        local r=math.random(20,280)

        local p=star(
            center+Vector3.new(
                math.cos(a)*r,
                math.random(-100,110),
                math.sin(a)*r
            ),
            math.random(1,5),
            colors[math.random(1,#colors)],
            math.random(0,60)/100
        )

        if math.random()<.25 then
            table.insert(stars,{
                part=p,
                angle=a,
                radius=r,
                y=math.random(-100,110),
                speed=math.random(1,8)/1000
            })
        end
    end

    -- 🌀 DẢI TÍM/XANH
    for arm=1,6 do
        for i=1,400 do
            local t=i/400
            local a=t*math.pi*8+(arm-1)*math.pi*2/6
            local r=15+t*250

            star(
                center+Vector3.new(
                    math.cos(a)*r,
                    math.sin(t*math.pi)*35+math.random(-15,15),
                    math.sin(a)*r
                ),
                math.random(2,6),
                colors[math.random(3,5)],
                math.random(15,65)/100
            )
        end
    end

    -- ☀️ MẶT TRỜI TRẮNG BÊN PHẢI
    local sunPos=
        center+
        root.CFrame.RightVector*180+
        Vector3.new(0,40,0)

    local sun=star(
        sunPos,
        75,
        Color3.fromRGB(255,255,255)
    )

    local light=Instance.new("PointLight")
    light.Brightness=35
    light.Range=800
    light.Color=Color3.fromRGB(230,240,255)
    light.Parent=sun

    -- ✨ HẠT QUANH MẶT TRỜI
    for i=1,220 do
        local a=math.random()*math.pi*2
        local r=math.random(45,130)

        star(
            sunPos+Vector3.new(
                math.cos(a)*r,
                math.random(-45,45),
                math.sin(a)*r
            ),
            math.random(1,5),
            Color3.fromRGB(255,255,255),
            math.random(35,90)/100
        )
    end

    -- 🪐 HÀNH TINH BÊN TRÁI
    local planet=Instance.new("Part")
    planet.Shape=Enum.PartType.Ball
    planet.Size=Vector3.new(400,400,400)
    planet.Material=Enum.Material.SmoothPlastic
    planet.Color=Color3.fromRGB(45,55,75)
    planet.Anchored=true
    planet.CanCollide=false
    planet.CanTouch=false
    planet.CanQuery=false

    planet.Position=
        center-root.CFrame.RightVector*300

    planet.Parent=galaxy

    -- 💫 VÀNH HÀNH TINH
    for i=1,500 do
        local a=math.random()*math.pi*2
        local r=math.random(220,370)

        star(
            planet.Position+Vector3.new(
                math.cos(a)*r,
                math.random(-12,12),
                math.sin(a)*r
            ),
            math.random(2,6),
            Color3.fromRGB(150,160,190),
            .2
        )
    end

    -- 🔄 CHUYỂN ĐỘNG
    galaxyConnection=RunService.Heartbeat:Connect(function()
        for _,d in ipairs(stars) do
            if d.part and d.part.Parent then
                d.angle=d.angle+d.speed

                d.part.Position=
                    center+Vector3.new(
                        math.cos(d.angle)*d.radius,
                        d.y+math.sin(d.angle*2)*5,
                        math.sin(d.angle)*d.radius
                    )
            end
        end
    end)
end

button("🌌 BẬT THIÊN HÀ",startGalaxy)
button("❌ TẮT THIÊN HÀ",stopGalaxy)

--================ ❤️ TRÁI TIM ================

local heart

local function stopHeart()
    if heart then
        heart:Destroy()
        heart=nil
    end
end

local function startHeart()
    stopHeart()

    local char=player.Character
    local root=char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    heart=Instance.new("Folder")
    heart.Parent=effects

    local center=
        root.Position+
        root.CFrame.LookVector*100+
        Vector3.new(0,50,0)

    for i=0,180 do
        local t=math.pi*2*i/180

        local x=16*math.sin(t)^3
        local y=13*math.cos(t)
            -5*math.cos(2*t)
            -2*math.cos(3*t)
            -math.cos(4*t)

        local p=Instance.new("Part")
        p.Shape=Enum.PartType.Ball
        p.Size=Vector3.new(4,4,4)
        p.Material=Enum.Material.Neon
        p.Color=Color3.fromRGB(255,70,190)
        p.Anchored=true
        p.CanCollide=false
        p.CanTouch=false
        p.CanQuery=false

        p.Position=
            center+
            root.CFrame.RightVector*(x*2.5)+
            Vector3.new(0,y*2.5,0)

        p.Parent=heart
    end

    -- ✨ HẠT PHÁT SÁNG BAO QUANH
    for i=1,400 do
        local a=math.random()*math.pi*2
        local r=math.random(50,150)

        local p=Instance.new("Part")
        p.Shape=Enum.PartType.Ball
        p.Size=Vector3.new(2,2,2)
        p.Material=Enum.Material.Neon
        p.Color=Color3.fromRGB(
            math.random(100,255),
            math.random(50,220),
            255
        )
        p.Anchored=true
        p.CanCollide=false
        p.CanTouch=false
        p.CanQuery=false

        p.Position=center+Vector3.new(
            math.cos(a)*r,
            math.random(-70,90),
            math.sin(a)*r
        )

        p.Parent=heart
    end
end

button("❤️ BẬT TRÁI TIM",startHeart)
button("❌ TẮT TRÁI TIM",stopHeart)

