end

local function createGalaxy()

    removeGalaxy()

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if not root then
        return
    end

    galaxyRunning = true

    galaxyFolder = Instance.new("Folder")
    galaxyFolder.Name = "RuHub_Galaxy"
    galaxyFolder.Parent = workspace

    local center =
        root.Position
        + root.CFrame.LookVector * 1000
        + Vector3.new(0,450,0)

    -- ⭐ SAO
    for i = 1,450 do

        local star = Instance.new("Part")

        star.Shape = Enum.PartType.Ball
        star.Material = Enum.Material.Neon
        star.Color = Color3.new(1,1,1)

        star.Anchored = true
        star.CanCollide = false
        star.CanTouch = false
        star.CanQuery = false

        local s = math.random(1,4)

        star.Size =
            Vector3.new(s,s,s)

        star.Position =
            center
            + Vector3.new(
                math.random(-1000,1000),
                math.random(-500,500),
                math.random(-1000,1000)
            )

        star.Parent = galaxyFolder
    end

    -- 🪐 HÀNH TINH
    local planet = Instance.new("Part")

    planet.Shape = Enum.PartType.Ball
    planet.Size = Vector3.new(430,430,430)
    planet.Position = center

    planet.Anchored = true
    planet.CanCollide = false

    planet.Material = Enum.Material.Neon
    planet.Color = Color3.fromRGB(80,30,180)

    planet.Parent = galaxyFolder

    -- 💍 VÒNG
    for i = 1,3 do

        local ring = Instance.new("Part")

        ring.Shape = Enum.PartType.Cylinder

        ring.Size = Vector3.new(
            10,
            650 + i * 80,
            650 + i * 80
        )

        ring.CFrame =
            CFrame.new(center)
            * CFrame.Angles(
                math.rad(70),
                0,
                math.rad(i * 15)
            )

        ring.Anchored = true
        ring.CanCollide = false

        ring.Material = Enum.Material.Neon
        ring.Color = Color3.fromRGB(130,60,255)
        ring.Transparency = 0.35

        ring.Parent = galaxyFolder
    end

    -- ☀️ MẶT TRỜI
    local sun = Instance.new("Part")

    sun.Shape = Enum.PartType.Ball
    sun.Size = Vector3.new(260,260,260)

    sun.Position =
        center
        + Vector3.new(0,700,0)

    sun.Anchored = true
    sun.CanCollide = false

    sun.Material = Enum.Material.Neon
    sun.Color = Color3.fromRGB(255,220,80)

    sun.Parent = galaxyFolder

    local light = Instance.new("PointLight")

    light.Brightness = 15
    light.Range = 1000
    light.Color = Color3.fromRGB(255,200,100)

    light.Parent = sun

    task.spawn(function()

        while galaxyRunning
            and galaxyFolder
            and galaxyFolder.Parent do

            local t = os.clock()

            planet.CFrame =
                CFrame.new(center)
                * CFrame.Angles(
                    0,
                    t * 0.15,
                    0
                )

            task.wait(0.03)
        end
    end)
end

