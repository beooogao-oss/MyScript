local function clear()
	for _,v in ipairs(content:GetChildren()) do
		if not v:IsA("UIListLayout") then
			v:Destroy()
		end
	end
end

local function button(text, callback)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1,-5,0,48)
	b.Text = text
	b.TextSize = 16
	b.TextColor3 = Color3.new(1,1,1)
	b.BackgroundColor3 = Color3.fromRGB(25,65,90)
	b.Parent = content
	b.Activated:Connect(callback)
end

local function tab(text, callback)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0.3,0,0.8,0)
	b.Text = text
	b.TextSize = 14
	b.TextColor3 = Color3.new(1,1,1)
	b.BackgroundColor3 = Color3.fromRGB(25,55,75)
	b.Parent = tabs
	b.Activated:Connect(callback)
end

local function tsunami()
	clear()

	button("🔵 BLUE TSUNAMI",function()
		local c = player.Character
		local r = c and c:FindFirstChild("HumanoidRootPart")
		if not r then return end

		local wave = Instance.new("Part")
		wave.Anchored = true
		wave.CanCollide = false
		wave.Material = Enum.Material.Water
		wave.Color = Color3.fromRGB(0,140,255)
		wave.Transparency = 0.2
		wave.Size = Vector3.new(500,500,30)
		wave.CFrame = r.CFrame * CFrame.new(0,250,-500)
		wave.Parent = workspace

		task.spawn(function()
			for i = 1,150 do
				if wave.Parent then
					wave.CFrame += r.CFrame.LookVector * 10
				end
				task.wait(0.05)
			end
			if wave.Parent then
				wave:Destroy()
			end
		end)
	end)

	button("🔴 RED TSUNAMI",function()
		local c = player.Character
		local r = c and c:FindFirstChild("HumanoidRootPart")
		if not r then return end

		local wave = Instance.new("Part")
		wave.Anchored = true
		wave.CanCollide = false
		wave.Material = Enum.Material.Neon
		wave.Color = Color3.fromRGB(255,30,30)
		wave.Transparency = 0.2
		wave.Size = Vector3.new(500,500,30)
		wave.CFrame = r.CFrame * CFrame.new(0,250,-500)
		wave.Parent = workspace

		task.spawn(function()
			for i = 1,150 do
				if wave.Parent then
					wave.CFrame += r.CFrame.LookVector * 10
				end
				task.wait(0.05)
			end
			if wave.Parent then
				wave:Destroy()
			end
		end)
	end)

	button("🌊 TSUNAMI ON / OFF",function()
		print("Tsunami ON/OFF")
	end)
end

