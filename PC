-- ĐIỀU KHIỂN NHÂN VẬT
local function getCharacter()
    return player.Character
end

RunService.RenderStepped:Connect(function()
    local char = getCharacter()
    if not char then return end

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local camera = workspace.CurrentCamera
    if not camera then return end

    local x = 0
    local z = 0

    if keys.W then z += 1 end
    if keys.S then z -= 1 end
    if keys.A then x -= 1 end
    if keys.D then x += 1 end

    local direction =
        camera.CFrame.RightVector * x
        + Vector3.new(camera.CFrame.LookVector.X, 0,
            camera.CFrame.LookVector.Z) * z

    if direction.Magnitude > 0 then
        humanoid:Move(direction.Unit, false)
    else
        humanoid:Move(Vector3.zero, false)
    end

    humanoid.Jump = keys.SPACE
end)

-- PHÍM BÀN PHÍM THẬT
UIS.InputBegan:Connect(function(input, processed)
    if processed then return end

    local map = {
        [Enum.KeyCode.W] = "W",
        [Enum.KeyCode.A] = "A",
        [Enum.KeyCode.S] = "S",
        [Enum.KeyCode.D] = "D",
        [Enum.KeyCode.Space] = "SPACE"
    }

    local key = map[input.KeyCode]
    if key then keys[key] = true end
end)

UIS.InputEnded:Connect(function(input)
    local map = {
        [Enum.KeyCode.W] = "W",
        [Enum.KeyCode.A] = "A",
        [Enum.KeyCode.S] = "S",
        [Enum.KeyCode.D] = "D",
        [Enum.KeyCode.Space] = "SPACE"
    }

    local key = map[input.KeyCode]
    if key then keys[key] = false end
end)
