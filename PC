local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "VX_PC_CONTROLS"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local keys = {}
local buttons = {}

local function createKey(name, pos, size)
    local b = Instance.new("TextButton")
    b.Name = name
    b.Size = size or UDim2.fromOffset(52, 52)
    b.Position = pos
    b.BackgroundColor3 = Color3.fromRGB(12, 16, 28)
    b.BackgroundTransparency = 0.12
    b.BorderSizePixel = 0
    b.Text = name
    b.TextColor3 = Color3.fromRGB(75, 190, 255)
    b.TextSize = 15
    b.Font = Enum.Font.GothamBold
    b.AutoButtonColor = true
    b.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 9)
    corner.Parent = b

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(35, 55, 90)
    stroke.Thickness = 1.5
    stroke.Parent = b

    keys[name] = false
    buttons[name] = b

    b.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
            keys[name] = true
        end
    end)

    b.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
            keys[name] = false
        end
    end)

    return b
end

-- BÊN TRÁI
createKey("M", UDim2.new(0, 10, 0.16, 0))
