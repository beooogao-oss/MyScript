local function button(text,x,y,w,callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.fromOffset(w or 185,43)
    b.Position = UDim2.fromOffset(x,y)
    b.BackgroundColor3 = Color3.fromRGB(8,55,92)
    b.Text = text
    b.TextColor3 = Color3.fromRGB(225,250,255)
    b.TextSize = 16
    b.Font = Enum.Font.GothamSemibold
    b.BorderSizePixel = 0
    b.Parent = main

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0,12)
    c.Parent = b

    local s = Instance.new("UIStroke")
    s.Color = Color3.fromRGB(0,150,230)
    s.Thickness = 1.5
    s.Parent = b

    b.MouseButton1Click:Connect(callback)
    return b
end

local function notify(txt)
    title.Text = "🌊  "..txt
    task.delay(1.5,function()
        if title.Parent then
            title.Text = "🌊  TSUNAMI PREMIER"
        end
    end)
end

close.MouseButton1Click:Connect(function()
    main.Visible = false
    open.Visible = true
end)

open.MouseButton1Click:Connect(function()
    main.Visible = true
    open.Visible = false
end)

