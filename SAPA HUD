local function makeButton(text, y, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -24, 0, 42)
    b.Position = UDim2.fromOffset(12, y)
    b.Text = text
    b.TextSize = 16
    b.TextColor3 = Color3.fromRGB(225, 235, 230)
    b.BackgroundColor3 = Color3.fromRGB(31, 57, 46)
    b.BorderSizePixel = 0
    b.Parent = frame

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 14)
    c.Parent = b

    b.MouseButton1Click:Connect(callback)

    return b
end

makeButton("🌀 Fling gần nhất", 55, function()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local target
    local distance = 30

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            if r then
                local d = (r.Position - root.Position).Magnitude
                if d < distance then
                    distance = d
                    target = r
                end
            end
        end
    end

    if target then
        target.AssemblyLinearVelocity =
            (target.Position - root.Position).Unit * 150
            + Vector3.new(0, 80, 0)
    end
end)

makeButton("💥 Fling mạnh", 103, function()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        root.AssemblyLinearVelocity =
            root.CFrame.LookVector * 250
            + Vector3.new(0, 120, 0)
    end
end)

makeButton("🌊 Sóng đẩy", 151, function()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            if r and (r.Position - root.Position).Magnitude <= 40 then
                local dir = (r.Position - root.Position).Unit
                r.AssemblyLinearVelocity =
                    dir * 150 + Vector3.new(0, 80, 0)
            end
        end
    end
end)

