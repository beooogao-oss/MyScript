local dragging, dragStart, startPos

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = panel.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart
        panel.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

Players.PlayerRemoving:Connect(clearMark)

RunService.RenderStepped:Connect(function()
    local camera = workspace.CurrentCamera
    if not camera then return end

    camera.FieldOfView = fovOn and 120 or 70

    local myChar = me.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local targetPart
    local closest = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= me then
            local char = p.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            local torso = char and (
                char:FindFirstChild("UpperTorso")
                or char:FindFirstChild("Torso")
            )

            local valid = myRoot and root and torso
                and humanoid and humanoid.Health > 0
                and (root.Position - myRoot.Position).Magnitude <= range

            if espOn and valid then
                addMark(p)
                if marks[p] then
                    marks[p][1].Enabled = true
                    marks[p][2].Enabled = true
                    marks[p].label.Text = p.Name .. " | "
                        .. math.floor(
                            (root.Position - myRoot.Position).Magnitude
                        ) .. " studs"
                end
            elseif marks[p] then
                marks[p][1].Enabled = false
                marks[p][2].Enabled = false
            end

            if aimOn and valid then
                local pos, visible =
                    camera:WorldToViewportPoint(torso.Position)

                if visible then
                    local center = camera.ViewportSize / 2
                    local dist = (
                        Vector2.new(pos.X, pos.Y) - center
                    ).Magnitude

                    if dist < closest then
                        closest = dist
                        targetPart = torso
                    end
                end
            end
        end
    end

    if aimOn and targetPart then
        local goal = CFrame.lookAt(
            camera.CFrame.Position,
            targetPart.Position
        )
        camera.CFrame = camera.CFrame:Lerp(goal, 0.18)
    end
end)


