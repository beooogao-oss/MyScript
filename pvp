
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local me = Players.LocalPlayer
local pg = me:WaitForChild("PlayerGui")

local old = pg:FindFirstChild("SKY_AIM")
if old then old:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name = "SKY_AIM"
gui.ResetOnSpawn = false
gui.Parent = pg

local panel = Instance.new("Frame")
panel.Size = UDim2.fromOffset(220, 220)
panel.Position = UDim2.new(0, 15, 0.2, 0)
panel.BackgroundColor3 = Color3.fromRGB(20, 38, 31)
panel.Active = true
panel.Parent = gui
Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 14)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 35)
title.BackgroundTransparency = 1
title.Text = "SKY • AIM"
title.TextColor3 = Color3.fromRGB(100, 255, 180)
title.TextScaled = true
title.Parent = panel

local function makeButton(text, y)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -16, 0, 34)
    b.Position = UDim2.fromOffset(8, y)
    b.BackgroundColor3 = Color3.fromRGB(31, 57, 46)
    b.TextColor3 = Color3.new(1, 1, 1)
    b.TextScaled = true
    b.Text = text
    b.Parent = panel
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    return b
end

local espBtn = makeButton("ESP: ON", 42)
local fovBtn = makeButton("FOV 120: ON", 80)
local rangeBtn = makeButton("RANGE: 50", 118)
local hideBtn = makeButton("ẨN MENU", 156)

local reopen = Instance.new("TextButton")
reopen.Size = UDim2.fromOffset(48, 48)
reopen.Position = UDim2.new(0, 15, 0.35, 0)
reopen.Text = "🌐"
reopen.TextScaled = true
reopen.Visible = false
reopen.BackgroundColor3 = Color3.fromRGB(20, 38, 31)
reopen.Parent = gui
Instance.new("UICorner", reopen).CornerRadius = UDim.new(1, 0)

local espOn, fovOn = true, true
local range = 50
local marks = {}

local function clearMark(p)
    if marks[p] then
        for _, obj in ipairs(marks[p]) do
            obj:Destroy()
        end
    end
    marks[p] = nil
end

local function addMark(p)
    if p == me or marks[p] then return end
    local char = p.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local h = Instance.new("Highlight")
    h.FillColor = Color3.fromRGB(40, 255, 140)
    h.OutlineColor = Color3.fromRGB(255, 255, 255)
    h.Adornee = char
    h.Parent = gui

    local bill = Instance.new("BillboardGui")
    bill.Size = UDim2.fromOffset(160, 35)
    bill.StudsOffset = Vector3.new(0, 3, 0)
    bill.AlwaysOnTop = true
    bill.Adornee = root
    bill.Parent = gui

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.fromScale(1, 1)
    txt.BackgroundTransparency = 1
    txt.TextColor3 = Color3.new(1, 1, 1)
    txt.TextStrokeTransparency = 0
    txt.TextScaled = true
    txt.Parent = bill

    marks[p] = {h, bill}
    marks[p].label = txt
end

espBtn.Activated:Connect(function()
    espOn = not espOn
    espBtn.Text = espOn and "ESP: ON" or "ESP: OFF"
end)

fovBtn.Activated:Connect(function()
    fovOn = not fovOn
    fovBtn.Text = fovOn and "FOV 120: ON" or "FOV: DEFAULT"
end)

rangeBtn.Activated:Connect(function()
    range = range + 50
    if range > 500 then range = 50 end
    rangeBtn.Text = "RANGE: " .. range
end)

hideBtn.Activated:Connect(function()
    panel.Visible = false
    reopen.Visible = true
end)

reopen.Activated:Connect(function()
    panel.Visible = true
    reopen.Visible = false
end)

local dragging, dragStart, startPos
title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = panel.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        panel.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

Players.PlayerRemoving:Connect(clearMark)

game:GetService("RunService").RenderStepped:Connect(function()
    local camera = workspace.CurrentCamera
    if camera then
        camera.FieldOfView = fovOn and 120 or 70
    end

    local myChar = me.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= me then
            local char = p.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if espOn and myRoot and root
            and (root.Position - myRoot.Position).Magnitude <= range then
                addMark(p)
                if marks[p] then
                    marks[p][1].Enabled = true
                    marks[p][2].Enabled = true
                    marks[p].label.Text = p.Name .. " | "
                        .. math.floor((root.Position - myRoot.Position).Magnitude)
                        .. " studs"
                end
            elseif marks[p] then
                marks[p][1].Enabled = false
                marks[p][2].Enabled = false
            end
        end
    end
end)
