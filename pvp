local espOn, fovOn, aimOn = true, true, false
local range = 50
local marks = {}

local function clearMark(p)
    if marks[p] then
        for _, obj in ipairs(marks[p]) do
            obj:Destroy()
        end
        marks[p] = nil
    end
end

local function addMark(p)
    if marks[p] then return end
    local char = p.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local h = Instance.new("Highlight")
    h.FillColor = Color3.fromRGB(40, 255, 140)
    h.OutlineColor = Color3.new(1, 1, 1)
    h.Adornee = char
    h.Parent = gui

    local bill = Instance.new("BillboardGui")
    bill.Size = UDim2.fromOffset(160, 35)
    bill.StudsOffset = Vector3.new(0, 3, 0)
    bill.AlwaysOnTop = true
    bill.Adornee = root
    bill.Parent = gui

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.fromScale(1, 1)
    txt.BackgroundTransparency = 1
    txt.TextColor3 = Color3.new(1, 1, 1)
    txt.TextStrokeTransparency = 0
    txt.TextScaled = true
    txt.Parent = bill

    marks[p] = {h, bill, label = txt}
end

