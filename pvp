local aimOn, espOn, fovOn, lineOn = false, true, true, true
local range = 25
local highlights, tags = {}, {}
local target

aimBtn.Activated:Connect(function()
    aimOn = not aimOn
    aimBtn.Text = aimOn and "AIM ASSIST: ON" or "AIM ASSIST: OFF"
end)

espBtn.Activated:Connect(function()
    espOn = not espOn
    espBtn.Text = espOn and "ESP: ON" or "ESP: OFF"
end)

fovBtn.Activated:Connect(function()
    fovOn = not fovOn
    fovBtn.Text = fovOn and "FOV 120: ON" or "FOV: DEFAULT"
end)

lineBtn.Activated:Connect(function()
    lineOn = not lineOn
    lineBtn.Text = lineOn and "AIM LINE: ON" or "AIM LINE: OFF"
end)

rangeBtn.Activated:Connect(function()
    range = range + 5
    if range > 50 then range = 0 end
    rangeBtn.Text = "RANGE: " .. range
end)

local function clearESP(p)
    if highlights[p] then highlights[p]:Destroy() end
    if tags[p] then tags[p]:Destroy() end
    highlights[p], tags[p] = nil, nil
end

local function setupESP(p)
    if p == me or not p.Character then return end
    clearESP(p)

    local char = p.Character
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local h = Instance.new("Highlight")
    h.Adornee = char
    h.FillColor = Color3.fromRGB(0, 255, 170)
    h.OutlineColor = Color3.new(1, 1, 1)
    h.FillTransparency = 0.8
    h.Enabled = false
    h.Parent = gui
    highlights[p] = h

    local tag = Instance.new("BillboardGui")
    tag.Adornee = root
    tag.Size = UDim2.fromOffset(180, 42)
    tag.StudsOffset = Vector3.new(0, 3, 0)
    tag.AlwaysOnTop = true
    tag.Enabled = false
    tag.Parent = gui

    local label = Instance.new("TextLabel")
    label.Name = "Info"
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(100, 255, 180)
    label.TextStrokeTransparency = 0.25
    label.TextScaled = true
    label.Parent = tag
    tags[p] = tag
end

local function getTarget()
    local char = me.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local cam = workspace.CurrentCamera
    if not root or not cam then return nil end

    local best, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= me and p.Character then
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if r and hum and hum.Health > 0 then
                local d = (r.Position - root.Position).Magnitude
                local point, visible = cam:WorldToViewportPoint(r.Position)
                if d <= range and visible then
                    local center = cam.ViewportSize / 2
                    local screenDist = (Vector2.new(point.X, point.Y) - center).Magnitude
                    if screenDist < bestDist then
                        best, bestDist = r, screenDist
                    end
                end
            end
        end
    end
    return best
end

for _, p in ipairs(Players:GetPlayers()) do
    setupESP(p)
    p.CharacterAdded:Connect(function()
        task.wait(1)
        setupESP(p)
    end)
end

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function()
        task.wait(1)
        setupESP(p)
    end)
end)

Players.PlayerRemoving:Connect(clearESP)

local function makeLine()
    local line = Instance.new("Frame")
    line.Name = "AimLine"
    line.AnchorPoint = Vector2.new(0, 0.5)
    line.BorderSizePixel = 0
    line.BackgroundColor3 = Color3.fromRGB(0, 255, 180)
    line.Visible = false
    line.Parent = gui
    return line
end

local aimLine = makeLine()

RunService:BindToRenderStep("SKY_AIM_UPDATE", Enum.RenderPriority.Camera.Value + 1, function(dt)
    local cam = workspace.CurrentCamera
    if not cam then return end

    cam.FieldOfView = fovOn and 120 or 70
    target = getTarget()

    local char = me.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")

    for p, h in pairs(highlights) do
        local tag = tags[p]
        local otherChar = p.Character
        local r = otherChar and otherChar:FindFirstChild("HumanoidRootPart")
        local hum = otherChar and otherChar:FindFirstChildOfClass("Humanoid")
        local dist = myRoot and r and (r.Position - myRoot.Position).Magnitude

        h.Enabled = espOn and r ~= nil and hum ~= nil and hum.Health > 0
            and dist ~= nil and dist <= 500

        if tag then
            tag.Enabled = h.Enabled
            local label = tag:FindFirstChild("Info")
            if label and dist then
                label.Text = p.DisplayName .. "\n" .. math.floor(dist) .. " studs"
            end
        end
    end

    if target and myRoot then
        local point, visible = cam:WorldToViewportPoint(target.Position)
        local center = cam.ViewportSize / 2

        aimLine.Visible = lineOn and visible
        if aimLine.Visible then
            local from = Vector2.new(center.X, center.Y)
            local to = Vector2.new(point.X, point.Y)
            local delta = to - from
            aimLine.Position = UDim2.fromOffset(from.X, from.Y)
            aimLine.Size = UDim2.fromOffset(delta.Magnitude, 2)
            aimLine.Rotation = math.deg(math.atan2(delta.Y, delta.X))
        end

        if aimOn and visible then
            local desired = CFrame.lookAt(cam.CFrame.Position, target.Position)
            cam.CFrame = cam.CFrame:Lerp(desired, math.clamp(dt * 5, 0, 1))
        end
    else
        aimLine.Visible = false
    end
end)
