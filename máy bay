-- =========================
-- BAY
-- =========================

RunService.RenderStepped:Connect(function(dt)

    if not flying then return end
    if not folder.Parent then return end

    local turn = 0
    local vertical = 0
    local forward = 0

    if move.left then
        turn -= 1
    end

    if move.right then
        turn += 1
    end

    if move.up then
        vertical += 1
    end

    if move.down then
        vertical -= 1
    end

    if move.forward then
        forward += 1
    end

    if move.back then
        forward -= 1
    end

    yaw += turn * dt * 1.5
    pitch += vertical * dt * 0.8

    pitch = math.clamp(
        pitch,
        math.rad(-45),
        math.rad(45)
    )

    local current =
        folder:GetChildren()[1]

    if not current then return end

    local currentCF =
        current.CFrame

    local direction =
        currentCF.LookVector

    if forward ~= 0 then
        base += direction * forward * speed
    end

    base += Vector3.new(
        0,
        vertical * speed * dt * 15,
        0
    )

    planeCF =
        CFrame.new(base)
        * CFrame.Angles(0,yaw,pitch)

    for _, obj in ipairs(folder:GetChildren()) do

        if obj:IsA("BasePart") then

            local offset =
                planeCF:ToObjectSpace(
                    obj.CFrame
                )

            obj.CFrame =
                planeCF * offset
        end
    end

    -- CAM THỨ 3
    if thirdPerson then

        camera.CameraType =
            Enum.CameraType.Scriptable

        local camPos =
            base
            - planeCF.LookVector * 45
            + Vector3.new(0,18,0)

        camera.CFrame =
            CFrame.lookAt(
                camPos,
                base + planeCF.LookVector * 30
            )
    end
end)

