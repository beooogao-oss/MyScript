local folder = Instance.new("Folder")
folder.Name = "SKY_PlankPlane"
folder.Parent = workspace

local character = player.Character or player.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart")

local base =
    hrp.Position
    + hrp.CFrame.LookVector * 70
    + Vector3.new(0, 35, 0)

local planeCF =
    CFrame.new(base, base + hrp.CFrame.LookVector)

local function makePart(name, size, offset, color, material)
    local p = Instance.new("Part")

    p.Name = name
    p.Size = size
    p.CFrame = planeCF * CFrame.new(offset)

    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false

    p.Color = color or Color3.fromRGB(190,160,115)
    p.Material = material or Enum.Material.WoodPlanks

    p.Parent = folder

    return p
end

