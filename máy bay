local function neonRod(name, size, offset)
    local rod = Instance.new("Part")

    rod.Name = name
    rod.Size = size
    rod.CFrame = planeCF * CFrame.new(offset)

    rod.Anchored = true
    rod.CanCollide = false
    rod.CanTouch = false
    rod.CanQuery = false

    rod.Material = Enum.Material.Neon
    rod.Color = Color3.fromRGB(0,255,255)

    rod.Parent = folder

    local light = Instance.new("PointLight")
    light.Color = Color3.fromRGB(0,255,255)
    light.Brightness = 3
    light.Range = 18
    light.Parent = rod

    return rod
end

