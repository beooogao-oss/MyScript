local function toggle(text,func)
	local state = false

	local b = button(text.."   OFF",function()
		state = not state
		b.Text = text..(state and "   ON" or "   OFF")
		func(state)
	end)

	return b
end

local function nearestPlayer()
	local char = LP.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local target
	local distance = math.huge

	for _,p in ipairs(Players:GetPlayers()) do
		if p ~= LP and p.Character then
			local r = p.Character:FindFirstChild("HumanoidRootPart")
			if r then
				local d = (r.Position-root.Position).Magnitude
				if d < distance then
					distance = d
					target = p
				end
			end
		end
	end

	return target,distance
end

local function localFling(power)
	local char = LP.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	root.AssemblyLinearVelocity =
		root.CFrame.LookVector * power +
		Vector3.new(0,power*.5,0)
end

local function tsunami()
	local char = LP.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local wave = Instance.new("Part")
	wave.Anchored = true
	wave.CanCollide = false
	wave.Material = Enum.Material.Glass
	wave.Transparency = .35
	wave.Size = Vector3.new(8,20,8)
	wave.CFrame = root.CFrame * CFrame.new(0,5,-8)
	wave.Parent = workspace

	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(1,1.4,1)
	mesh.Parent = wave

	local direction = root.CFrame.LookVector

	task.spawn(function()
		for i=1,35 do
			if not wave.Parent then break end

			wave.Position += direction*6
			wave.Size += Vector3.new(2,0,2)

			task.wait(.04)
		end

		wave:Destroy()
	end)
end

